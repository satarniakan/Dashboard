@* Dashboard.Web/Components/Shared/AppRadioGroup.razor *@
@using System.Linq.Expressions
@typeparam TValue

<div class="mb-3">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label d-block">@Label</label>
    }
    <InputRadioGroup Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression">
        @foreach (var option in Options)
        {
            <div class="form-check form-check-inline">
                <InputRadio class="form-check-input" Value="@option.Value" id="@($"radio_{option.Value}")" />
                <label class="form-check-label" for="@($"radio_{option.Value}")">@option.Label</label>
            </div>
        }
    </InputRadioGroup>
    <ValidationMessage For="@ValueExpression" class="text-danger small mt-1 d-block" />
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<TValue?>>? ValueExpression { get; set; }
    [Parameter] public List<(TValue Value, string Label)> Options { get; set; } = new();
}