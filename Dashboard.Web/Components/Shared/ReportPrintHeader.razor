@* Dashboard.Web/Components/Shared/ReportPrintHeader.razor *@
@* سربرگ چاپ مشترک گزارش‌ها: روی صفحه دیده نمی‌شود، فقط در خروجی چاپ (@media print) نمایش داده می‌شود *@
@using Dashboard.Application.Helpers

<div class="print-header mb-3">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-2">
        <div>
            <div class="fw-bold fs-5">@Title</div>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <div class="small text-body-secondary">@Subtitle</div>
            }
        </div>
        <div class="small text-body-secondary text-end">
            <div>تاریخ چاپ: @DateTime.Now.ToPersianDate()</div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "گزارش";
    [Parameter] public string? Subtitle { get; set; }
}
