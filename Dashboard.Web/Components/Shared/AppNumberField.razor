@* Dashboard.Web/Components/Shared/AppNumberField.razor *@
@* فیلد عددی با جداسازی سه‌رقمی هنگام تایپ (فرمت زنده در priceInput.js و نهایی در همین کامپوننت).
   هم int و هم decimal? را پشتیبانی می‌کند: پاک‌کردن فیلد در نوع nullable مقدار null می‌دهد و در
   نوع غیر nullable مقدار 0 (مطابق رفتار AppPriceField). *@
@using System.Globalization
@using System.Linq.Expressions
@using System.Text
@inject IJSRuntime JS
@typeparam TValue

<div class="mb-3">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label">@Label @if (IsRequired) { <span class="text-danger" title="الزامی">*</span> }</label>
    }
    <input type="text" class="form-control text-end" inputmode="decimal" autocomplete="off"
           value="@DisplayText" @oninput="HandleInput" @onblur="HandleBlur"
           placeholder="@Placeholder" disabled="@Disabled" @ref="InputElement" />
    <ValidationMessage For="@ValueExpression" class="text-danger small mt-1 d-block" />
    @if (!string.IsNullOrEmpty(Hint))
    {
        <div class="form-text">@Hint</div>
    }
</div>

@code {
    private static readonly CultureInfo Cn = CultureInfo.InvariantCulture;

    private ElementReference InputElement;
    private string? DisplayText;
    private string? _lastDisplay; // جلوی بازنویسی متنِ وسط تایپ کاربر هنگام رندر مجدد

    private static bool IsNullable => Nullable.GetUnderlyingType(typeof(TValue)) is not null;

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<TValue?>>? ValueExpression { get; set; }

    // ستاره‌ی «الزامی» هم از پارامترِ صریحِ Required و هم از attribute های DTO مشتق می‌شود.
    private bool IsRequired => Required || ValidationAttributeInspector.IsRequired(ValueExpression);

    protected override void OnParametersSet()
    {
        var incoming = Value is null ? null : string.Format(Cn, "{0:#,0.##}", Value);
        if (incoming != DisplayText && incoming != _lastDisplay) // فقط تغییرِ از بیرون را روی نمایش اعمال کن
        {
            DisplayText = incoming;
            _lastDisplay = incoming;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !Disabled)
            await JS.InvokeVoidAsync("dashboardPriceInput.attach", InputElement);
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        var cleaned = Clean(raw);

        if (string.IsNullOrEmpty(cleaned))
        {
            DisplayText = string.Empty;
            _lastDisplay = string.Empty;
            await ValueChanged.InvokeAsync(default); // nullable → null، غیر nullable → 0
            return;
        }

        if (!decimal.TryParse(cleaned, NumberStyles.Number, Cn, out var d))
            return; // ورودی هنوز عدد معتبر نشده؛ همان متن تایپ‌شده بماند

        var underlying = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
        object converted = underlying == typeof(decimal) ? d : Convert.ChangeType(d, underlying, Cn);

        DisplayText = string.Format(Cn, "{0:#,0.##}", converted);
        _lastDisplay = DisplayText;
        await ValueChanged.InvokeAsync((TValue?)converted);
    }

    private void HandleBlur()
    {
        if (string.IsNullOrEmpty(DisplayText))
            return;
        DisplayText = string.Format(Cn, "{0:#,0.##}", Value);
    }

    // ارقام فارسی/عربی → لاتین، حذف کاما و کاراکترهای اضافه
    private static string Clean(string raw)
    {
        var sb = new StringBuilder();
        var dotSeen = false;
        foreach (var ch in raw.Trim())
        {
            var c = ch;
            var code = (int)c;
            if (code >= 0x06F0 && code <= 0x06F9) c = (char)(code - 0x06F0 + '0');
            else if (code >= 0x0660 && code <= 0x0669) c = (char)(code - 0x0660 + '0');
            if (char.IsAsciiDigit(c)) sb.Append(c);
            else if (c == '.' && !dotSeen) { dotSeen = true; sb.Append(c); }
        }
        return sb.ToString();
    }
}
