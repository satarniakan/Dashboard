@* Dashboard.Web/Components/Shared/PersianDatePicker.razor *@
@* یک تاریخ‌گیر شمسی ساده با سه لیست کشویی روز/ماه/سال — بدون نیاز به هیچ کتابخانه‌ی جاوااسکریپت *@
@using System.Globalization

<div class="d-flex gap-2">
    <select class="form-select" @bind="dayValue" @bind:after="NotifyChangedAsync">
        @for (var d = 1; d <= daysInMonth; d++)
        {
            <option value="@d">@d</option>
        }
    </select>

    <select class="form-select" @bind="monthValue" @bind:after="OnMonthChangedAsync">
        @for (var m = 1; m <= 12; m++)
        {
            <option value="@m">@monthNames[m - 1]</option>
        }
    </select>

    <select class="form-select" @bind="yearValue" @bind:after="OnYearChangedAsync">
        @for (var y = minYear; y <= maxYear; y++)
        {
            <option value="@y">@y</option>
        }
    </select>
</div>

@code {
    // یک شیء PersianCalendar که تبدیل شمسی <-> میلادی رو برامون انجام می‌ده
    private static readonly PersianCalendar persianCalendar = new();

    private static readonly string[] monthNames =
    {
        "فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", "شهریور",
        "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند"
    };

    // این همان مقداری است که فرم اصلی (والد) به این کامپوننت می‌دهد و پس می‌گیرد
    [Parameter] public DateTime Value { get; set; }
    [Parameter] public EventCallback<DateTime> ValueChanged { get; set; }

    private int dayValue;
    private int monthValue;
    private int yearValue;
    private int daysInMonth = 31;

    private readonly int minYear = 1370;
    private readonly int maxYear = persianCalendar.GetYear(DateTime.Now.AddYears(5));

    // هر بار که فرم بیرونی مقدار جدیدی به این کامپوننت بدهد، این متد اجرا می‌شود
    // و تاریخ میلادی را به سه عدد شمسی (روز/ماه/سال) تبدیل می‌کند تا در لیست‌ها نشان بدهیم
    protected override void OnParametersSet()
    {
        var dateToShow = Value == default ? DateTime.Now : Value;

        yearValue = persianCalendar.GetYear(dateToShow);
        monthValue = persianCalendar.GetMonth(dateToShow);
        dayValue = persianCalendar.GetDayOfMonth(dateToShow);

        UpdateDaysInMonth();
    }

    // بعضی ماه‌های شمسی ۲۹ روزند، بعضی ۳۰، بعضی ۳۱ — این متد تعداد روزهای درست ماه انتخاب‌شده را حساب می‌کند
    private void UpdateDaysInMonth()
    {
        daysInMonth = persianCalendar.GetDaysInMonth(yearValue, monthValue);
        if (dayValue > daysInMonth)
        {
            dayValue = daysInMonth;
        }
    }

    private async Task OnMonthChangedAsync()
    {
        UpdateDaysInMonth();
        await NotifyChangedAsync();
    }

    private async Task OnYearChangedAsync()
    {
        UpdateDaysInMonth();
        await NotifyChangedAsync();
    }

    // روز/ماه/سال انتخاب‌شده را به یک DateTime میلادی واقعی تبدیل می‌کند و به فرم بیرونی خبر می‌دهد
    private async Task NotifyChangedAsync()
    {
        var newDate = persianCalendar.ToDateTime(yearValue, monthValue, dayValue, 0, 0, 0, 0);
        await ValueChanged.InvokeAsync(newDate);
    }
}
