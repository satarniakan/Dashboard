@using Dashboard.Web.Services
@inject ToastService ToastService
@implements IDisposable

<div class="toast-container">
    @foreach (var toast in _activeToasts)
    {
        <div class="toast-item toast-@toast.Type.ToString().ToLower()" @key="toast">
            @if (toast.Type == ToastType.Success)
            {
                <i class="bi bi-check-circle-fill"></i>
            }
            else if (toast.Type == ToastType.Error)
            {
                <i class="bi bi-x-circle-fill"></i>
            }
            else
            {
                <i class="bi bi-info-circle-fill"></i>
            }
            <span>@toast.Text</span>
        </div>
    }
</div>

@code {
    private List<ToastMessage> _activeToasts = new();

    protected override void OnInitialized()
    {
        ToastService.OnShow += HandleShow;
    }

    // هندلر رویداد نباید async void باشد؛ استثنا در Task جداگانه مهار می‌شود
    private void HandleShow(ToastMessage toast) => _ = HandleShowAsync(toast);

    private async Task HandleShowAsync(ToastMessage toast)
    {
        // در رندر استاتیک (پیش‌رندر اولیه یا پردازش POST فرم بدون مدار تعاملی)
        // توست جایی برای نمایش ندارد و re-render وسط پاسخ استاتیک می‌تواند
        // رندرر را با «renderer does not have a component with ID» متوقف کند
        if (RendererInfo.Name == "Static")
            return;

        try
        {
            _activeToasts.Add(toast);
            await InvokeAsync(StateHasChanged);

            await Task.Delay(3500);
            if (_activeToasts.RemoveAll(t => t.Id == toast.Id) > 0)
                await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // مدار در همین لحظه بسته شده؛ توست دیگر مهم نیست
        }
    }

    public void Dispose()
    {
        ToastService.OnShow -= HandleShow;
    }
}
