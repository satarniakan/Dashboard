@* Dashboard.Web/Components/Shared/AppPriceField.razor *@
@* ورودی مبلغ/قیمت با جداسازی سه‌رقمی هنگام تایپ (فرمت در priceInput.js انجام می‌شود) *@
@using System.Globalization
@using System.Linq.Expressions
@using System.Numerics
@using System.Text
@inject IJSRuntime JS
@typeparam TValue where TValue : struct, INumber<TValue>

<div class="@WrapperClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label">@Label</label>
    }
    <input type="text" class="form-control text-end" inputmode="decimal" autocomplete="off"
           value="@DisplayText" @oninput="HandleInput" @onblur="HandleBlur"
           placeholder="@Placeholder" disabled="@Disabled" @ref="InputElement" />
    <ValidationMessage For="@ValueExpression" class="text-danger small mt-1 d-block" />
</div>

@code {
    // هماهنگ با CurrencyFormatter: جداکننده‌ی «,» و اعشار «.» بدون اتکا به fa-IR
    private static readonly CultureInfo Cn = CultureInfo.InvariantCulture;

    private ElementReference InputElement;
    private string? DisplayText;
    private string _lastParsed = ""; // جلوی بازنویسی متنِ وسط تایپ کاربر هنگام رندر مجدد

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string WrapperClass { get; set; } = "mb-3";

    [Parameter] public TValue Value { get; set; }
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public Expression<Func<TValue>>? ValueExpression { get; set; }

    protected override void OnParametersSet()
    {
        var incoming = Value.ToString("0.##", Cn);
        if (incoming != _lastParsed) // فقط تغییرِ از بیرون را روی نمایش اعمال کن
        {
            _lastParsed = incoming;
            // صفرِ اولیه/بعد از پاک‌کردن، فیلد را خالی نشان بده نه «0»
            DisplayText = string.IsNullOrEmpty(DisplayText) && incoming == "0"
                ? string.Empty
                : Value.ToString("#,0.##", Cn);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !Disabled)
            await JS.InvokeVoidAsync("dashboardPriceInput.attach", InputElement);
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        TValue? parsed = Parse(raw);
        var value = parsed ?? default; // فیلد خالی → صفر
        _lastParsed = value.ToString("0.##", Cn);
        DisplayText = parsed is null ? string.Empty : value.ToString("#,0.##", Cn);
        if (!EqualityComparer<TValue>.Default.Equals(value, Value))
            await ValueChanged.InvokeAsync(value);
    }

    private void HandleBlur()
    {
        DisplayText = string.IsNullOrEmpty(DisplayText) ? string.Empty : Value.ToString("#,0.##", Cn);
    }

    // ارقام فارسی/عربی → لاتین، حذف کاما و کاراکترهای اضافه
    private static TValue? Parse(string raw)
    {
        var sb = new StringBuilder();
        var dotSeen = false;
        foreach (var ch in raw.Trim())
        {
            var c = ch;
            var code = (int)c;
            if (code >= 0x06F0 && code <= 0x06F9) c = (char)(code - 0x06F0 + '0');
            else if (code >= 0x0660 && code <= 0x0669) c = (char)(code - 0x0660 + '0');
            if (char.IsAsciiDigit(c)) sb.Append(c);
            else if (c == '.' && !dotSeen) { dotSeen = true; sb.Append(c); }
        }
        return TValue.TryParse(sb.ToString(), NumberStyles.Number, Cn, out var v) ? v : null;
    }
}
