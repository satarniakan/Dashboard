@* Dashboard.Web/Components/Shared/AppTextField.razor *@
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms

<div class="@WrapperClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label">@Label @if (IsRequired) { <span class="text-danger" title="الزامی">*</span> }</label>
    }

    @if (CascadedEditContext is not null)
    {
        @* داخل EditForm: ورودی InputBase با پشتیبانی اعتبارسنجی *@
        <InputText @attributes="ExtraAttributes" class="@CssClass" Value="@Value" ValueChanged="@ValueChanged"
                   ValueExpression="@ValueExpression" placeholder="@Placeholder" disabled="@Disabled" />
        @if (ValueExpression is not null)
        {
            <ValidationMessage For="@ValueExpression" class="text-danger small mt-1 d-block" />
        }
    }
    else
    {
        @* بیرون EditForm (مثل Profile): ورودی ساده — InputBase بدون EditContext/Expression کرش می‌کند *@
        <input @attributes="ExtraAttributes" class="@CssClass" value="@Value" @oninput="OnInput"
               placeholder="@Placeholder" disabled="@Disabled" />
    }

    @if (!string.IsNullOrEmpty(Hint))
    {
        <div class="form-text">@Hint</div>
    }
    @if (ShowCount && ResolvedMaxLength is not null)
    {
        <div class="form-text text-end">@((Value?.Length ?? 0).ToString("N0")) / @ResolvedMaxLength.Value.ToString("N0")</div>
    }
</div>

@code {
    [CascadingParameter]
    private EditContext? CascadedEditContext { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string WrapperClass { get; set; } = "mb-3";
    [Parameter] public string CssClass { get; set; } = "form-control";
    /// <summary>نوع input (مثل text، password، email). پیش‌فرض text.</summary>
    [Parameter] public string InputType { get; set; } = "text";
    /// <summary>سقف طول دستی؛ اگر null باشد از StringLength/MaxLength روی DTO خوانده می‌شود.</summary>
    [Parameter] public int? MaxLength { get; set; }
    /// <summary>نمایش شمارنده «n / max» زیر فیلد.</summary>
    [Parameter] public bool ShowCount { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string?>>? ValueExpression { get; set; }

    // ستاره‌ی «الزامی» هم از پارامترِ صریحِ Required و هم از attribute های DTO مشتق می‌شود.
    private bool IsRequired => Required || ValidationAttributeInspector.IsRequired(ValueExpression);

    private int? ResolvedMaxLength => MaxLength ?? ValidationAttributeInspector.GetMaxLength(ValueExpression);

    private Dictionary<string, object>? ExtraAttributes
    {
        get
        {
            Dictionary<string, object>? attrs = null;
            if (!string.IsNullOrWhiteSpace(InputType) && !string.Equals(InputType, "text", StringComparison.OrdinalIgnoreCase))
            {
                attrs = new() { ["type"] = InputType };
            }
            if (ResolvedMaxLength is not null)
            {
                attrs ??= new();
                attrs["maxlength"] = ResolvedMaxLength.Value;
            }
            return attrs;
        }
    }

    private Task OnInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());
}
