@* Dashboard.Web/Components/Pages/ComponentsShowcase.razor *@
@page "/components-showcase"
@using System.ComponentModel.DataAnnotations

<PageTitle>نمایش کامپوننت‌ها</PageTitle>

<h3>نمایش کامپوننت‌های مشترک</h3>

<div class="card-panel" style="max-width: 600px;">
    <EditForm Model="@sample" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary class="mb-3" />

        <AppTextField Label="نام کاربری" @bind-Value="sample.Username" Placeholder="مثلاً: علی محمدی" />

        <AppNumberField Label="سن" @bind-Value="sample.Age" Placeholder="0" />

        <AppDropdown Label="شهر" @bind-Value="sample.City" Placeholder="انتخاب کنید">
            <option value="تهران">تهران</option>
            <option value="مشهد">مشهد</option>
            <option value="اصفهان">اصفهان</option>
        </AppDropdown>

        <AppRadioGroup Label="جنسیت" @bind-Value="sample.Gender"
                       Options="genderOptions" />

        <AppCheckbox Label="عضویت در خبرنامه" @bind-Value="sample.SubscribeNewsletter" />

        <AppDateField Label="تاریخ تولد" @bind-Value="sample.BirthDate" />

        <button type="submit" class="btn btn-primary mt-2">ثبت</button>
    </EditForm>

    @if (submitted)
    {
        <div class="alert alert-success mt-3">فرم با موفقیت ثبت شد.</div>
    }
</div>

<h3 class="mt-5">نمونه گرید</h3>

<AppDataGrid Items="@sampleRows" EmptyText="ردیفی موجود نیست.">
    <HeaderTemplate>
        <th>ردیف</th>
        <th>عنوان</th>
    </HeaderTemplate>
    <RowTemplate Context="row">
        <td>@row.Id</td>
        <td>@row.Title</td>
    </RowTemplate>
</AppDataGrid>

@code {
    private SampleModel sample = new();
    private bool submitted;

    private List<(string? Value, string Label)> genderOptions = new()
{
    ("Male", "مرد"),
    ("Female", "زن")
};
    private List<GridRow> sampleRows = new()
    {
        new GridRow { Id = 1, Title = "ردیف اول" },
        new GridRow { Id = 2, Title = "ردیف دوم" }
    };

    private void HandleSubmit()
    {
        submitted = true;
    }

    public class SampleModel
    {
        [Required(ErrorMessage = "نام کاربری الزامی است.")]
        public string Username { get; set; } = string.Empty;

        [Range(1, 120, ErrorMessage = "سن باید بین ۱ تا ۱۲۰ باشد.")]
        public int Age { get; set; }

        [Required(ErrorMessage = "انتخاب شهر الزامی است.")]
        public string? City { get; set; }

        [Required(ErrorMessage = "انتخاب جنسیت الزامی است.")]
        public string? Gender { get; set; }

        public bool SubscribeNewsletter { get; set; }

        public DateTime? BirthDate { get; set; }
    }

    public class GridRow
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
    }
}