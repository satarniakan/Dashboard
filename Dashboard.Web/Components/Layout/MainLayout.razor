@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu @rendermode="InteractiveServer" />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="text-muted small">@context.User.Identity?.Name</span>
                </Authorized>
            </AuthorizeView>
        </div>
        <article class="content px-4 py-4">
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="alert alert-danger m-3">
                        مشکلی در نمایش این صفحه پیش اومد.
                        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="Recover">تلاش دوباره</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>

@code {
    private ErrorBoundary? errorBoundary;
    private void Recover() => errorBoundary?.Recover();
}
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    خطایی رخ داد.
    <a href="" class="reload">بارگذاری مجدد</a>
    <a class="dismiss">🗙</a>
</div>
