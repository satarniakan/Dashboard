@using Microsoft.AspNetCore.Components.Authorization
<AuthorizeView>
    <Authorized>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="">خانه</NavLink>
        </div>

        <AuthorizeView Roles="@Dashboard.Domain.Identity.Roles.Admin" Context="adminMenuContext">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="products">محصولات</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="audit-logs">گزارش رویدادها</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/users">مدیریت کاربران</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/roles">مدیریت مجوزها</NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.StockView" Context="warehouseMenuContext">
            <Authorized>
                <div class="nav-item px-3 mt-2">
                    <span class="text-muted small">انبارداری</span>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="warehouse/stock">موجودی کالاها</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="warehouse/purchase-receipts">رسیدهای خرید</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="warehouse/internal-issues">حواله‌های مصرف داخلی</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="warehouse/sales-returns">برگشت از فروش</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="warehouse/scrap">ضایعات</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="warehouse/transfers">انتقال بین انبار</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="warehouse/stock-counts">انبارگردانی</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="warehouse/history">تاریخچه رویدادهای انبار</NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.WarehousesManage" Context="warehousesManageContext">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="warehouse/warehouses">انبارها</NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.CustomersManage" Context="customersMenuContext">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="warehouse/customers">مشتریان</NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.SalesView" Context="salesMenuContext">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="warehouse/sales">فاکتورهای فروش</NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.AccountingView" Context="accountingMenuContext">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting/journal">دفتر روزنامه</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting/trial-balance">تراز آزمایشی</NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.AccountingView" Context="accountingMenuContext">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting/journal">دفتر روزنامه</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting/trial-balance">تراز آزمایشی</NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.TreasuryManage" Context="treasuryMenuContext">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting/financial-accounts">صندوق و بانک</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting/customer-receipts">دریافت از مشتری</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounting/supplier-payments">پرداخت به تأمین‌کننده</NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.SuppliersManage" Context="suppliersManageContext">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="warehouse/suppliers">تأمین‌کنندگان</NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="profile">پروفایل من</NavLink>
        </div>
        <div class="nav-item px-3">
            <form action="/logout" method="post" data-enhance="false">
                <AntiforgeryToken />
                <button type="submit" class="nav-link btn btn-link">خروج</button>
            </form>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="">خانه</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="login">ورود / ثبت‌نام</NavLink>
        </div>
    </NotAuthorized>
</AuthorizeView>
