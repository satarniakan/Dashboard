@code {
    private bool salesOpen;
    private bool warehouseOpen;
    private bool accountingOpen;
    private bool adminOpen;
    private bool catalogOpen;
    private bool storeOpen;
    // مرکز گزارش‌ها — هر فاز یک زیرساخت جدا.
    // برای فاز بعدی یک bool جدید همراه با: بخش AuthorizeView در markup،
    // یک case در Toggle، و مسیریابی خودکار در UpdateOpenSections.
    private bool reportsOpen;
    private bool reportPhase1Open;
    private bool reportPhase2Open;

    // هر بار که این کامپوننت از نو ساخته می‌شود (مثلاً بعد از ریلود کامل صفحه‌ای مثل
    // پروفایل)، به‌جای بازشدن یک بخش ثابت، فقط بخشی که به صفحه‌ی فعلی مربوط است باز می‌شود.
    private static readonly string[] SalesRoutes = { "warehouse/sales", "warehouse/customers" };
    private static readonly string[] WarehouseRoutes =
    {
        "warehouse/stock", "warehouse/purchase-receipts", "warehouse/purchase-returns", "warehouse/internal-issues",
        "warehouse/sales-returns", "warehouse/transfers", "warehouse/scrap",
        "warehouse/stock-counts", "warehouse/warehouses", "warehouse/suppliers"
    };

    protected override void OnInitialized()
    {
        var path = new Uri(NavigationManager.Uri).AbsolutePath.Trim('/');

        salesOpen = SalesRoutes.Any(r => path.StartsWith(r, StringComparison.OrdinalIgnoreCase));
        warehouseOpen = WarehouseRoutes.Any(r => path.StartsWith(r, StringComparison.OrdinalIgnoreCase));
        accountingOpen = path.StartsWith("accounting/", StringComparison.OrdinalIgnoreCase);
        catalogOpen = path.StartsWith("catalog/", StringComparison.OrdinalIgnoreCase);
        adminOpen = path.StartsWith("admin/", StringComparison.OrdinalIgnoreCase) && !path.StartsWith("admin/orders", StringComparison.OrdinalIgnoreCase) && !path.StartsWith("admin/discounts", StringComparison.OrdinalIgnoreCase);
        storeOpen = path.StartsWith("admin/orders", StringComparison.OrdinalIgnoreCase)
                 || path.StartsWith("admin/discounts", StringComparison.OrdinalIgnoreCase);
        // بخش گزارش‌ها و فاز ۱ هم باید هنگام ورود مستقیم باز باشند، وگرنه کاربر
        // روی /reports/… می‌آید و منو بسته است و فکر می‌کند صفحه خالی است
        reportsOpen = path.StartsWith("reports/", StringComparison.OrdinalIgnoreCase);
        // گزارش‌های مالی در فاز ۱ و گزارش‌های انبار در فاز ۲ هستند
        reportPhase1Open = reportsOpen && !path.StartsWith("reports/stock", StringComparison.OrdinalIgnoreCase);
        reportPhase2Open = path.StartsWith("reports/stock", StringComparison.OrdinalIgnoreCase);
    }

    private void Toggle(string sectionName)
    {
        switch (sectionName)
        {
            case nameof(salesOpen): salesOpen = !salesOpen; break;
            case nameof(warehouseOpen): warehouseOpen = !warehouseOpen; break;
            case nameof(accountingOpen): accountingOpen = !accountingOpen; break;
            case nameof(adminOpen): adminOpen = !adminOpen; break;
            case nameof(catalogOpen): catalogOpen = !catalogOpen; break;
            case nameof(storeOpen): storeOpen = !storeOpen; break;
            case nameof(reportsOpen): reportsOpen = !reportsOpen; break;
            case nameof(reportPhase1Open): reportPhase1Open = !reportPhase1Open; break;
            case nameof(reportPhase2Open): reportPhase2Open = !reportPhase2Open; break;
        }
    }
}
