@using Microsoft.AspNetCore.Components.Authorization
<AuthorizeView>
    <Authorized>
        <div class="nav-item px-3">
            <form action="/logout" method="post">
                <AntiforgeryToken />
                <button type="submit" class="nav-link btn btn-link">خروج</button>
            </form>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="">خانه</NavLink>
        </div>
       
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="products">محصولات</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="audit-logs">
                گزارش رویدادها
            </NavLink>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="">خانه</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="login">ورود</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="register">ثبت‌نام</NavLink>
        </div>
        

       
    </NotAuthorized>
</AuthorizeView>