@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using Dashboard.Application.Helpers
@inject IDashboardService DashboardService

<PageTitle>داشبورد</PageTitle>

<AuthorizeView>
    <Authorized>
        <AuthorizeView Roles="@Dashboard.Domain.Identity.Roles.Admin" Context="adminHomeCtx">
            <Authorized>
                @if (data is null)
                {
                    <div aria-busy="true" aria-live="polite">
                        <div class="row g-3 mb-4">
                            @for (var i = 0; i < 4; i++)
                            {
                                <div class="col-md-3 col-6">
                                    <div class="card-panel"><div class="skeleton" style="height: 4.5rem;"></div></div>
                                </div>
                            }
                        </div>
                        <div class="row g-3">
                            <div class="col-lg-8"><div class="card-panel"><div class="skeleton" style="height: 16rem;"></div></div></div>
                            <div class="col-lg-4"><div class="card-panel"><div class="skeleton" style="height: 16rem;"></div></div></div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
                        <div>
                            <h3 class="mb-1">داشبورد مدیریتی</h3>
                            <div class="text-body-secondary small">نمای کلی فروش، سود و مطالبات</div>
                        </div>
                    </div>

                    <!-- کارت‌های KPI -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-3 col-6">
                            <div class="card-panel h-100">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-body-secondary small mb-1">فروش امروز</div>
                                        <div class="fs-4 fw-bold">@CurrencyFormatter.ToToman(data.Kpis.TodaySales)</div>
                                        <div class="text-body-secondary small">@data.Kpis.TodayInvoiceCount فاکتور</div>
                                    </div>
                                    <i class="bi bi-cash-stack fs-3" style="color: var(--brand-primary);" aria-hidden="true"></i>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="card-panel h-100">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-body-secondary small mb-1">فروش این ماه</div>
                                        <div class="fs-4 fw-bold">@CurrencyFormatter.ToToman(data.Kpis.MonthSales)</div>
                                    </div>
                                    <i class="bi bi-calendar3 fs-3" style="color: var(--brand-primary);" aria-hidden="true"></i>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="card-panel h-100">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-body-secondary small mb-1">سود این ماه</div>
                                        <div class="fs-4 fw-bold @(data.Kpis.MonthProfit >= 0 ? "text-success" : "text-danger")">
                                            @CurrencyFormatter.ToToman(data.Kpis.MonthProfit)
                                        </div>
                                    </div>
                                    <i class="bi bi-graph-up-arrow fs-3" style="color: var(--brand-success);" aria-hidden="true"></i>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="card-panel h-100">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-body-secondary small mb-1">جمع مطالبات از مشتریان</div>
                                        <div class="fs-4 fw-bold">@CurrencyFormatter.ToToman(data.Kpis.TotalReceivable)</div>
                                    </div>
                                    <i class="bi bi-people fs-3" style="color: var(--brand-primary);" aria-hidden="true"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- هشدارها -->
                    @if (data.Kpis.OverdueInstallmentCount > 0 || data.Kpis.LowStockCount > 0)
                    {
                        <div class="row g-3 mb-4">
                            @if (data.Kpis.OverdueInstallmentCount > 0)
                            {
                                <div class="col-md-6">
                                    <div class="alert alert-danger mb-0">
                                        ⚠️ <strong>@data.Kpis.OverdueInstallmentCount</strong> قسط معوق به مبلغ
                                        <strong>@CurrencyFormatter.ToToman(data.Kpis.OverdueAmount)</strong>
                                        — <a href="/accounting/overdue-installments" class="alert-link">مشاهده</a>
                                    </div>
                                </div>
                            }
                            @if (data.Kpis.LowStockCount > 0)
                            {
                                <div class="col-md-6">
                                    <div class="alert alert-warning mb-0">
                                        📦 <strong>@data.Kpis.LowStockCount</strong> کالا به نقطه سفارش مجدد رسیده —
                                        <a href="/warehouse/stock" class="alert-link">مشاهده موجودی</a>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <div class="row g-3 mb-4">
                        <!-- روند فروش ۷ روز اخیر (نمودار میله‌ای ساده بدون کتابخانه جانبی) -->
                        <div class="col-md-7">
                            <div class="card-panel h-100 d-flex flex-column">
                                <h6 class="mb-3">روند فروش ۷ روز اخیر</h6>
                                <div class="mt-auto d-flex align-items-end gap-2" style="height: 180px;">
                                    @{
                                        var maxSale = data.SalesTrend.Any() ? data.SalesTrend.Max(p => p.TotalAmount) : 0;
                                    }
                                    @foreach (var point in data.SalesTrend)
                                    {
                                        var heightPercent = maxSale > 0 ? (double)(point.TotalAmount / maxSale) * 100 : 0;
                                        <div class="flex-fill text-center">
                                            <div class="d-flex align-items-end justify-content-center" style="height: 160px;">
                                                <div class="rounded-top" style="width: 70%; height: @(Math.Max(heightPercent, 2))%; background: var(--brand-primary);" title="@CurrencyFormatter.ToToman(point.TotalAmount)"></div>
                                            </div>
                                            <div class="text-body-secondary small mt-1">@point.Date.ToString("MM/dd")</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- پرفروش‌ترین کالاها -->
                        <div class="col-md-5">
                            <div class="card-panel h-100">
                                <h6 class="mb-3">پرفروش‌ترین کالاها (این دوره)</h6>
                                @if (!data.TopProducts.Any())
                                {
                                    <div class="text-center text-body-secondary py-4">
                                        <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                        <span class="small">داده‌ای موجود نیست.</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                    <table class="table table-sm mb-0">
                                        <tbody>
                                            @foreach (var p in data.TopProducts)
                                            {
                                                <tr>
                                                    <td>@p.ProductName</td>
                                                    <td class="text-body-secondary">@QuantityFormatter.Format(p.TotalQuantitySold) عدد</td>
                                                    <td class="text-end">@CurrencyFormatter.ToToman(p.TotalRevenue)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- آخرین فاکتورها -->
                    <div class="card-panel">
                        <h6 class="mb-3">آخرین فاکتورهای فروش</h6>
                        @if (!data.RecentInvoices.Any())
                        {
                            <div class="text-center text-body-secondary py-4">
                                <i class="bi bi-receipt fs-3 d-block mb-2"></i>
                                <span class="small">هنوز فاکتوری ثبت نشده است.</span>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr><th>شماره</th><th>تاریخ</th><th>مشتری</th><th>مبلغ</th><th>وضعیت</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var inv in data.RecentInvoices)
                                    {
                                        <tr>
                                            <td><a href="/warehouse/sales/@inv.Id">@inv.InvoiceNumber</a></td>
                                            <td class="text-body-secondary">@inv.InvoiceDate.ToString("yyyy/MM/dd")</td>
                                            <td>@(inv.CustomerName ?? "مشتری حضوری")</td>
                                            <td>@CurrencyFormatter.ToToman(inv.TotalAmount)</td>
                                            <td>@inv.Status</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                        }
                    </div>
                }
            </Authorized>
            <NotAuthorized>
                <h3>خوش آمدید 👋</h3>
                <p class="text-body-secondary">از منوی کناری بخش مورد نظرتان را انتخاب کنید.</p>
            </NotAuthorized>
        </AuthorizeView>
    </Authorized>
    <NotAuthorized>
        <h3>به سیستم مدیریت خوش آمدید</h3>
        <p class="text-body-secondary">برای ادامه، <a href="/login">وارد شوید</a>.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private DashboardDataDto? data;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProviderTask();
        if (authState.User.IsInRole(Dashboard.Domain.Identity.Roles.Admin))
        {
            data = await DashboardService.GetDashboardDataAsync();
        }
    }

    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;

    private async Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState> AuthenticationStateProviderTask()
        => await AuthStateProvider.GetAuthenticationStateAsync();
}