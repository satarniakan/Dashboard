@page "/products"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.ProductsView)]
@using Microsoft.AspNetCore.Authorization
@inject IProductService ProductService
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using Dashboard.Application.Helpers
@using System.Security.Claims
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Dashboard.Web.Components.Pages.Products> Logger
@inject Dashboard.Web.Services.ToastService ToastService
<PageTitle>محصولات</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">محصولات</h3>
    <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.ProductsManage" Context="manageContext">
        <Authorized>
            <a href="/products/add" class="btn btn-primary">+ افزودن محصول</a>
        </Authorized>
    </AuthorizeView>
</div>

<div class="card-panel">
    <div class="mb-3">
        <input type="search" class="form-control" style="max-width: 320px;" placeholder="جست‌وجو بر اساس نام کالا..."
               value="@searchTerm" @oninput="OnSearchChanged" />
    </div>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (products is null)
    {
        <p class="text-muted">در حال بارگذاری...</p>
    }
    else if (!products.Any())
    {
        <p class="text-muted text-center py-4">هنوز محصولی ثبت نشده است.</p>
    }
    else
    {
        <table class="table mb-0">
            <thead>
                <tr>
                    <th></th>
                    <th>نام</th>
                    <th>کد کالا</th>
                    <th>دسته‌بندی</th>
                    <th>قیمت</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in products)
                {
                    <tr>
                        <td style="width: 48px;">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="@product.Name" class="rounded" style="width: 40px; height: 40px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded bg-body-tertiary d-flex align-items-center justify-content-center text-muted" style="width: 40px; height: 40px; font-size: 0.7rem;">—</div>
                            }
                        </td>
                        <td class="fw-medium">@product.Name</td>
                        <td class="text-muted">@product.Sku</td>
                        <td class="text-muted">@(product.CategoryName ?? "-")</td>
                        <td>@CurrencyFormatter.ToToman(product.Price)</td>
                        <td class="text-end">
                            <AuthorizeView Roles="@Dashboard.Domain.Identity.Roles.Admin">
                                <Authorized>
                                    <a href="/products/edit/@product.Id" class="btn btn-sm btn-outline-primary">ویرایش</a>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(product.Id, product.Name)">حذف</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <Dashboard.Web.Components.Shared.Pager CurrentPage="currentPage" TotalPages="totalPages"
                                            TotalCount="totalCount" OnPageChanged="OnPageChanged" />
</div>

@if (productToDelete is not null)
{
    <div class="modal show d-block" style="background-color: rgba(0,0,0,0.4);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body p-4">
                    <p class="mb-4">آیا از حذف محصول «<strong>@productToDelete.Value.Name</strong>» مطمئن هستید؟</p>
                    <div class="d-flex gap-2 justify-content-end">
                        <button class="btn btn-outline-secondary" @onclick="CancelDelete">انصراف</button>
                        <button class="btn btn-danger" @onclick="DeleteConfirmed">حذف</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<ProductDto>? products;
    private (int Id, string Name)? productToDelete;
    private string? errorMessage;

    private string searchTerm = string.Empty;
    private int currentPage = 1;
    private int totalPages;
    private int totalCount;
    private const int PageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        var result = await ProductService.GetProductsPagedAsync(currentPage, PageSize, searchTerm);
        products = result.Items;
        totalPages = result.TotalPages;
        totalCount = result.TotalCount;
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        currentPage = 1; // با هر جست‌وجوی جدید، برمی‌گردیم صفحه‌ی اول
        await LoadProducts();
    }

    private async Task OnPageChanged(int page)
    {
        currentPage = page;
        await LoadProducts();
    }

    private void ConfirmDelete(int id, string name)
    {
        productToDelete = (id, name);
    }

    private void CancelDelete()
    {
        productToDelete = null;
    }

    private async Task DeleteConfirmed()
    {
        if (productToDelete is null) return;

        errorMessage = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userEmail = authState.User.FindFirstValue(ClaimTypes.Email)
                             ?? authState.User.Identity?.Name;

            await ProductService.DeleteProductAsync(productToDelete.Value.Id, userEmail);
            ToastService.ShowSuccess("محصول با موفقیت حذف شد.");

            // اگر آخرین محصول همین صفحه حذف شد و صفحه‌ی خالی موند، یکی برو عقب
            if (products?.Count() == 1 && currentPage > 1)
                currentPage--;

            await LoadProducts();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در حذف محصول {ProductId}", productToDelete.Value.Id);
            errorMessage = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
        }
        finally
        {
            productToDelete = null;
        }
    }
}