@* Dashboard.Web/Components/Pages/EditProduct.razor *@
@page "/products/edit/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.ProductsManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using Dashboard.Domain.Interfaces
@using System.Security.Claims
@inject IProductService ProductService
@inject ICatalogService CatalogService
@inject IFileStorageService FileStorage
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Dashboard.Web.Components.Pages.EditProduct> Logger
@inject Dashboard.Web.Services.ToastService ToastService
<PageTitle>ویرایش محصول</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-1">ویرایش محصول</h3>
        <div class="text-body-secondary small">اطلاعات کالا را ویرایش کنید؛ فیلدهای ستاره‌دار الزامی هستند.</div>
    </div>
    <a href="/products" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-right me-1"></i>بازگشت به فهرست
    </a>
</div>

@if (notFound)
{
    <div class="alert alert-danger">محصول مورد نظر یافت نشد.</div>
}
else if (editModel is null)
{
    <LoadingSkeleton Table="false" Rows="6" />
}
else
{
    <EditForm Model="@editModel" OnValidSubmit="HandleValidSubmit" FormName="EditProductForm">
        <DataAnnotationsValidator />

        <div class="row g-3">
            <div class="col-lg-8">

                @* ===== اطلاعات اصلی ===== *@
                <div class="card-panel mb-3">
                    <h6 class="form-section-title"><i class="bi bi-box-seam"></i>اطلاعات اصلی</h6>

                    <AppTextField @bind-Value="editModel.Name" Label="نام محصول" Required="true" />

                    <div class="row">
                        <div class="col-md-6">
                            <AppTextField @bind-Value="editModel.Sku" Label="کد کالا (SKU)" Required="true" />
                        </div>
                        <div class="col-md-6">
                            <AppTextField @bind-Value="editModel.Barcode" Label="بارکد (اختیاری)" />
                        </div>
                    </div>
                </div>

                @* ===== قیمت‌گذاری ===== *@
                <div class="card-panel mb-3">
                    <h6 class="form-section-title"><i class="bi bi-cash-coin"></i>قیمت‌گذاری</h6>

                    <div class="row">
                        <div class="col-md-6">
                            <AppPriceField TValue="decimal" @bind-Value="editModel.Price" Label="قیمت فروش (تومان)"
                                           Placeholder="0" WrapperClass="" ShowWords="true"
                                           QuickAmounts="new[] { 100_000L, 500_000L, 1_000_000L }" />
                        </div>
                        <div class="col-md-6">
                            <AppPriceField TValue="decimal" @bind-Value="editModel.CostPrice" Label="بهای تمام‌شده (تومان)"
                                           Placeholder="0" WrapperClass="" ShowWords="true"
                                           Hint="قیمت خرید یا تولید؛ مبنای محاسبه‌ی سود" />
                        </div>
                    </div>
                </div>

                @* ===== دسته‌بندی و انبار ===== *@
                <div class="card-panel mb-3">
                    <h6 class="form-section-title"><i class="bi bi-clipboard-data"></i>دسته‌بندی و انبار</h6>

                    <div class="row">
                        <div class="col-md-6">
                            <AppDropdown Label="دسته‌بندی" Placeholder="بدون دسته‌بندی" @bind-Value="editModel.CategoryId">
                                @if (categories is not null)
                                {
                                    @foreach (var c in categories)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                }
                            </AppDropdown>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">واحد شمارش</label>
                                <select class="form-select" @bind="editModel.Unit">
                                    @* واحد فعلی کالا اگر در فهرست نبود (داده‌ی قدیمی/آزاد)، حفظ می‌شود *@
                                    @if (!string.IsNullOrEmpty(editModel.Unit) && !unitNames.Contains(editModel.Unit))
                                    {
                                        <option value="@editModel.Unit">@editModel.Unit (فعلی)</option>
                                    }
                                    @foreach (var unit in unitNames)
                                    {
                                        <option value="@unit">@unit</option>
                                    }
                                </select>
                                <div class="form-text">مدیریت واحدها: <a href="/catalog/units">واحدهای شمارش</a></div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <AppNumberField TValue="int" @bind-Value="editModel.ReorderPoint" Label="نقطه سفارش مجدد"
                                            Placeholder="0" Hint="وقتی موجودی به این عدد برسد، کالا در گزارش «کم‌موجودی» نمایش داده می‌شود." />
                        </div>
                    </div>
                </div>

                @* ===== ابعاد و وزن (اختیاری) ===== *@
                <details class="card-panel mb-3" open="@dimsOpen" @ontoggle="() => dimsOpen = !dimsOpen">
                    <summary class="form-section-title mb-0 border-0">
                        <i class="bi bi-chevron-down section-caret"></i>
                        <i class="bi bi-rulers"></i>ابعاد و وزن
                        <span class="text-body-secondary small fw-normal">(اختیاری)</span>
                    </summary>
                    <div class="row mt-3">
                        <div class="col-6 col-md-3">
                            <AppNumberField TValue="decimal?" @bind-Value="editModel.Weight" Label="وزن (kg)" Placeholder="0" />
                        </div>
                        <div class="col-6 col-md-3">
                            <AppNumberField TValue="decimal?" @bind-Value="editModel.Length" Label="طول (cm)" Placeholder="0" />
                        </div>
                        <div class="col-6 col-md-3">
                            <AppNumberField TValue="decimal?" @bind-Value="editModel.Width" Label="عرض (cm)" Placeholder="0" />
                        </div>
                        <div class="col-6 col-md-3">
                            <AppNumberField TValue="decimal?" @bind-Value="editModel.Height" Label="ارتفاع (cm)" Placeholder="0" />
                        </div>
                    </div>
                </details>
            </div>

            <div class="col-lg-4">

                @* ===== عکس محصول ===== *@
                <div class="card-panel mb-3">
                    <h6 class="form-section-title"><i class="bi bi-image"></i>عکس محصول</h6>

                    @if (isUploading)
                    {
                        <div class="image-dropzone">
                            <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
                            <div class="small mt-2">در حال آپلود…</div>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(editModel.ImageUrl))
                    {
                        <div class="image-preview mb-2">
                            <img src="@editModel.ImageUrl" alt="پیش‌نمایش محصول" />
                        </div>
                        <div class="d-flex gap-2">
                            <label class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-arrow-repeat me-1"></i>تغییر عکس
                                <InputFile OnChange="HandleImageUpload" accept="image/*" class="d-none" />
                            </label>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => editModel.ImageUrl = null">
                                <i class="bi bi-trash me-1"></i>حذف
                            </button>
                        </div>
                    }
                    else
                    {
                        <label class="image-dropzone">
                            <InputFile OnChange="HandleImageUpload" accept="image/*" class="d-none" />
                            <i class="bi bi-cloud-arrow-up fs-1"></i>
                            <div>انتخاب عکس</div>
                            <div class="small">یا فایل را اینجا رها کنید</div>
                        </label>
                    }
                    <div class="form-text mt-2">فرمت‌های تصویری؛ حداکثر ۵ مگابایت.</div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3 mb-0">
                <i class="bi bi-exclamation-octagon me-1"></i>@errorMessage
            </div>
        }

        @* ===== نوار عملیات ===== *@
        <div class="card-panel form-actions mt-3 d-flex align-items-center gap-2">
            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-check-lg me-1"></i>
                }
                ذخیره تغییرات
            </button>
            <a href="/products" class="btn btn-outline-secondary">انصراف</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private UpdateProductDto? editModel;
    private IEnumerable<CategoryDto>? categories;
    private List<string> unitNames = new();
    private bool isSaving;
    private bool isUploading;
    private bool notFound;
    private bool dimsOpen;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        categories = await CatalogService.GetCategoriesAsync();
        unitNames = (await CatalogService.GetUnitsAsync()).Select(u => u.Name).ToList();

        var product = await ProductService.GetProductAsync(Id);

        if (product is null)
        {
            notFound = true;
            return;
        }

        editModel = new UpdateProductDto
        {
            Name = product.Name,
            Price = product.Price,
            Sku = product.Sku,
            Barcode = product.Barcode,
            Unit = product.Unit,
            CostPrice = product.CostPrice,
            Weight = product.Weight,
            Length = product.Length,
            Width = product.Width,
            Height = product.Height,
            ReorderPoint = product.ReorderPoint,
            CategoryId = product.CategoryId,
            ImageUrl = product.ImageUrl
        };
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        isUploading = true;
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024); // حداکثر ۵ مگابایت
            var url = await FileStorage.SaveFileAsync(stream, file.Name);
            editModel!.ImageUrl = url;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در آپلود عکس محصول {ProductId}", Id);
            ToastService.ShowError("آپلود عکس ناموفق بود. لطفاً دوباره تلاش کنید.");
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        string? userEmail = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            userEmail = authState.User.FindFirstValue(ClaimTypes.Email)
                             ?? authState.User.Identity?.Name;

            var result = await ProductService.UpdateProductAsync(Id, editModel!, userEmail);

            if (result is null)
            {
                errorMessage = "محصول مورد نظر یافت نشد.";
            }
            else
            {
                ToastService.ShowSuccess("تغییرات محصول ذخیره شد.");
                NavigationManager.NavigateTo("/products");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ویرایش محصول {ProductId} توسط {UserEmail}", Id, userEmail);
            errorMessage = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
            ToastService.ShowError(errorMessage);
        }
        finally
        {
            isSaving = false;
        }
    }
}
