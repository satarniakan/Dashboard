@* Dashboard.Web/Components/Pages/EditProduct.razor *@
@page "/products/edit/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.ProductsManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using Dashboard.Domain.Interfaces
@using System.Security.Claims
@inject IProductService ProductService
@inject ICatalogService CatalogService
@inject IFileStorageService FileStorage
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Dashboard.Web.Components.Pages.EditProduct> Logger
@inject Dashboard.Web.Services.ToastService ToastService
<PageTitle>ویرایش محصول</PageTitle>

<h3>ویرایش محصول</h3>

@if (notFound)
{
    <div class="alert alert-danger">محصول مورد نظر یافت نشد.</div>
}
else if (editModel is null)
{
    <p class="text-muted">در حال بارگذاری...</p>
}
else
{
    <div class="card-panel" style="max-width: 640px;">
        <EditForm Model="@editModel" OnValidSubmit="HandleValidSubmit" FormName="EditProductForm">
            <DataAnnotationsValidator />
            <ValidationSummary class="mb-3" />

            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label class="form-label">نام محصول</label>
                        <InputText class="form-control" @bind-Value="editModel.Name" />
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">کد کالا (SKU)</label>
                            <InputText class="form-control" @bind-Value="editModel.Sku" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">بارکد (اختیاری)</label>
                            <InputText class="form-control" @bind-Value="editModel.Barcode" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">قیمت فروش (تومان)</label>
                            <AppPriceField TValue="decimal" @bind-Value="editModel.Price" WrapperClass=""
                                           ShowWords="true" QuickAmounts="new[] { 100_000L, 500_000L, 1_000_000L }" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">بهای تمام‌شده (تومان)</label>
                            <AppPriceField TValue="decimal" @bind-Value="editModel.CostPrice" WrapperClass=""
                                           ShowWords="true" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">واحد شمارش</label>
                            <select class="form-select" @bind="editModel.Unit">
                                @* واحد فعلی کالا اگر در فهرست نبود (داده‌ی قدیمی/آزاد)، حفظ می‌شود *@
                                @if (!string.IsNullOrEmpty(editModel.Unit) && !unitNames.Contains(editModel.Unit))
                                {
                                    <option value="@editModel.Unit">@editModel.Unit (فعلی)</option>
                                }
                                @foreach (var unit in unitNames)
                                {
                                    <option value="@unit">@unit</option>
                                }
                            </select>
                            <div class="form-text">مدیریت واحدها: <a href="/catalog/units">واحدهای شمارش</a></div>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">نقطه سفارش مجدد</label>
                            <InputNumber class="form-control" @bind-Value="editModel.ReorderPoint" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">دسته‌بندی</label>
                        <select class="form-select" @bind="editModel.CategoryId">
                            <option value="">بدون دسته‌بندی</option>
                            @if (categories is not null)
                            {
                                @foreach (var c in categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <details class="mb-3">
                        <summary class="text-muted" style="cursor: pointer;">ابعاد و وزن (اختیاری)</summary>
                        <div class="row mt-2">
                            <div class="col-3 mb-2">
                                <label class="form-label small">وزن (kg)</label>
                                <InputNumber class="form-control" @bind-Value="editModel.Weight" />
                            </div>
                            <div class="col-3 mb-2">
                                <label class="form-label small">طول (cm)</label>
                                <InputNumber class="form-control" @bind-Value="editModel.Length" />
                            </div>
                            <div class="col-3 mb-2">
                                <label class="form-label small">عرض (cm)</label>
                                <InputNumber class="form-control" @bind-Value="editModel.Width" />
                            </div>
                            <div class="col-3 mb-2">
                                <label class="form-label small">ارتفاع (cm)</label>
                                <InputNumber class="form-control" @bind-Value="editModel.Height" />
                            </div>
                        </div>
                    </details>
                </div>

                <div class="col-md-4">
                    <label class="form-label">عکس محصول</label>
                    @if (!string.IsNullOrEmpty(editModel.ImageUrl))
                    {
                        <img src="@editModel.ImageUrl" class="img-fluid rounded mb-2 border" alt="پیش‌نمایش" />
                    }
                    <InputFile OnChange="HandleImageUpload" class="form-control" accept="image/*" />
                    @if (isUploading)
                    {
                        <p class="text-muted mt-2 small">در حال آپلود...</p>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3">@errorMessage</div>
            }

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                    @(isSaving ? "در حال ذخیره..." : "ذخیره تغییرات")
                </button>
                <a href="/products" class="btn btn-outline-secondary">انصراف</a>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private UpdateProductDto? editModel;
    private IEnumerable<CategoryDto>? categories;
    private List<string> unitNames = new();
    private bool isSaving;
    private bool isUploading;
    private bool notFound;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        categories = await CatalogService.GetCategoriesAsync();
        unitNames = (await CatalogService.GetUnitsAsync()).Select(u => u.Name).ToList();

        var product = await ProductService.GetProductAsync(Id);

        if (product is null)
        {
            notFound = true;
            return;
        }

        editModel = new UpdateProductDto
        {
            Name = product.Name,
            Price = product.Price,
            Sku = product.Sku,
            Barcode = product.Barcode,
            Unit = product.Unit,
            CostPrice = product.CostPrice,
            Weight = product.Weight,
            Length = product.Length,
            Width = product.Width,
            Height = product.Height,
            ReorderPoint = product.ReorderPoint,
            CategoryId = product.CategoryId,
            ImageUrl = product.ImageUrl
        };
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        isUploading = true;
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024); // حداکثر ۵ مگابایت
            var url = await FileStorage.SaveFileAsync(stream, file.Name);
            editModel!.ImageUrl = url;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در آپلود عکس محصول {ProductId}", Id);
            ToastService.ShowError("آپلود عکس ناموفق بود. لطفاً دوباره تلاش کنید.");
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        string? userEmail = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            userEmail = authState.User.FindFirstValue(ClaimTypes.Email)
                             ?? authState.User.Identity?.Name;

            var result = await ProductService.UpdateProductAsync(Id, editModel!, userEmail);

            if (result is null)
            {
                errorMessage = "محصول مورد نظر یافت نشد.";
            }
            else
            {
                ToastService.ShowSuccess("تغییرات محصول ذخیره شد.");
                NavigationManager.NavigateTo("/products");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ویرایش محصول {ProductId} توسط {UserEmail}", Id, userEmail);
            errorMessage = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
            ToastService.ShowError(errorMessage);
        }
        finally
        {
            isSaving = false;
        }
    }
}
