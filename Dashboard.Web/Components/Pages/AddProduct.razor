@page "/products/add"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.ProductsManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using Dashboard.Domain.Interfaces
@using System.Security.Claims
@inject IProductService ProductService
@inject ICatalogService CatalogService
@inject IFileStorageService FileStorage
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Dashboard.Web.Components.Pages.AddProduct> Logger
@inject Dashboard.Web.Services.ToastService ToastService
<PageTitle>افزودن محصول</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-1">افزودن محصول</h3>
        <div class="text-body-secondary small">اطلاعات کالای جدید را وارد کنید؛ فیلدهای ستاره‌دار الزامی هستند.</div>
    </div>
    <a href="/products" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-right me-1"></i>بازگشت به فهرست
    </a>
</div>

<EditForm Model="newProduct" OnValidSubmit="HandleValidSubmit" FormName="AddProductForm">
    <DataAnnotationsValidator />

    <div class="row g-3">
        <div class="col-lg-8">

            @* ===== اطلاعات اصلی ===== *@
            <div class="card-panel mb-3">
                <h6 class="form-section-title"><i class="bi bi-box-seam"></i>اطلاعات اصلی</h6>

                <AppTextField @bind-Value="newProduct!.Name" Label="نام محصول" Required="true"
                              Placeholder="مثلاً: گل رز هلندی" />

                <div class="row">
                    <div class="col-md-6">
                        <AppTextField @bind-Value="newProduct!.Sku" Label="کد کالا (SKU)" Required="true"
                                      Placeholder="مثلاً: PRD-0001" Hint="کد یکتای کالا در انبار" />
                    </div>
                    <div class="col-md-6">
                        <AppTextField @bind-Value="newProduct!.Barcode" Label="بارکد (اختیاری)"
                                      Placeholder="بارکد روی بسته‌بندی" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <AppDropdown Label="دسته‌بندی" Placeholder="بدون دسته‌بندی" @bind-Value="newProduct!.CategoryId">
                            @if (categories is not null)
                            {
                                @foreach (var c in categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            }
                        </AppDropdown>
                    </div>
                    <div class="col-md-6">
                        <AppDropdown Label="واحد شمارش" @bind-Value="newProduct!.Unit">
                            @foreach (var u in units)
                            {
                                <option value="@u.Name">@u.Name</option>
                            }
                        </AppDropdown>
                        <div class="form-text">واحدها در صفحه‌ی <a href="/catalog/units">واحدهای شمارش</a> مدیریت می‌شوند.</div>
                    </div>
                </div>
            </div>

            @* ===== قیمت‌گذاری ===== *@
            <div class="card-panel mb-3">
                <h6 class="form-section-title"><i class="bi bi-cash-coin"></i>قیمت‌گذاری</h6>

                <div class="row">
                    <div class="col-md-6">
                        <AppPriceField TValue="decimal" @bind-Value="newProduct!.Price" Label="قیمت فروش (تومان)"
                                       Required="true" Placeholder="0" WrapperClass=""
                                       ShowWords="true" QuickAmounts="new[] { 100_000L, 500_000L, 1_000_000L }" />
                    </div>
                    <div class="col-md-6">
                        <AppPriceField TValue="decimal" @bind-Value="newProduct!.CostPrice" Label="بهای تمام‌شده (تومان)"
                                       Placeholder="0" WrapperClass="" ShowWords="true"
                                       Hint="قیمت خرید یا تولید؛ مبنای محاسبه‌ی سود" />
                    </div>
                </div>

                @if (newProduct!.Price > 0 && newProduct!.CostPrice > 0)
                {
                    @if (newProduct!.CostPrice > newProduct!.Price)
                    {
                        <div class="price-hint text-danger">
                            <i class="bi bi-exclamation-triangle"></i>
                            قیمت فروش از بهای تمام‌شده کمتر است؛ این کالا با ضرر فروخته می‌شود.
                        </div>
                    }
                    else
                    {
                        var margin = (newProduct!.Price - newProduct!.CostPrice) / newProduct!.Price * 100;
                        <div class="price-hint text-body-secondary">
                            <i class="bi bi-graph-up-arrow"></i>
                            حاشیه سود تقریبی: <strong>@margin.ToString("0")٪</strong>
                        </div>
                    }
                }
            </div>

            @* ===== انبار ===== *@
            <div class="card-panel mb-3">
                <h6 class="form-section-title"><i class="bi bi-clipboard-data"></i>انبار</h6>
                <div class="row">
                    <div class="col-md-6">
                        <AppNumberField TValue="int" @bind-Value="newProduct!.ReorderPoint" Label="نقطه سفارش مجدد"
                                        Placeholder="0" Hint="وقتی موجودی به این عدد برسد، کالا در گزارش «کم‌موجودی» نمایش داده می‌شود." />
                    </div>
                </div>
            </div>

            @* ===== ابعاد و وزن (اختیاری) ===== *@
            <details class="card-panel mb-3" open="@dimsOpen" @ontoggle="() => dimsOpen = !dimsOpen">
                <summary class="form-section-title mb-0 border-0">
                    <i class="bi bi-chevron-down section-caret"></i>
                    <i class="bi bi-rulers"></i>ابعاد و وزن
                    <span class="text-body-secondary small fw-normal">(اختیاری)</span>
                </summary>
                <div class="row mt-3">
                    <div class="col-6 col-md-3">
                        <AppNumberField TValue="decimal?" @bind-Value="newProduct!.Weight" Label="وزن (kg)" Placeholder="0" />
                    </div>
                    <div class="col-6 col-md-3">
                        <AppNumberField TValue="decimal?" @bind-Value="newProduct!.Length" Label="طول (cm)" Placeholder="0" />
                    </div>
                    <div class="col-6 col-md-3">
                        <AppNumberField TValue="decimal?" @bind-Value="newProduct!.Width" Label="عرض (cm)" Placeholder="0" />
                    </div>
                    <div class="col-6 col-md-3">
                        <AppNumberField TValue="decimal?" @bind-Value="newProduct!.Height" Label="ارتفاع (cm)" Placeholder="0" />
                    </div>
                </div>
            </details>
        </div>

        <div class="col-lg-4">

            @* ===== عکس محصول ===== *@
            <div class="card-panel mb-3">
                <h6 class="form-section-title"><i class="bi bi-image"></i>عکس محصول</h6>

                @if (isUploading)
                {
                    <div class="image-dropzone">
                        <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
                        <div class="small mt-2">در حال آپلود…</div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(newProduct!.ImageUrl))
                {
                    <div class="image-preview mb-2">
                        <img src="@newProduct!.ImageUrl" alt="پیش‌نمایش محصول" />
                    </div>
                    <div class="d-flex gap-2">
                        <label class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-arrow-repeat me-1"></i>تغییر عکس
                            <InputFile OnChange="HandleImageUpload" accept="image/*" class="d-none" />
                        </label>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RemoveImage">
                            <i class="bi bi-trash me-1"></i>حذف
                        </button>
                    </div>
                }
                else
                {
                    <label class="image-dropzone">
                        <InputFile OnChange="HandleImageUpload" accept="image/*" class="d-none" />
                        <i class="bi bi-cloud-arrow-up fs-1"></i>
                        <div>انتخاب عکس</div>
                        <div class="small">یا فایل را اینجا رها کنید</div>
                    </label>
                }
                <div class="form-text mt-2">فرمت‌های تصویری؛ حداکثر ۵ مگابایت.</div>
            </div>

            @* ===== راهنما ===== *@
            <div class="card-panel tips-panel">
                <h6 class="form-section-title"><i class="bi bi-lightbulb"></i>راهنمای سریع</h6>
                <ul class="small text-body-secondary mb-0 ps-3">
                    <li class="mb-2">نام و کد کالا (SKU) باید یکتا باشند.</li>
                    <li class="mb-2">قیمت فروش را می‌توانید با دکمه‌های میان‌بُر سریع وارد کنید.</li>
                    <li>اگر بهای تمام‌شده را وارد کنید، حاشیه سود به‌صورت خودکار محاسبه می‌شود.</li>
                </ul>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3 mb-0">
            <i class="bi bi-exclamation-octagon me-1"></i>@errorMessage
        </div>
    }

    @* ===== نوار عملیات ===== *@
    <div class="card-panel form-actions mt-3 d-flex align-items-center gap-2">
        <button type="submit" class="btn btn-primary" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            else
            {
                <i class="bi bi-check-lg me-1"></i>
            }
            ذخیره محصول
        </button>
        <button type="submit" class="btn btn-outline-primary" disabled="@isSaving" @onclick="() => saveAndNew = true">
            <i class="bi bi-plus-lg me-1"></i>ذخیره و محصول جدید
        </button>
        <a href="/products" class="btn btn-outline-secondary">انصراف</a>
    </div>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private CreateProductDto? newProduct { get; set; }

    private IEnumerable<CategoryDto>? categories;
    private List<UnitDto> units = new();
    private bool isSaving;
    private bool isUploading;
    private bool saveAndNew;
    private bool dimsOpen;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        newProduct ??= new();
        categories = await CatalogService.GetCategoriesAsync();
        units = (await CatalogService.GetUnitsAsync()).ToList();
    }

    private void RemoveImage()
    {
        newProduct!.ImageUrl = null;
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            ToastService.ShowError("فقط فایل تصویری قابل قبول است.");
            return;
        }

        isUploading = true;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024); // حداکثر ۵ مگابایت
            var url = await FileStorage.SaveFileAsync(stream, file.Name);
            newProduct!.ImageUrl = url;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در آپلود عکس محصول");
            ToastService.ShowError("آپلود عکس ناموفق بود. لطفاً دوباره تلاش کنید.");
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userEmail = authState.User.FindFirstValue(ClaimTypes.Email)
                             ?? authState.User.Identity?.Name;

        try
        {
            await ProductService.CreateProductAsync(newProduct!, userEmail);
            ToastService.ShowSuccess("محصول با موفقیت ذخیره شد.");

            if (saveAndNew)
            {
                // رفتن به فرم خالی برای ثبت محصول بعدی بدون تغییر صفحه
                saveAndNew = false;
                newProduct = new();
                errorMessage = null;
                StateHasChanged();
            }
            else
            {
                NavigationManager.NavigateTo("/products");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ذخیره محصول توسط {UserEmail}", userEmail);
            errorMessage = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
            ToastService.ShowError(errorMessage);
        }
        finally
        {
            isSaving = false;
        }
    }
}
