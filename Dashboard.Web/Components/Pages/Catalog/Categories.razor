@page "/catalog/categories"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.CatalogManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@inject ICatalogService CatalogService
@inject ILogger<Dashboard.Web.Components.Pages.Catalog.Categories> Logger
<PageTitle>دسته‌بندی‌ها</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-1">دسته‌بندی‌ها</h3>
        <div class="text-body-secondary small">دسته‌ها را برای سازمان‌دهی کالاها مدیریت کنید.</div>
    </div>
    <a href="/" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-right me-1"></i>بازگشت به پیشخوان
    </a>
</div>

<div class="card-panel mb-3" style="max-width: 640px;">
    <EditForm Model="@newCategory" OnValidSubmit="HandleAdd" FormName="AddCategoryForm">
        <h6 class="form-section-title"><i class="bi bi-tag"></i>افزودن دسته جدید</h6>

        <AppTextField @bind-Value="newCategory.Name" Label="نام دسته"
                      Placeholder="مثلاً: پوشاک مردانه" />

        <AppTextField @bind-Value="newCategory.Slug" Label="Slug"
                      Placeholder="مثلاً: mens-tshirts" Hint="برای آدرس صفحه‌ی دسته" />

        <AppDropdown Label="دسته والد (اختیاری)" Placeholder="-- بدون والد (دسته اصلی) --" @bind-Value="newCategory.ParentCategoryId">
            @if (categories is not null)
            {
                @foreach (var c in categories)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            }
        </AppDropdown>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mb-0">
                <i class="bi bi-exclamation-octagon me-1"></i>@errorMessage
            </div>
        }

        <div class="d-flex mt-3">
            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-plus-lg me-1"></i>
                }
                افزودن دسته
            </button>
        </div>
    </EditForm>
</div>

<div class="card-panel">
    <h6 class="form-section-title"><i class="bi bi-diagram-3"></i>دسته‌های ثبت‌شده</h6>

    @if (categories is null || !categories.Any())
    {
        <p class="text-body-secondary text-center py-4 mb-0">هنوز دسته‌ای ثبت نشده است.</p>
    }
    else
    {
        <table class="table mb-0">
            <thead><tr><th>نام</th><th>Slug</th><th>دسته والد</th></tr></thead>
            <tbody>
                @foreach (var c in categories)
                {
                    <tr>
                        <td class="fw-medium">@c.Name</td>
                        <td class="text-body-secondary">@c.Slug</td>
                        <td class="text-body-secondary">@(categories.FirstOrDefault(p => p.Id == c.ParentCategoryId)?.Name ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<CategoryDto>? categories;
    private CreateCategoryDto newCategory = new();
    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        categories = (await CatalogService.GetCategoriesAsync()).ToList();
    }

    private async Task HandleAdd()
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            await CatalogService.CreateCategoryAsync(newCategory);
            categories = (await CatalogService.GetCategoriesAsync()).ToList();
            newCategory = new();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ذخیره دسته‌بندی");
            errorMessage = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
        }
        finally
        {
            isSaving = false;
        }
    }
}
