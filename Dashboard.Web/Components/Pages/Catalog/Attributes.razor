@page "/catalog/attributes"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.CatalogManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@inject ICatalogService CatalogService
@inject ILogger<Dashboard.Web.Components.Pages.Catalog.Attributes> Logger

<PageTitle>ویژگی‌های محصول</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-1">ویژگی‌های محصول</h3>
        <div class="text-body-secondary small">ویژگی‌هایی مثل رنگ، سایز و جنس را برای استفاده در تنوع‌های کالا تعریف کنید.</div>
    </div>
    <a href="/" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-right me-1"></i>بازگشت به پیشخوان
    </a>
</div>

<div class="card-panel mb-3" style="max-width: 640px;">
    <EditForm Model="@newAttribute" OnValidSubmit="HandleAdd" FormName="AddAttributeForm">
        <DataAnnotationsValidator />

        <h6 class="form-section-title"><i class="bi bi-sliders"></i>افزودن ویژگی جدید</h6>

        <div class="mb-3">
            <label class="form-label">نام ویژگی <span class="text-danger" title="الزامی">*</span></label>
            <AppTextField @bind-Value="newAttribute.Name" Placeholder="مثلاً: رنگ"
                          WrapperClass="" CssClass="form-control" />
        </div>
        <AppTextArea @bind-Value="valuesRaw" Label="مقادیر" Rows="4"
                     Placeholder="هر مقدار در یک خط؛ مثلاً:"
                     Hint="هر مقدار را در یک خط جداگانه وارد کنید؛ مثلاً: قرمز، آبی، سبز"
                     WrapperClass="mb-3" />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mb-0">
                <i class="bi bi-exclamation-octagon me-1"></i>@errorMessage
            </div>
        }

        <div class="d-flex mt-3">
            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-plus-lg me-1"></i>
                }
                افزودن ویژگی
            </button>
        </div>
    </EditForm>
</div>

<div class="card-panel">
    <h6 class="form-section-title"><i class="bi bi-tags"></i>ویژگی‌های ثبت‌شده</h6>

    @if (attributes is null || !attributes.Any())
    {
        <p class="text-body-secondary text-center py-4 mb-0">هنوز ویژگی‌ای ثبت نشده است.</p>
    }
    else
    {
        @foreach (var a in attributes)
        {
            <div class="mb-3">
                <strong>@a.Name:</strong>
                <span class="text-body-secondary">@string.Join("، ", a.Values.Select(v => v.Value))</span>
            </div>
        }
    }
</div>

@code {
    private List<AttributeDto>? attributes;
    private CreateAttributeDto newAttribute = new();
    private string valuesRaw = string.Empty;
    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        attributes = (await CatalogService.GetAttributesAsync()).ToList();
    }

    private async Task HandleAdd()
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            newAttribute.Values = valuesRaw.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            await CatalogService.CreateAttributeAsync(newAttribute);
            attributes = (await CatalogService.GetAttributesAsync()).ToList();
            newAttribute = new();
            valuesRaw = string.Empty;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ذخیره ویژگی محصول");
            errorMessage = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
        }
        finally
        {
            isSaving = false;
        }
    }
}
