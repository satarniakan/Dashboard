@page "/catalog/units"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.CatalogManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using Dashboard.Application.Helpers
@inject ICatalogService CatalogService
@inject Dashboard.Web.Services.ToastService ToastService
@inject ILogger<Dashboard.Web.Components.Pages.Catalog.Units> Logger
<PageTitle>واحدهای شمارش</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-1">واحدهای شمارش</h3>
        <div class="text-body-secondary small">واحدهای شمارش کالاها (مثل کیلوگرم، بسته، متر) را مدیریت کنید.</div>
    </div>
    <a href="/" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-right me-1"></i>بازگشت به پیشخوان
    </a>
</div>

<div class="card-panel mb-3" style="max-width: 640px;">
    <EditForm Model="@newUnit" OnValidSubmit="HandleAdd" FormName="AddUnitForm">
        <h6 class="form-section-title"><i class="bi bi-rulers"></i>افزودن واحد جدید</h6>

        <div class="mb-3">
            <label class="form-label">نام واحد جدید</label>
            <InputText class="form-control" @bind-Value="newUnit.Name" maxlength="50" placeholder="مثلاً: کیلوگرم، بسته، متر" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mb-0">
                <i class="bi bi-exclamation-octagon me-1"></i>@errorMessage
            </div>
        }

        <div class="d-flex mt-3">
            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-plus-lg me-1"></i>
                }
                افزودن واحد
            </button>
        </div>
    </EditForm>
</div>

<div class="card-panel">
    <h6 class="form-section-title"><i class="bi bi-list-ul"></i>واحدهای ثبت‌شده</h6>

    @if (units is null)
    {
        <p class="text-body-secondary">در حال بارگذاری...</p>
    }
    else if (!units.Any())
    {
        <p class="text-body-secondary text-center py-4 mb-0">هنوز واحدی ثبت نشده است.</p>
    }
    else
    {
        <table class="table mb-0 align-middle">
            <thead>
                <tr>
                    <th>نام واحد</th>
                    <th>تعداد کالاها</th>
                    <th style="width: 180px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in units)
                {
                    if (editingId == u.Id)
                    {
                        <tr>
                            <td>
                                <input class="form-control form-control-sm" @bind="editName" maxlength="50"
                                       @bind:after="() => editError = null" />
                                @if (!string.IsNullOrEmpty(editError))
                                {
                                    <div class="text-danger small mt-1">@editError</div>
                                }
                            </td>
                            <td class="text-body-secondary">@QuantityFormatter.Format(u.ProductCount) کالا</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-success" disabled="@isSaving" @onclick="SaveEdit">
                                    <i class="bi bi-check-lg me-1"></i>ذخیره
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">انصراف</button>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td class="fw-medium">@u.Name</td>
                            <td class="text-body-secondary">@QuantityFormatter.Format(u.ProductCount) کالا</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => StartEdit(u)">
                                    <i class="bi bi-pencil me-1"></i>ویرایش
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="@(u.ProductCount > 0 ? "این واحد در حال استفاده است" : "حذف واحد")"
                                        @onclick="() => HandleDelete(u)">
                                    <i class="bi bi-trash me-1"></i>حذف
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<UnitDto>? units;
    private CreateUnitDto newUnit = new();
    private bool isSaving;
    private string? errorMessage;

    private int? editingId;
    private string editName = string.Empty;
    private string? editError;

    protected override async Task OnInitializedAsync()
    {
        units = (await CatalogService.GetUnitsAsync()).ToList();
    }

    private async Task HandleAdd()
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            await CatalogService.CreateUnitAsync(newUnit);
            units = (await CatalogService.GetUnitsAsync()).ToList();
            newUnit = new();
            ToastService.ShowSuccess("واحد شمارش جدید اضافه شد.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در افزودن واحد شمارش");
            errorMessage = ErrorMessageHelper.ToUserMessage(ex);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void StartEdit(UnitDto unit)
    {
        editingId = unit.Id;
        editName = unit.Name;
        editError = null;
    }

    private void CancelEdit()
    {
        editingId = null;
        editError = null;
    }

    private async Task SaveEdit()
    {
        if (editingId is null) return;
        isSaving = true;
        editError = null;
        try
        {
            await CatalogService.UpdateUnitAsync(editingId.Value, new UpdateUnitDto { Name = editName });
            units = (await CatalogService.GetUnitsAsync()).ToList();
            editingId = null;
            ToastService.ShowSuccess("نام واحد به‌روزرسانی شد (کالاهای مرتبط هم اصلاح شدند).");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ویرایش واحد شمارش");
            editError = ErrorMessageHelper.ToUserMessage(ex);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleDelete(UnitDto unit)
    {
        if (unit.ProductCount > 0)
        {
            ToastService.ShowInfo($"{unit.ProductCount} کالا از واحد «{unit.Name}» استفاده می‌کند؛ اول واحد آن کالاها را تغییر دهید.");
            return;
        }
        try
        {
            await CatalogService.DeleteUnitAsync(unit.Id);
            units = (await CatalogService.GetUnitsAsync()).ToList();
            ToastService.ShowSuccess("واحد شمارش حذف شد.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در حذف واحد شمارش");
            ToastService.ShowError(ErrorMessageHelper.ToUserMessage(ex));
        }
    }
}
