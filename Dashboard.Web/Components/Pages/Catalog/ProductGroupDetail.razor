@page "/catalog/product-groups/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.CatalogManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using Dashboard.Application.Helpers
@using Dashboard.Domain.Interfaces
@inject ICatalogService CatalogService
@inject ILogger<Dashboard.Web.Components.Pages.Catalog.ProductGroupDetail> Logger

<PageTitle>@group?.Name</PageTitle>

@if (group is null)
{
    <LoadingSkeleton Table="false" Rows="6" />
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h3 class="mb-1">@group.Name</h3>
            <div class="text-body-secondary small">@(group.CategoryName ?? "بدون دسته‌بندی")</div>
        </div>
        <a href="/catalog/product-groups" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-right me-1"></i>بازگشت به گروه‌ها
        </a>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            @* ===== تصاویر ===== *@
            <div class="card-panel mb-3">
                <h6 class="form-section-title"><i class="bi bi-image"></i>تصاویر</h6>

                @if (isUploading)
                {
                    <div class="image-dropzone">
                        <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
                        <div class="small mt-2">در حال آپلود…</div>
                    </div>
                }
                else
                {
                    <label class="image-dropzone">
                        <InputFile OnChange="HandleImageUpload" accept="image/*" class="d-none" />
                        <i class="bi bi-cloud-arrow-up fs-1"></i>
                        <div>انتخاب عکس</div>
                        <div class="small">یا فایل را اینجا رها کنید</div>
                    </label>
                }

                @if (group.Images.Any())
                {
                    <div class="d-flex flex-wrap gap-2 mt-3 mb-1">
                        @foreach (var img in group.Images)
                        {
                            <img src="@img.Url" style="width:80px;height:80px;object-fit:cover;border-radius:8px;" />
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-md-6">
            @* ===== افزودن Variant ===== *@
            <EditForm Model="@newVariant" OnValidSubmit="HandleAddVariant" FormName="AddVariantForm" class="card-panel mb-3">
                <DataAnnotationsValidator />

                <h6 class="form-section-title"><i class="bi bi-plus-square"></i>افزودن Variant جدید</h6>

                <AppTextField @bind-Value="newVariant.Sku" Label="کد کالا (SKU)" />
                <AppTextField @bind-Value="newVariant.Barcode" Label="بارکد (اختیاری)" />
                <AppTextField @bind-Value="newVariant.VariantName" Label="نام نمایشی"
                              Placeholder="مثلاً: قرمز - L" />

                <div class="row">
                    <div class="col-6">
                        <AppPriceField TValue="decimal" @bind-Value="newVariant.Price" Label="قیمت فروش (تومان)"
                                       Placeholder="0" WrapperClass="" ShowWords="true" />
                    </div>
                    <div class="col-6">
                        <AppPriceField TValue="decimal" @bind-Value="newVariant.CostPrice" Label="بهای تمام‌شده (تومان)"
                                       Placeholder="0" WrapperClass="" ShowWords="true" />
                    </div>
                </div>

                @if (attributes is not null)
                {
                    @foreach (var attr in attributes)
                    {
                        <div class="mb-3">
                            <label class="form-label">@attr.Name</label>
                            <select class="form-select" @onchange="e => OnAttributeSelected(attr.Id, e.Value)">
                                <option value="0">-- ندارد --</option>
                                @foreach (var val in attr.Values)
                                {
                                    <option value="@val.Id">@val.Value</option>
                                }
                            </select>
                        </div>
                    }
                }

                @if (!string.IsNullOrEmpty(variantError))
                {
                    <div class="alert alert-danger mb-0">
                        <i class="bi bi-exclamation-octagon me-1"></i>@variantError
                    </div>
                }

                <div class="d-flex mt-3">
                    <button type="submit" class="btn btn-primary" disabled="@isSavingVariant">
                        @if (isSavingVariant)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-plus-lg me-1"></i>
                        }
                        افزودن Variant
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

    @* ===== فهرست Variant ها ===== *@
    <div class="card-panel">
        <h6 class="form-section-title"><i class="bi bi-list-ul"></i>Variant های این گروه</h6>

        @if (!group.Variants.Any())
        {
            <p class="text-body-secondary text-center py-4 mb-0">هنوز Variant ای اضافه نشده است.</p>
        }
        else
        {
            <div class="table-responsive">
            <table class="table mb-0">
                <thead><tr><th>کد کالا</th><th>نام</th><th>قیمت</th></tr></thead>
                <tbody>
                    @foreach (var v in group.Variants)
                    {
                        <tr>
                            <td>@v.Sku</td>
                            <td>@v.AttributeSummary</td>
                            <td>@CurrencyFormatter.ToToman(v.Price)</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }

        @* دکمه‌ی ثبت به فرمِ بالای همین صفحه منتقل شد تا Validation آن اجرا شود. *@
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private ProductGroupDto? group;
    private List<AttributeDto>? attributes;
    private CreateVariantDto newVariant = new();
    private bool isSavingVariant;
    private bool isUploading;
    private string? variantError;

    [Inject] private IFileStorageService FileStorage { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadGroup();
        attributes = (await CatalogService.GetAttributesAsync()).ToList();
    }

    private async Task LoadGroup()
    {
        group = await CatalogService.GetProductGroupAsync(Id);
    }

    private void OnAttributeSelected(int attributeId, object? value)
    {
        if (int.TryParse(value?.ToString(), out var valueId) && valueId > 0)
        {
            if (!newVariant.AttributeValueIds.Contains(valueId))
            {
                newVariant.AttributeValueIds.Add(valueId);
            }
        }
    }

    private async Task HandleAddVariant()
    {
        isSavingVariant = true;
        variantError = null;
        try
        {
            newVariant.ProductGroupId = Id;
            await CatalogService.AddVariantAsync(newVariant);
            await LoadGroup();
            newVariant = new();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در افزودن تنوع محصول برای گروه {ProductGroupId}", Id);
            variantError = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
        }
        finally
        {
            isSavingVariant = false;
        }
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        isUploading = true;
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024); // حداکثر ۵ مگابایت
            var url = await FileStorage.SaveFileAsync(stream, file.Name);
            await CatalogService.AddImageAsync(Id, url, isPrimary: group?.Images.Count == 0);
            await LoadGroup();
        }
        finally
        {
            isUploading = false;
        }
    }
}
