@* Dashboard.Web/Components/Pages/Profile.razor *@
@page "/profile"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using System.Security.Claims
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>پروفایل کاربری</PageTitle>

<h3>پروفایل کاربری</h3>

@if (Welcome is not null)
{
    <div class="alert alert-success">
        خوش آمدید! برای دسترسی کامل به امکانات، لطفاً پروفایل خود را تکمیل کنید.
    </div>
}

@if (Success is not null)
{
    <div class="alert alert-success">اطلاعات با موفقیت ذخیره شد.</div>
}

@if (Error is not null)
{
    <div class="alert alert-danger">@GetErrorMessage(Error)</div>
}

@if (profile is null)
{
    <p class="text-muted">در حال بارگذاری...</p>
}
else
{
    <div class="card-panel" style="max-width: 420px;">
        <form method="post" action="/Account/CompleteProfile" data-enhance="false">
            <AntiforgeryToken />

            <div class="mb-3">
                <label class="form-label">شماره موبایل</label>
                <input type="text" class="form-control" value="@profile.PhoneNumber" disabled />
            </div>

            <div class="mb-3">
                <label class="form-label">نام کامل</label>
                <input type="text" name="fullName" class="form-control" value="@profile.FullName" />
            </div>

            <div class="mb-3">
                <label class="form-label">ایمیل</label>
                <input type="email" name="email" class="form-control" value="@profile.Email" placeholder="ایمیل خود را وارد کنید" />
            </div>

            @if (!profile.HasPassword)
            {
                <div class="mb-3">
                    <label class="form-label">رمز عبور</label>
                    <input type="password" name="password" class="form-control" placeholder="حداقل ۳ کاراکتر" />
                </div>

                <div class="mb-4">
                    <label class="form-label">تکرار رمز عبور</label>
                    <input type="password" name="confirmPassword" class="form-control" />
                </div>
            }
            else
            {
                <div class="alert alert-info" style="font-size: 0.85rem;">
                    رمز عبور شما قبلاً تنظیم شده است.
                </div>
            }

            <button type="submit" class="btn btn-primary w-100">ذخیره تغییرات</button>
        </form>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "welcome")]
    private string? Welcome { get; set; }

    [SupplyParameterFromQuery(Name = "success")]
    private string? Success { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    private UserProfileDto? profile;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (userId is not null)
        {
            profile = await AuthService.GetProfileAsync(userId);
        }
    }

    private string GetErrorMessage(string code)
    {
        if (!Enum.TryParse<ProfileUpdateStatus>(code, out var status))
        {
            return "ذخیره اطلاعات ناموفق بود. لطفاً دوباره تلاش کنید.";
        }

        return status switch
        {
            ProfileUpdateStatus.PasswordMismatch => "رمز عبور و تکرار آن یکسان نیستند.",
            ProfileUpdateStatus.PasswordAlreadySet => "رمز عبور شما قبلاً تنظیم شده است.",
            ProfileUpdateStatus.EmailAlreadyExists => "این ایمیل قبلاً توسط کاربر دیگری استفاده شده است.",
            _ => "ذخیره اطلاعات ناموفق بود. لطفاً دوباره تلاش کنید."
        };
    }
}
