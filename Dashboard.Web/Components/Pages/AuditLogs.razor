@page "/audit-logs"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.AuditLogsView)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.Services
@using Dashboard.Application.Helpers
@inject IAuditService AuditService

<PageTitle>گزارش رویدادها</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">گزارش رویدادها</h3>
        <div class="text-body-secondary small">ثبت فعالیت‌های کاربران در سیستم</div>
    </div>
</div>

<div class="card-panel">
    <div class="mb-3">
        <input type="search" class="form-control" style="max-width: 320px;" placeholder="جست‌وجو در رویدادها..."
               value="@searchTerm" @oninput="OnSearchChanged" />
    </div>

    @if (logs is null)
    {
        <p class="text-body-secondary">در حال بارگذاری...</p>
    }
    else if (!logs.Any())
    {
        <div class="text-center text-body-secondary py-4">
            <i class="bi bi-journal-text fs-3 d-block mb-2"></i>
            <span class="small">رویدادی ثبت نشده است.</span>
        </div>
    }
    else
    {
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>تاریخ</th>
                    <th>نوع رویداد</th>
                    <th>کاربر</th>
                    <th>جزئیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in logs)
                {
                    <tr>
                        <td class="text-muted" style="white-space: nowrap;">@log.OccurredAt.ToPersianDateTime()</td>
                        <td><span class="badge bg-body-tertiary text-body border">@log.EventType</span></td>
                        <td>@(log.UserEmail ?? "-")</td>
                        <td class="text-muted">@log.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <Dashboard.Web.Components.Shared.Pager CurrentPage="currentPage" TotalPages="totalPages"
                                           TotalCount="totalCount" OnPageChanged="OnPageChanged" />
</div>

@code {
    private IEnumerable<AuditLog>? logs;

    private string searchTerm = string.Empty;
    private int currentPage = 1;
    private int totalPages;
    private int totalCount;
    private const int PageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
    }

    private async Task LoadLogs()
    {
        var result = await AuditService.GetEventsPagedAsync(currentPage, PageSize, searchTerm);
        logs = result.Items;
        totalPages = result.TotalPages;
        totalCount = result.TotalCount;
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        await LoadLogs();
    }

    private async Task OnPageChanged(int page)
    {
        currentPage = page;
        await LoadLogs();
    }
}