@page "/audit-logs"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Dashboard.Domain.Identity.Roles.Admin)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.Services
@inject IAuditService AuditService

<PageTitle>گزارش رویدادها</PageTitle>

<h3>گزارش رویدادها</h3>

<div class="card-panel">
    @if (logs is null)
    {
        <p class="text-muted">در حال بارگذاری...</p>
    }
    else if (!logs.Any())
    {
        <p class="text-muted text-center py-4">رویدادی ثبت نشده است.</p>
    }
    else
    {
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>تاریخ</th>
                    <th>نوع رویداد</th>
                    <th>کاربر</th>
                    <th>جزئیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in logs)
                {
                    <tr>
                        <td class="text-muted" style="white-space: nowrap;">@log.OccurredAt.ToString("yyyy/MM/dd HH:mm")</td>
                        <td><span class="badge bg-light text-dark">@log.EventType</span></td>
                        <td>@(log.UserEmail ?? "-")</td>
                        <td class="text-muted">@log.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private IEnumerable<AuditLog>? logs;

    protected override async Task OnInitializedAsync()
    {
        logs = await AuditService.GetRecentEventsAsync(100);
    }
}