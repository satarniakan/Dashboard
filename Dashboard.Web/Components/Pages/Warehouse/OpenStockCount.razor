@page "/warehouse/stock-counts/open"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.StockCountsManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using System.Security.Claims
@inject IStockService StockService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Dashboard.Web.Components.Pages.Warehouse.OpenStockCount> Logger
@inject Dashboard.Web.Services.ToastService ToastService
<PageTitle>شروع انبارگردانی جدید</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-1">شروع انبارگردانی جدید</h3>
        <div class="text-body-secondary small">انبار مورد نظر را انتخاب کنید تا شمارش موجودی آغاز شود.</div>
    </div>
    <a href="/warehouse/stock-counts" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-right me-1"></i>بازگشت به فهرست
    </a>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <EditForm Model="@model" OnValidSubmit="HandleValidSubmit" FormName="OpenStockCountForm">
            <DataAnnotationsValidator />

            @* ===== اطلاعات سند ===== *@
            <div class="card-panel mb-3">
                <h6 class="form-section-title"><i class="bi bi-clipboard-check"></i>اطلاعات سند</h6>

                <AppDropdown Label="انبار" @bind-Value="model.WarehouseId" Hint="موجودی فعلی همه‌ی کالاهای این انبار ثبت خواهد شد">
                    <option value="0">-- انتخاب کنید --</option>
                    @if (warehouses is not null)
                    {
                        @foreach (var w in warehouses)
                        {
                            <option value="@w.Id">@w.Name</option>
                        }
                    }
                </AppDropdown>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3 mb-0">
                    <i class="bi bi-exclamation-octagon me-1"></i>@errorMessage
                </div>
            }

            @* ===== نوار عملیات ===== *@
            <div class="card-panel form-actions mt-3 d-flex align-items-center gap-2">
                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg me-1"></i>
                    }
                    شروع انبارگردانی
                </button>
                <a href="/warehouse/stock-counts" class="btn btn-outline-secondary">انصراف</a>
            </div>
        </EditForm>
    </div>

    <div class="col-lg-4">
        @* ===== راهنما ===== *@
        <div class="card-panel tips-panel">
            <h6 class="form-section-title"><i class="bi bi-lightbulb"></i>راهنمای سریع</h6>
            <ul class="small text-body-secondary mb-0 ps-3">
                <li class="mb-2">با ثبت این فرم، موجودی سیستمی فعلی همه‌ی کالاهای این انبار «اسنپ‌شات» می‌شود.</li>
                <li class="mb-2">در مرحله‌ی بعد می‌توانید موجودی شمارش‌شده‌ی واقعی را وارد کنید.</li>
                <li>تا بسته‌شدن انبارگردانی، بهتر است تراکنش جدیدی در این انبار ثبت نشود.</li>
            </ul>
        </div>
    </div>
</div>

@code {
    private class OpenStockCountFormModel
    {
        [System.ComponentModel.DataAnnotations.Range(1, int.MaxValue,
            ErrorMessage = "انتخاب انبار الزامی است.")]
        public int WarehouseId { get; set; }
    }

    [SupplyParameterFromForm]
    private OpenStockCountFormModel model { get; set; } = new();

    private IEnumerable<WarehouseDto>? warehouses;

    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        warehouses = await StockService.GetWarehousesAsync();
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        string? userId = null;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? authState.User.Identity?.Name;

            var stockCount = await StockService.OpenStockCountAsync(model.WarehouseId, userId);
            ToastService.ShowSuccess("انبارگردانی باز شد.");
            NavigationManager.NavigateTo($"/warehouse/stock-counts/{stockCount.Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در شروع انبارگردانی توسط {UserId}", userId);
            errorMessage = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
            ToastService.ShowError(errorMessage);
        }
        finally
        {
            isSaving = false;
        }
    }
}
