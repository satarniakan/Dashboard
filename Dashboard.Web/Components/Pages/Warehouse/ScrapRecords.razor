@page "/warehouse/scrap"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.StockView)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using Dashboard.Application.Helpers
@inject IStockService StockService

<PageTitle>ضایعات</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">ضایعات</h3>
        <div class="text-body-secondary small">فهرست اسناد ضایعات ثبت‌شده</div>
    </div>
    <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.ScrapRecordsManage" Context="manageContext">
        <Authorized>
            <a href="/warehouse/scrap/add" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>ثبت ضایعات</a>
        </Authorized>
    </AuthorizeView>
</div>

<div class="card-panel">
    @if (records is null)
    {
        <p class="text-body-secondary">در حال بارگذاری...</p>
    }
    else if (!records.Any())
    {
        <div class="text-center text-body-secondary py-5">
            <i class="bi bi-trash3 d-block fs-1 mb-2"></i>
            هنوز موردی ثبت نشده است.
        </div>
    }
    else
    {
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>شماره سند</th>
                    <th>تاریخ</th>
                    <th>انبار</th>
                    <th>دلیل</th>
                    <th>تعداد اقلام</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in records)
                {
                    <tr>
                        <td class="fw-medium">@r.RecordNumber</td>
                        <td class="text-muted">@r.RecordDate.ToPersianDate()</td>
                        <td>@r.WarehouseName</td>
                        <td class="text-muted">@(r.Reason ?? "-")</td>
                        <td>@r.ItemCount</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private IEnumerable<ScrapRecordSummaryDto>? records;

    protected override async Task OnInitializedAsync()
    {
        records = await StockService.GetScrapRecordsAsync();
    }
}
