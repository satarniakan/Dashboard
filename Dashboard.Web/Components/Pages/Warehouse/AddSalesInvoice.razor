@page "/warehouse/sales/add"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.SalesCreate)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using Dashboard.Application.Helpers
@using System.Security.Claims
@inject ISalesService SalesService
@inject IStockService StockService
@inject IProductService ProductService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Dashboard.Web.Components.Pages.Warehouse.AddSalesInvoice> Logger
<PageTitle>فاکتور فروش جدید</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-1">فاکتور فروش جدید</h3>
        <div class="text-body-secondary small">فاکتور به‌صورت پیش‌نویس ثبت می‌شود؛ موجودی انبار پس از تأیید فاکتور کسر خواهد شد.</div>
    </div>
    <a href="/warehouse/sales" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-right me-1"></i>بازگشت به فهرست
    </a>
</div>

<EditForm Model="@model" OnValidSubmit="HandleValidSubmit" FormName="AddSalesInvoiceForm">
    <DataAnnotationsValidator />
    <ValidationSummary class="mb-3" />

    @* ===== اطلاعات سند ===== *@
    <div class="card-panel mb-3">
        <h6 class="form-section-title"><i class="bi bi-receipt"></i>اطلاعات سند</h6>

        <div class="row">
            <div class="col-md-6">
                <label class="form-label">مشتری</label>
                <CustomerSearchSelect Customers="customers ?? Enumerable.Empty<CustomerDto>()" @bind-Value="model.CustomerId" NoneLabel="-- مشتری حضوری --" />
                <div class="form-text">اختیاری — اگر انتخاب نشود، فاکتور به‌عنوان فروش حضوری ثبت می‌شود.</div>
            </div>
            <div class="col-md-6">
                <AppDropdown Label="انبار" @bind-Value="model.WarehouseId" Hint="موجودی از این انبار کسر می‌شود">
                    <option value="0">-- انتخاب کنید --</option>
                    @if (warehouses is not null)
                    {
                        @foreach (var w in warehouses)
                        {
                            <option value="@w.Id">@w.Name</option>
                        }
                    }
                </AppDropdown>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">تاریخ فاکتور</label>
                <PersianDateTimePicker TValue="DateTime" @bind-Value="model.InvoiceDate" ShowTime="true" />
            </div>
            <div class="col-md-4">
                <AppPriceField TValue="decimal" @bind-Value="model.DiscountAmount" Label="تخفیف (تومان)"
                               WrapperClass="" ShowWords="true" Hint="مبلغ تخفیف کلی روی فاکتور" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">توضیحات (اختیاری)</label>
            <InputTextArea class="form-control" rows="3" @bind-Value="model.Notes" />
        </div>
    </div>

    @* ===== اقلام فاکتور ===== *@
    <div class="card-panel mb-3">
        <h6 class="form-section-title"><i class="bi bi-basket"></i>اقلام فاکتور</h6>
        <div class="form-text mb-3">با انتخاب هر کالا، قیمت واحد به‌صورت خودکار از قیمت فعلی محصول پر می‌شود و می‌توانید آن را تغییر دهید.</div>

        <table class="table mb-2 align-middle">
            <thead>
                <tr>
                    <th style="width: 35%">کالا</th>
                    <th style="width: 15%">مقدار</th>
                    <th style="width: 20%">قیمت واحد</th>
                    <th style="width: 20%">جمع</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < model.Items.Count; i++)
                {
                    var row = model.Items[i];
                    <tr>
                        <td>
                            <select class="form-select" value="@row.ProductId" @onchange="e => OnProductSelected(row, e.Value)">
                                <option value="0">-- انتخاب کالا --</option>
                                @if (products is not null)
                                {
                                    @foreach (var p in products)
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                }
                            </select>
                        </td>
                        <td>
                            <input type="number" class="form-control" step="0.01" min="0" @bind="row.Quantity" />
                        </td>
                        <td>
                            <AppPriceField TValue="decimal" @bind-Value="row.UnitPrice" WrapperClass=""
                                           ShowWords="true" />
                        </td>
                        <td class="text-body-secondary">@CurrencyFormatter.ToToman(row.Quantity * row.UnitPrice)</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => model.Items.Remove(row)">حذف</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddRow">
            <i class="bi bi-plus-lg me-1"></i>افزودن ردیف
        </button>

        @if (model.Items.Any(i => i.Quantity > 0 && i.UnitPrice > 0))
        {
            <div class="bg-body-tertiary rounded p-3 mt-3">
                <div class="d-flex justify-content-between small">
                    <span class="text-body-secondary">جمع اقلام:</span>
                    <span>@CurrencyFormatter.ToToman(ItemsTotal)</span>
                </div>
                @if (model.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between small mt-1">
                        <span class="text-body-secondary">تخفیف:</span>
                        <span class="text-danger">−@CurrencyFormatter.ToToman(model.DiscountAmount)</span>
                    </div>
                }
                <div class="d-flex justify-content-between fw-bold mt-2">
                    <span>مبلغ نهایی:</span>
                    <span>@CurrencyFormatter.ToToman(NetTotal)</span>
                </div>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3 mb-0">
            <i class="bi bi-exclamation-octagon me-1"></i>@errorMessage
        </div>
    }

    @* ===== نوار عملیات ===== *@
    <div class="card-panel form-actions mt-3 d-flex align-items-center gap-2">
        <button type="submit" class="btn btn-primary" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            else
            {
                <i class="bi bi-check-lg me-1"></i>
            }
            ثبت پیش‌نویس فاکتور
        </button>
        <a href="/warehouse/sales" class="btn btn-outline-secondary">انصراف</a>
    </div>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private CreateSalesInvoiceDto model { get; set; } = new();

    private IEnumerable<ProductDto>? products;
    private IEnumerable<WarehouseDto>? warehouses;
    private IEnumerable<CustomerDto>? customers;

    private bool isSaving;
    private string? errorMessage;

    private decimal ItemsTotal => model.Items.Sum(i => i.Quantity * i.UnitPrice);
    private decimal NetTotal => ItemsTotal - model.DiscountAmount;

    protected override async Task OnInitializedAsync()
    {
        model.Items.Add(new SalesInvoiceItemInput());
        products = await ProductService.GetAllProductsAsync();
        warehouses = await StockService.GetWarehousesAsync();
        customers = await SalesService.GetCustomersAsync();
    }

    private void AddRow() => model.Items.Add(new SalesInvoiceItemInput());

    private void OnProductSelected(SalesInvoiceItemInput row, object? value)
    {
        if (int.TryParse(value?.ToString(), out var productId))
        {
            row.ProductId = productId;
            var product = products?.FirstOrDefault(p => p.Id == productId);
            if (product is not null)
            {
                row.UnitPrice = product.Price; // پیش‌فرض از قیمت فعلی محصول؛ کاربر می‌تواند تغییر دهد
            }
        }
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        string? userId = null;
        try
        {
            if (model.WarehouseId == 0)
            {
                errorMessage = "انتخاب انبار الزامی است.";
                return;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? authState.User.Identity?.Name;

            var invoiceId = await SalesService.CreateDraftInvoiceAsync(model, userId);
            NavigationManager.NavigateTo($"/warehouse/sales/{invoiceId}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ثبت فاکتور فروش توسط {UserId}", userId);
            errorMessage = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
        }
        finally
        {
            isSaving = false;
        }
    }
}
