@page "/warehouse/sales"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.SalesView)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using Dashboard.Application.Helpers
@inject ISalesService SalesService

<PageTitle>فاکتورهای فروش</PageTitle>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">فاکتورهای فروش</h3>
        <div class="text-body-secondary small">مشاهده و پیگیری فاکتورهای فروش ثبت‌شده</div>
    </div>
    <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.SalesCreate" Context="createContext">
        <Authorized>
            <a href="/warehouse/sales/add" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>فاکتور فروش جدید</a>
        </Authorized>
    </AuthorizeView>
</div>

<div class="card-panel">
    <div class="mb-3">
        <input type="search" class="form-control" style="max-width: 320px;" placeholder="جست‌وجو بر اساس شماره فاکتور یا نام مشتری..."
               value="@searchTerm" @oninput="OnSearchChanged" />
    </div>
    @if (invoices is null)
    {
        <LoadingSkeleton />
    }
    else if (!invoices.Any())
    {
        <div class="text-center text-body-secondary py-5">
            <i class="bi bi-receipt d-block fs-1 mb-2"></i>
            هنوز فاکتوری ثبت نشده است.
        </div>
    }
    else
    {
        <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>شماره فاکتور</th>
                    <th>تاریخ</th>
                    <th>مشتری</th>
                    <th>انبار</th>
                    <th>مبلغ کل</th>
                    <th>وضعیت</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inv in invoices)
                {
                    <tr>
                        <td class="fw-medium">@inv.InvoiceNumber</td>
                        <td class="text-muted">@inv.InvoiceDate.ToPersianDate()</td>
                        <td>@(inv.CustomerName ?? "مشتری حضوری")</td>
                        <td>@inv.WarehouseName</td>
                        <td>@CurrencyFormatter.ToToman(inv.TotalAmount)</td>
                        <td>@StatusBadge(inv.Status)</td>
                        <td class="text-end">
                            <a href="/warehouse/sales/@inv.Id" class="btn btn-sm btn-outline-primary">مشاهده</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }

    <Dashboard.Web.Components.Shared.Pager CurrentPage="currentPage" TotalPages="totalPages"
                                            TotalCount="totalCount" OnPageChanged="OnPageChanged" />
</div>

@code {
    private IEnumerable<SalesInvoiceSummaryDto>? invoices;

    private string searchTerm = string.Empty;
    private int currentPage = 1;
    private int totalPages;
    private int totalCount;
    private const int PageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        await LoadInvoices();
    }

    private async Task LoadInvoices()
    {
        var result = await SalesService.GetInvoicesPagedAsync(currentPage, PageSize, searchTerm);
        invoices = result.Items;
        totalPages = result.TotalPages;
        totalCount = result.TotalCount;
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        await LoadInvoices();
    }

    private async Task OnPageChanged(int page)
    {
        currentPage = page;
        await LoadInvoices();
    }

    private RenderFragment StatusBadge(string status) => builder =>
    {
        var (cssClass, label) = status switch
        {
            "Draft" => ("bg-warning-subtle text-warning", "پیش‌نویس"),
            "Confirmed" => ("bg-success-subtle text-success", "تأییدشده"),
            "Canceled" => ("bg-danger-subtle text-danger", "لغوشده"),
            _ => ("bg-secondary-subtle text-secondary", status)
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge {cssClass}");
        builder.AddContent(2, label);
        builder.CloseElement();
    };
}