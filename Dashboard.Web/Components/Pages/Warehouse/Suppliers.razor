@page "/warehouse/suppliers"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.SuppliersManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@inject IStockService StockService

<PageTitle>تأمین‌کنندگان</PageTitle>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">تأمین‌کنندگان</h3>
        <div class="text-body-secondary small">فهرست تأمین‌کنندگان ثبت‌شده در سیستم</div>
    </div>
    <a href="/warehouse/suppliers/add" class="btn btn-primary btn-sm">+ افزودن تأمین‌کننده</a>
</div>

<div class="card-panel">
    @if (suppliers is null)
    {
        <LoadingSkeleton />
    }
    else if (!suppliers.Any())
    {
        <div class="text-center text-body-secondary py-5">
            <i class="bi bi-inbox d-block mb-2" style="font-size: 2rem;"></i>
            هنوز تأمین‌کننده‌ای ثبت نشده است.
        </div>
    }
    else
    {
        <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>نام</th>
                    <th>شخص رابط</th>
                    <th>تلفن</th>
                    <th>آدرس</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var supplier in suppliers)
                {
                    <tr>
                        <td class="fw-medium">@supplier.Name</td>
                        <td class="text-muted">@(supplier.ContactPerson ?? "-")</td>
                        <td class="text-muted">@(supplier.Phone ?? "-")</td>
                        <td class="text-muted">@(supplier.Address ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@code {
    private IEnumerable<SupplierDto>? suppliers;

    protected override async Task OnInitializedAsync()
    {
        suppliers = await StockService.GetSuppliersAsync();
    }
}
