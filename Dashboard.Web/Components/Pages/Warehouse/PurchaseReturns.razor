@page "/warehouse/purchase-returns"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.StockView)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using Dashboard.Application.Helpers
@inject IStockService StockService

<PageTitle>برگشت خرید</PageTitle>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">برگشت خرید</h3>
        <div class="text-body-secondary small">فهرست برگشت‌های کالا به تأمین‌کنندگان</div>
    </div>
    <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.PurchaseReceiptsManage" Context="manageContext">
        <Authorized>
            <a href="/warehouse/purchase-returns/add" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>ثبت برگشت خرید</a>
        </Authorized>
    </AuthorizeView>
</div>

<div class="card-panel">
    @if (returns is null)
    {
        <LoadingSkeleton />
    }
    else if (!returns.Any())
    {
        <div class="text-center text-body-secondary py-5">
            <i class="bi bi-box-arrow-up d-block fs-1 mb-2"></i>
            هنوز موردی ثبت نشده است.
        </div>
    }
    else
    {
        <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>شماره</th>
                    <th>تاریخ</th>
                    <th>انبار</th>
                    <th>ارجاع تأمین‌کننده</th>
                    <th>تعداد اقلام</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in returns)
                {
                    <tr>
                        <td class="fw-medium">@r.ReturnNumber</td>
                        <td class="text-muted">@r.ReturnDate.ToPersianDate()</td>
                        <td>@r.WarehouseName</td>
                        <td class="text-muted">@(r.SupplierReference ?? "-")</td>
                        <td>@r.ItemCount</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@code {
    private IEnumerable<PurchaseReturnSummaryDto>? returns;

    protected override async Task OnInitializedAsync()
    {
        returns = await StockService.GetPurchaseReturnsAsync();
    }
}
