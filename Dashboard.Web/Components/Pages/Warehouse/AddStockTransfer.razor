@page "/warehouse/transfers/add"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.StockTransfersManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using System.Security.Claims
@inject IStockService StockService
@inject IProductService ProductService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Dashboard.Web.Components.Pages.Warehouse.AddStockTransfer> Logger
@inject Dashboard.Web.Services.ToastService ToastService
<PageTitle>ثبت انتقال بین انبار</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-1">ثبت انتقال بین انبار</h3>
        <div class="text-body-secondary small">انتقال کالا از یک انبار به انبار دیگر را ثبت کنید؛ انتخاب انبار مبدأ و مقصد الزامی است.</div>
    </div>
    <a href="/warehouse/transfers" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-right me-1"></i>بازگشت به فهرست
    </a>
</div>

<EditForm Model="@model" OnValidSubmit="HandleValidSubmit" FormName="AddStockTransferForm">
    <DataAnnotationsValidator />

    <div class="row g-3">
        <div class="col-lg-8">

            @* ===== انبارها و تاریخ ===== *@
            <div class="card-panel mb-3">
                <h6 class="form-section-title"><i class="bi bi-arrow-left-right"></i>انبار مبدأ و مقصد</h6>

                <div class="row">
                    <div class="col-md-6">
                        <AppDropdown TValue="int" Label="انبار مبدأ" @bind-Value="model.SourceWarehouseId"
                                    Hint="کالا از این انبار خارج می‌شود.">
                            <option value="0">-- انتخاب کنید --</option>
                            @if (warehouses is not null)
                            {
                                @foreach (var w in warehouses)
                                {
                                    <option value="@w.Id">@w.Name</option>
                                }
                            }
                        </AppDropdown>
                    </div>
                    <div class="col-md-6">
                        <AppDropdown TValue="int" Label="انبار مقصد" @bind-Value="model.DestinationWarehouseId"
                                    Hint="کالا به این انبار وارد می‌شود.">
                            <option value="0">-- انتخاب کنید --</option>
                            @if (warehouses is not null)
                            {
                                @foreach (var w in warehouses)
                                {
                                    <option value="@w.Id">@w.Name</option>
                                }
                            }
                        </AppDropdown>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">تاریخ</label>
                            <PersianDateTimePicker TValue="DateTime" @bind-Value="model.TransferDate" ShowTime="true" />
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">توضیحات (اختیاری)</label>
                    <InputTextArea class="form-control" @bind-Value="model.Notes" />
                    <ValidationMessage For="() => model.Notes" class="text-danger small mt-1 d-block" />
                </div>
            </div>

            @* ===== اقلام انتقالی ===== *@
            <div class="card-panel mb-3">
                <h6 class="form-section-title"><i class="bi bi-box-seam"></i>اقلام انتقالی</h6>
                <div class="form-text mb-2">برای هر ردیف، کالا و مقدار منتقل‌شده را انتخاب کنید؛ مقدار از موجودی انبار مبدأ کسر و به انبار مقصد اضافه می‌شود.</div>

                <StockItemRowsEditor Items="model.Items" Products="@(products ?? Enumerable.Empty<ProductDto>())" />
                <ValidationMessage For="() => model.Items" class="text-danger small mt-1 d-block" />
            </div>
        </div>

        <div class="col-lg-4">

            @* ===== راهنما ===== *@
            <div class="card-panel tips-panel">
                <h6 class="form-section-title"><i class="bi bi-lightbulb"></i>راهنمای سریع</h6>
                <ul class="small text-body-secondary mb-0 ps-3">
                    <li class="mb-2">انتخاب انبار مبدأ و مقصد الزامی است و نباید یکسان باشند.</li>
                    <li class="mb-2">مقدار انتقال نباید از موجودی انبار مبدأ بیشتر باشد.</li>
                    <li>با دکمه‌ی «افزودن ردیف» می‌توانید چند کالا را هم‌زمان منتقل کنید.</li>
                </ul>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3 mb-0">
            <i class="bi bi-exclamation-octagon me-1"></i>@errorMessage
        </div>
    }

    @* ===== نوار عملیات ===== *@
    <div class="card-panel form-actions mt-3 d-flex align-items-center gap-2">
        <button type="submit" class="btn btn-primary" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            else
            {
                <i class="bi bi-check-lg me-1"></i>
            }
            ثبت انتقال
        </button>
        <a href="/warehouse/transfers" class="btn btn-outline-secondary">انصراف</a>
    </div>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private CreateStockTransferDto model { get; set; } = new();

    private IEnumerable<ProductDto>? products;
    private IEnumerable<WarehouseDto>? warehouses;

    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        model.Items.Add(new StockItemInput());
        warehouses = await StockService.GetWarehousesAsync();
        products = await ProductService.GetAllProductsAsync();
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        string? userId = null;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? authState.User.Identity?.Name;

            await StockService.RegisterStockTransferAsync(model, userId);
            ToastService.ShowSuccess("انتقال بین انبار ثبت شد.");
            NavigationManager.NavigateTo("/warehouse/transfers");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ثبت انتقال بین انبار توسط {UserId}", userId);
            errorMessage = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
            ToastService.ShowError(errorMessage);
        }
        finally
        {
            isSaving = false;
        }
    }
}
