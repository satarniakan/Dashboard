@page "/warehouse/purchase-receipts/add"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.PurchaseReceiptsManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using System.Security.Claims
@using Dashboard.Web.Components.Shared
@inject IStockService StockService
@inject IProductService ProductService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Dashboard.Web.Components.Pages.Warehouse.AddPurchaseReceipt> Logger
@inject Dashboard.Web.Services.ToastService ToastService
<PageTitle>ثبت رسید خرید</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-1">ثبت رسید خرید</h3>
        <div class="text-body-secondary small">رسید ورود کالا به انبار را ثبت کنید؛ اقلام رسید در پایین فرم اضافه می‌شوند.</div>
    </div>
    <a href="/warehouse/purchase-receipts" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-right me-1"></i>بازگشت به فهرست
    </a>
</div>

<EditForm Model="@model" OnValidSubmit="HandleValidSubmit" FormName="AddPurchaseReceiptForm">
    <DataAnnotationsValidator />

    @* ===== اطلاعات سند ===== *@
    <div class="card-panel mb-3">
        <h6 class="form-section-title"><i class="bi bi-truck"></i>اطلاعات سند</h6>

        <div class="row">
            <div class="col-md-6">
                <AppDropdown Label="تأمین‌کننده" @bind-Value="model.SupplierId" Hint="تأمین‌کننده‌ی این خرید">
                    <option value="0">-- انتخاب کنید --</option>
                    @if (suppliers is not null)
                    {
                        @foreach (var s in suppliers)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    }
                </AppDropdown>
            </div>
            <div class="col-md-6">
                <AppDropdown Label="انبار مقصد" @bind-Value="model.WarehouseId" Hint="کالاهای رسیده به این انبار اضافه می‌شوند">
                    <option value="0">-- انتخاب کنید --</option>
                    @if (warehouses is not null)
                    {
                        @foreach (var w in warehouses)
                        {
                            <option value="@w.Id">@w.Name</option>
                        }
                    }
                </AppDropdown>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">تاریخ رسید</label>
                <PersianDateTimePicker TValue="DateTime" @bind-Value="model.ReceiptDate" ShowTime="true" />
            </div>
        </div>

        <AppTextArea @bind-Value="model.Notes" Label="توضیحات (اختیاری)" Rows="3"
                     WrapperClass="mb-3" ShowCount="true" />
    </div>

    @* ===== اقلام رسید ===== *@
    <div class="card-panel mb-3">
        <h6 class="form-section-title"><i class="bi bi-box-seam"></i>اقلام رسید</h6>
        <div class="form-text mb-3">برای هر ردیف، کالا و مقدار را انتخاب کنید و بهای تمام‌شده‌ی واحد را وارد نمایید.</div>

        <table class="table mb-2 align-middle">
            <thead>
                <tr>
                    <th style="width: 45%">کالا</th>
                    <th style="width: 20%">مقدار</th>
                    <th style="width: 25%">بهای تمام‌شده واحد</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < model.Items.Count; i++)
                {
                    var row = model.Items[i];
                    <tr>
                        <td>
                            <select class="form-select" @bind="row.ProductId">
                                <option value="0">-- انتخاب کالا --</option>
                                @if (products is not null)
                                {
                                    @foreach (var p in products)
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                }
                            </select>
                        </td>
                        <td>
                            <input type="number" class="form-control" step="0.01" min="0" @bind="row.Quantity" />
                        </td>
                        <td>
                            <AppPriceField TValue="decimal" @bind-Value="row.UnitCost" WrapperClass=""
                                           ShowWords="true" />
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => model.Items.Remove(row)">حذف</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddRow">
            <i class="bi bi-plus-lg me-1"></i>افزودن ردیف
        </button>

        <ValidationMessage For="() => model.Items" class="text-danger small mt-1 d-block" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3 mb-0">
            <i class="bi bi-exclamation-octagon me-1"></i>@errorMessage
        </div>
    }

    @* ===== نوار عملیات ===== *@
    <div class="card-panel form-actions mt-3 d-flex align-items-center gap-2">
        <button type="submit" class="btn btn-primary" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            else
            {
                <i class="bi bi-check-lg me-1"></i>
            }
            ثبت رسید
        </button>
        <a href="/warehouse/purchase-receipts" class="btn btn-outline-secondary">انصراف</a>
    </div>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private CreatePurchaseReceiptDto? _model { get; set; }

    private CreatePurchaseReceiptDto model => _model ??= new();

    private IEnumerable<ProductDto>? products;
    private IEnumerable<WarehouseDto>? warehouses;
    private IEnumerable<SupplierDto>? suppliers;

    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        model.Items.Add(new PurchaseReceiptItemInput());
        warehouses = await StockService.GetWarehousesAsync();
        suppliers = await StockService.GetSuppliersAsync();
        products = await ProductService.GetAllProductsAsync();
    }

    private void AddRow() => model.Items.Add(new PurchaseReceiptItemInput());

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        string? userId = null;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? authState.User.Identity?.Name;

            await StockService.RegisterPurchaseReceiptAsync(model, userId);
            ToastService.ShowSuccess("رسید خرید با موفقیت ثبت شد.");
            NavigationManager.NavigateTo("/warehouse/purchase-receipts");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ثبت رسید خرید توسط {UserId}", userId);
            errorMessage = ErrorMessageHelper.ToUserMessage(ex);
            ToastService.ShowError(errorMessage);
        }
        finally
        {
            isSaving = false;
        }
    }
}
