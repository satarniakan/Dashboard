@page "/warehouse/warehouses"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.WarehousesManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@inject IStockService StockService

<PageTitle>انبارها</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">انبارها</h3>
        <div class="text-body-secondary small">فهرست انبارهای ثبت‌شده در سیستم</div>
    </div>
    <a href="/warehouse/warehouses/add" class="btn btn-primary btn-sm">+ افزودن انبار</a>
</div>

<div class="card-panel">
    @if (warehouses is null)
    {
        <p class="text-body-secondary">در حال بارگذاری...</p>
    }
    else if (!warehouses.Any())
    {
        <div class="text-center text-body-secondary py-5">
            <i class="bi bi-inbox d-block mb-2" style="font-size: 2rem;"></i>
            هنوز انباری ثبت نشده است.
        </div>
    }
    else
    {
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>نام</th>
                    <th>کد</th>
                    <th>آدرس</th>
                    <th>وضعیت</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var warehouse in warehouses)
                {
                    <tr>
                        <td class="fw-medium">@warehouse.Name</td>
                        <td class="text-muted">@(warehouse.Code ?? "-")</td>
                        <td class="text-muted">@(warehouse.Address ?? "-")</td>
                        <td>
                            @if (warehouse.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success-emphasis">فعال</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">غیرفعال</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private IEnumerable<WarehouseDto>? warehouses;

    protected override async Task OnInitializedAsync()
    {
        warehouses = await StockService.GetWarehousesAsync();
    }
}
