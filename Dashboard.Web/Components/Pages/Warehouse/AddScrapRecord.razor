@page "/warehouse/scrap/add"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.ScrapRecordsManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using System.Security.Claims
@inject IStockService StockService
@inject IProductService ProductService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>ثبت ضایعات</PageTitle>

<h3>ثبت ضایعات</h3>

<div class="card-panel" style="max-width: 680px;">
    <EditForm Model="@model" OnValidSubmit="HandleValidSubmit" FormName="AddScrapRecordForm">
        <DataAnnotationsValidator />
        <ValidationSummary class="mb-3" />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">انبار</label>
                <select class="form-select" @bind="model.WarehouseId">
                    <option value="0">-- انتخاب کنید --</option>
                    @if (warehouses is not null)
                    {
                        @foreach (var w in warehouses)
                        {
                            <option value="@w.Id">@w.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">شماره سند</label>
                <InputText class="form-control" @bind-Value="model.RecordNumber" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">تاریخ</label>
                <InputDate class="form-control" @bind-Value="model.RecordDate" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">دلیل (اختیاری)</label>
                <InputText class="form-control" @bind-Value="model.Reason" placeholder="مثلاً: آسیب‌دیدگی، انقضا" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">توضیحات (اختیاری)</label>
            <InputTextArea class="form-control" @bind-Value="model.Notes" />
        </div>

        <hr />
        <h6 class="mb-3">اقلام ضایعاتی</h6>

        <StockItemRowsEditor Items="model.Items" Products="@(products ?? Enumerable.Empty<ProductDto>())" />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3">@errorMessage</div>
        }

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                @(isSaving ? "در حال ذخیره..." : "ثبت ضایعات")
            </button>
            <a href="/warehouse/scrap" class="btn btn-outline-secondary">انصراف</a>
        </div>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    private CreateScrapRecordDto model { get; set; } = new();

    private IEnumerable<ProductDto>? products;
    private IEnumerable<WarehouseDto>? warehouses;

    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        model.Items.Add(new StockItemInput());
        warehouses = await StockService.GetWarehousesAsync();
        products = await ProductService.GetAllProductsAsync();
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            if (model.WarehouseId == 0)
            {
                errorMessage = "انتخاب انبار الزامی است.";
                return;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? authState.User.Identity?.Name;

            await StockService.RegisterScrapAsync(model, userId);
            NavigationManager.NavigateTo("/warehouse/scrap");
        }
        catch (Exception ex)
        {
            errorMessage = $"ثبت ضایعات ناموفق بود: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
