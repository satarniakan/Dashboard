@page "/warehouse/internal-issues"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.StockView)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using Dashboard.Application.Helpers
@inject IStockService StockService

<PageTitle>حواله‌های مصرف داخلی</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">حواله‌های مصرف داخلی</h3>
        <div class="text-body-secondary small">فهرست حواله‌های مصرف داخلی ثبت‌شده</div>
    </div>
    <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.InternalIssuesManage" Context="manageContext">
        <Authorized>
            <a href="/warehouse/internal-issues/add" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>ثبت حواله جدید</a>
        </Authorized>
    </AuthorizeView>
</div>

<div class="card-panel">
    @if (issues is null)
    {
        <p class="text-body-secondary">در حال بارگذاری...</p>
    }
    else if (!issues.Any())
    {
        <div class="text-center text-body-secondary py-5">
            <i class="bi bi-tools d-block fs-1 mb-2"></i>
            هنوز حواله‌ای ثبت نشده است.
        </div>
    }
    else
    {
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>شماره حواله</th>
                    <th>تاریخ</th>
                    <th>انبار</th>
                    <th>هدف مصرف</th>
                    <th>تعداد اقلام</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in issues)
                {
                    <tr>
                        <td class="fw-medium">@i.IssueNumber</td>
                        <td class="text-muted">@i.IssueDate.ToPersianDate()</td>
                        <td>@i.WarehouseName</td>
                        <td class="text-muted">@(i.Purpose ?? "-")</td>
                        <td>@i.ItemCount</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private IEnumerable<InternalIssueSummaryDto>? issues;

    protected override async Task OnInitializedAsync()
    {
        issues = await StockService.GetInternalIssuesAsync();
    }
}
