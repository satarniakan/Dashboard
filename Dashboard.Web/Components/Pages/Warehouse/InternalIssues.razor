@page "/warehouse/internal-issues"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.StockView)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@inject IStockService StockService

<PageTitle>حواله‌های مصرف داخلی</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">حواله‌های مصرف داخلی</h3>
    <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.InternalIssuesManage" Context="manageContext">
        <Authorized>
            <a href="/warehouse/internal-issues/add" class="btn btn-primary">+ ثبت حواله جدید</a>
        </Authorized>
    </AuthorizeView>
</div>

<div class="card-panel">
    @if (issues is null)
    {
        <p class="text-muted">در حال بارگذاری...</p>
    }
    else if (!issues.Any())
    {
        <p class="text-muted text-center py-4">هنوز حواله‌ای ثبت نشده است.</p>
    }
    else
    {
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>شماره حواله</th>
                    <th>تاریخ</th>
                    <th>انبار</th>
                    <th>هدف مصرف</th>
                    <th>تعداد اقلام</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in issues)
                {
                    <tr>
                        <td class="fw-medium">@i.IssueNumber</td>
                        <td class="text-muted">@i.IssueDate.ToString("yyyy/MM/dd")</td>
                        <td>@i.WarehouseName</td>
                        <td class="text-muted">@(i.Purpose ?? "-")</td>
                        <td>@i.ItemCount</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private IEnumerable<InternalIssueSummaryDto>? issues;

    protected override async Task OnInitializedAsync()
    {
        issues = await StockService.GetInternalIssuesAsync();
    }
}
