@page "/warehouse/customers"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.CustomersManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@inject ISalesService SalesService

<PageTitle>مشتریان</PageTitle>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">مشتریان</h3>
        <div class="text-body-secondary small">فهرست مشتریان ثبت‌شده در سیستم</div>
    </div>
    <a href="/warehouse/customers/add" class="btn btn-primary btn-sm">+ افزودن مشتری</a>
</div>

<div class="card-panel">
    @if (customers is null)
    {
        <LoadingSkeleton />
    }
    else if (!customers.Any())
    {
        <div class="text-center text-body-secondary py-5">
            <i class="bi bi-inbox d-block mb-2" style="font-size: 2rem;"></i>
            هنوز مشتری‌ای ثبت نشده است.
        </div>
    }
    else
    {
        <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>نام</th>
                    <th>تلفن</th>
                    <th>آدرس</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in customers)
                {
                    <tr>
                        <td class="fw-medium">@c.Name</td>
                        <td class="text-muted">@(c.Phone ?? "-")</td>
                        <td class="text-muted">@(c.Address ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@code {
    private IEnumerable<CustomerDto>? customers;

    protected override async Task OnInitializedAsync()
    {
        customers = await SalesService.GetCustomersAsync();
    }
}