@page "/warehouse/customers"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.CustomersManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@inject ISalesService SalesService

<PageTitle>مشتریان</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">مشتریان</h3>
    <a href="/warehouse/customers/add" class="btn btn-primary">+ افزودن مشتری</a>
</div>

<div class="card-panel">
    @if (customers is null)
    {
        <p class="text-muted">در حال بارگذاری...</p>
    }
    else if (!customers.Any())
    {
        <p class="text-muted text-center py-4">هنوز مشتری‌ای ثبت نشده است.</p>
    }
    else
    {
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>نام</th>
                    <th>تلفن</th>
                    <th>آدرس</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in customers)
                {
                    <tr>
                        <td class="fw-medium">@c.Name</td>
                        <td class="text-muted">@(c.Phone ?? "-")</td>
                        <td class="text-muted">@(c.Address ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private IEnumerable<CustomerDto>? customers;

    protected override async Task OnInitializedAsync()
    {
        customers = await SalesService.GetCustomersAsync();
    }
}