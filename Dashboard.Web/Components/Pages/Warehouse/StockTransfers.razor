@page "/warehouse/transfers"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.StockView)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@inject IStockService StockService

<PageTitle>انتقال بین انبار</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">انتقال بین انبار</h3>
    <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.StockTransfersManage" Context="manageContext">
        <Authorized>
            <a href="/warehouse/transfers/add" class="btn btn-primary">+ ثبت انتقال</a>
        </Authorized>
    </AuthorizeView>
</div>

<div class="card-panel">
    @if (transfers is null)
    {
        <p class="text-muted">در حال بارگذاری...</p>
    }
    else if (!transfers.Any())
    {
        <p class="text-muted text-center py-4">هنوز انتقالی ثبت نشده است.</p>
    }
    else
    {
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>شماره</th>
                    <th>تاریخ</th>
                    <th>از انبار</th>
                    <th>به انبار</th>
                    <th>وضعیت</th>
                    <th>تعداد اقلام</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in transfers)
                {
                    <tr>
                        <td class="fw-medium">@t.TransferNumber</td>
                        <td class="text-muted">@t.TransferDate.ToString("yyyy/MM/dd")</td>
                        <td>@t.SourceWarehouseName</td>
                        <td>@t.DestinationWarehouseName</td>
                        <td><span class="badge bg-light text-dark">@t.Status</span></td>
                        <td>@t.ItemCount</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private IEnumerable<StockTransferSummaryDto>? transfers;

    protected override async Task OnInitializedAsync()
    {
        transfers = await StockService.GetStockTransfersAsync();
    }
}
