@page "/warehouse/transfers"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.StockView)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using Dashboard.Application.Helpers
@inject IStockService StockService

<PageTitle>انتقال بین انبار</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">انتقال بین انبار</h3>
        <div class="text-body-secondary small">انتقال کالا بین انبارها</div>
    </div>
    <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.StockTransfersManage" Context="manageContext">
        <Authorized>
            <a href="/warehouse/transfers/add" class="btn btn-primary btn-sm">+ ثبت انتقال</a>
        </Authorized>
    </AuthorizeView>
</div>

<div class="card-panel">
    @if (transfers is null)
    {
        <p class="text-body-secondary">در حال بارگذاری...</p>
    }
    else if (!transfers.Any())
    {
        <div class="text-center text-body-secondary py-5">
            <i class="bi bi-inbox d-block mb-2" style="font-size: 2rem;"></i>
            هنوز انتقالی ثبت نشده است.
        </div>
    }
    else
    {
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>شماره</th>
                    <th>تاریخ</th>
                    <th>از انبار</th>
                    <th>به انبار</th>
                    <th>وضعیت</th>
                    <th>تعداد اقلام</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in transfers)
                {
                    <tr>
                        <td class="fw-medium">@t.TransferNumber</td>
                        <td class="text-muted">@t.TransferDate.ToPersianDate()</td>
                        <td>@t.SourceWarehouseName</td>
                        <td>@t.DestinationWarehouseName</td>
                        <td><span class="badge bg-body-tertiary text-body border">@t.Status</span></td>
                        <td>@t.ItemCount</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private IEnumerable<StockTransferSummaryDto>? transfers;

    protected override async Task OnInitializedAsync()
    {
        transfers = await StockService.GetStockTransfersAsync();
    }
}
