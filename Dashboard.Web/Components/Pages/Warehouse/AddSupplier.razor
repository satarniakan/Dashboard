@page "/warehouse/suppliers/add"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.SuppliersManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@inject IStockService StockService
@inject NavigationManager NavigationManager
@inject ILogger<Dashboard.Web.Components.Pages.Warehouse.AddSupplier> Logger
@inject Dashboard.Web.Services.ToastService ToastService
<PageTitle>افزودن تأمین‌کننده</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-1">افزودن تأمین‌کننده</h3>
        <div class="text-body-secondary small">اطلاعات تأمین‌کننده جدید را وارد کنید؛ نام تأمین‌کننده الزامی است.</div>
    </div>
    <a href="/warehouse/suppliers" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-right me-1"></i>بازگشت به فهرست
    </a>
</div>

<EditForm Model="@model" OnValidSubmit="HandleValidSubmit" FormName="AddSupplierForm">
    <DataAnnotationsValidator />

    <div class="row g-3">
        <div class="col-lg-8">

            @* ===== اطلاعات تأمین‌کننده ===== *@
            <div class="card-panel mb-3">
                <h6 class="form-section-title"><i class="bi bi-truck"></i>اطلاعات تأمین‌کننده</h6>

                <AppTextField @bind-Value="model.Name" Label="نام تأمین‌کننده"
                              Placeholder="مثلاً: گلخانه‌های مرکزی" />

                <div class="row">
                    <div class="col-md-6">
                        <AppTextField @bind-Value="model.ContactPerson" Label="شخص رابط (اختیاری)"
                                      Placeholder="نام فرد رابط" />
                    </div>
                    <div class="col-md-6">
                        <AppTextField @bind-Value="model.Phone" Label="تلفن (اختیاری)"
                                      Placeholder="مثلاً: ۰۲۱۸۸۸۸۰۰۰۰" />
                    </div>
                </div>

                <AppTextField @bind-Value="model.Address" Label="آدرس (اختیاری)"
                              Placeholder="مثلاً: تهران، بازار گل‌ها" />
            </div>
        </div>

        <div class="col-lg-4">

            @* ===== راهنما ===== *@
            <div class="card-panel tips-panel">
                <h6 class="form-section-title"><i class="bi bi-lightbulb"></i>راهنمای سریع</h6>
                <ul class="small text-body-secondary mb-0 ps-3">
                    <li class="mb-2">نام تأمین‌کننده در رسیدهای خرید نمایش داده می‌شود.</li>
                    <li>ثبت شخص رابط کمک می‌کند تماس‌های بعدی سریع‌تر انجام شود.</li>
                </ul>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3 mb-0">
            <i class="bi bi-exclamation-octagon me-1"></i>@errorMessage
        </div>
    }

    @* ===== نوار عملیات ===== *@
    <div class="card-panel form-actions mt-3 d-flex align-items-center gap-2">
        <button type="submit" class="btn btn-primary" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            else
            {
                <i class="bi bi-check-lg me-1"></i>
            }
            ذخیره تأمین‌کننده
        </button>
        <a href="/warehouse/suppliers" class="btn btn-outline-secondary">انصراف</a>
    </div>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private CreateSupplierDto? _model { get; set; }

    private CreateSupplierDto model => _model ??= new();

    private bool isSaving;
    private string? errorMessage;

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            await StockService.CreateSupplierAsync(model);
            ToastService.ShowSuccess("تأمین‌کننده با موفقیت ثبت شد.");
            NavigationManager.NavigateTo("/warehouse/suppliers");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ذخیره تأمین‌کننده");
            errorMessage = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
            ToastService.ShowError(errorMessage);
        }
        finally
        {
            isSaving = false;
        }
    }
}
