@page "/warehouse/stock"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.StockView)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@inject IStockService StockService

<PageTitle>موجودی کالاها</PageTitle>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">موجودی کالاها</h3>
        <div class="text-body-secondary small">موجودی فعلی کالاها به تفکیک انبار</div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <label class="form-label mb-0">انبار:</label>
        <select class="form-select" style="width: auto;" @bind="selectedWarehouseId" @bind:after="LoadStockAsync">
            <option value="0">همه‌ی انبارها</option>
            @if (warehouses is not null)
            {
                @foreach (var warehouse in warehouses)
                {
                    <option value="@warehouse.Id">@warehouse.Name</option>
                }
            }
        </select>
        <div class="form-check ms-3">
            <input class="form-check-input" type="checkbox" id="lowStockOnly" @bind="lowStockOnly" @bind:after="LoadStockAsync" />
            <label class="form-check-label" for="lowStockOnly">فقط کالاهای زیر نقطه سفارش</label>
        </div>
    </div>
</div>

<div class="card-panel">
    @if (stockLevels is null)
    {
        <LoadingSkeleton />
    }
    else if (!stockLevels.Any())
    {
        <div class="text-center text-body-secondary py-5">
            <i class="bi bi-inbox d-block mb-2" style="font-size: 2rem;"></i>
            موردی یافت نشد.
        </div>
    }
    else
    {
        <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>کد کالا</th>
                    <th>نام کالا</th>
                    <th>انبار</th>
                    <th>موجودی</th>
                    <th>نقطه سفارش</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var level in stockLevels)
                {
                    var isLow = level.QuantityOnHand < level.ReorderPoint;
                    <tr class="@(isLow ? "table-danger" : "")">
                        <td class="text-muted">@level.Sku</td>
                        <td class="fw-medium">@level.ProductName</td>
                        <td>@level.WarehouseName</td>
                        <td>@level.QuantityOnHand</td>
                        <td>@level.ReorderPoint</td>
                        <td>
                            @if (isLow)
                            {
                                <span class="badge bg-danger-subtle text-danger-emphasis">زیر نقطه سفارش</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@code {
    private IEnumerable<WarehouseDto>? warehouses;
    private IEnumerable<StockLevelDto>? stockLevels;
    private int selectedWarehouseId;
    private bool lowStockOnly;

    protected override async Task OnInitializedAsync()
    {
        warehouses = await StockService.GetWarehousesAsync();
        await LoadStockAsync();
    }

    private async Task LoadStockAsync()
    {
        if (lowStockOnly)
        {
            var lowStock = await StockService.GetLowStockAsync();
            stockLevels = selectedWarehouseId == 0
                ? lowStock
                : lowStock.Where(l => l.WarehouseId == selectedWarehouseId);
        }
        else
        {
            stockLevels = await StockService.GetStockLevelsAsync(selectedWarehouseId == 0 ? null : selectedWarehouseId);
        }
    }
}
