@page "/warehouse/warehouses/add"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.WarehousesManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@inject IStockService StockService
@inject NavigationManager NavigationManager
@inject ILogger<Dashboard.Web.Components.Pages.Warehouse.AddWarehouse> Logger
@inject Dashboard.Web.Services.ToastService ToastService
<PageTitle>افزودن انبار</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-1">افزودن انبار</h3>
        <div class="text-body-secondary small">اطلاعات انبار جدید را وارد کنید؛ نام انبار الزامی است.</div>
    </div>
    <a href="/warehouse/warehouses" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-right me-1"></i>بازگشت به فهرست
    </a>
</div>

<EditForm Model="@model" OnValidSubmit="HandleValidSubmit" FormName="AddWarehouseForm">
    <DataAnnotationsValidator />

    <div class="row g-3">
        <div class="col-lg-8">

            @* ===== اطلاعات انبار ===== *@
            <div class="card-panel mb-3">
                <h6 class="form-section-title"><i class="bi bi-building"></i>اطلاعات انبار</h6>

                <AppTextField @bind-Value="model.Name" Label="نام انبار"
                              Placeholder="مثلاً: انبار مرکزی" />

                <div class="row">
                    <div class="col-md-6">
                        <AppTextField @bind-Value="model.Code" Label="کد (اختیاری)"
                                      Placeholder="مثلاً: WH-01" Hint="کد کوتاه برای شناسایی سریع انبار" />
                    </div>
                    <div class="col-md-6">
                        <AppTextField @bind-Value="model.Address" Label="آدرس (اختیاری)"
                                      Placeholder="مثلاً: تهران، جاده مخصوص" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">

            @* ===== راهنما ===== *@
            <div class="card-panel tips-panel">
                <h6 class="form-section-title"><i class="bi bi-lightbulb"></i>راهنمای سریع</h6>
                <ul class="small text-body-secondary mb-0 ps-3">
                    <li class="mb-2">نام انبار در اسناد ورود و خروج کالا نمایش داده می‌شود.</li>
                    <li>هر انبار موجودی مستقل خود را نگه می‌دارد؛ انتقال کالا بین انبارها با «انتقال بین انبار» انجام می‌شود.</li>
                </ul>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3 mb-0">
            <i class="bi bi-exclamation-octagon me-1"></i>@errorMessage
        </div>
    }

    @* ===== نوار عملیات ===== *@
    <div class="card-panel form-actions mt-3 d-flex align-items-center gap-2">
        <button type="submit" class="btn btn-primary" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            else
            {
                <i class="bi bi-check-lg me-1"></i>
            }
            ذخیره انبار
        </button>
        <a href="/warehouse/warehouses" class="btn btn-outline-secondary">انصراف</a>
    </div>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private CreateWarehouseDto model { get; set; } = new();

    private bool isSaving;
    private string? errorMessage;

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            await StockService.CreateWarehouseAsync(model);
            ToastService.ShowSuccess("انبار با موفقیت ثبت شد.");
            NavigationManager.NavigateTo("/warehouse/warehouses");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ذخیره انبار");
            errorMessage = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
            ToastService.ShowError(errorMessage);
        }
        finally
        {
            isSaving = false;
        }
    }
}
