@page "/warehouse/warehouses/add"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.WarehousesManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@inject IStockService StockService
@inject NavigationManager NavigationManager

<PageTitle>افزودن انبار</PageTitle>

<h3>افزودن انبار</h3>

<div class="card-panel" style="max-width: 480px;">
    <EditForm Model="@model" OnValidSubmit="HandleValidSubmit" FormName="AddWarehouseForm">
        <DataAnnotationsValidator />
        <ValidationSummary class="mb-3" />

        <div class="mb-3">
            <label class="form-label">نام انبار</label>
            <InputText class="form-control" @bind-Value="model.Name" placeholder="مثلاً: انبار مرکزی" />
        </div>

        <div class="mb-3">
            <label class="form-label">کد (اختیاری)</label>
            <InputText class="form-control" @bind-Value="model.Code" />
        </div>

        <div class="mb-4">
            <label class="form-label">آدرس (اختیاری)</label>
            <InputText class="form-control" @bind-Value="model.Address" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                @(isSaving ? "در حال ذخیره..." : "ذخیره انبار")
            </button>
            <a href="/warehouse/warehouses" class="btn btn-outline-secondary">انصراف</a>
        </div>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    private CreateWarehouseDto model { get; set; } = new();

    private bool isSaving;
    private string? errorMessage;

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            await StockService.CreateWarehouseAsync(model);
            NavigationManager.NavigateTo("/warehouse/warehouses");
        }
        catch (Exception ex)
        {
            errorMessage = $"ذخیره انبار ناموفق بود: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
