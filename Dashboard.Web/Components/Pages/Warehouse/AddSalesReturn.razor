@page "/warehouse/sales-returns/add"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.SalesReturnsManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Helpers
@using Dashboard.Application.Services
@using System.Security.Claims
@inject IStockService StockService
@inject IProductService ProductService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Dashboard.Web.Components.Pages.Warehouse.AddSalesReturn> Logger
@inject Dashboard.Web.Services.ToastService ToastService
@inject ISalesService SalesService
<PageTitle>ثبت برگشت از فروش</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-1">ثبت برگشت از فروش</h3>
        <div class="text-body-secondary small">برای برگشت کالا، ابتدا فاکتور فروش را با شماره‌ی آن جستجو کنید.</div>
    </div>
    <a href="/warehouse/sales-returns" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-right me-1"></i>بازگشت به فهرست
    </a>
</div>

<EditForm Model="@model" OnValidSubmit="HandleValidSubmit" FormName="AddSalesReturnForm">
    <DataAnnotationsValidator />

    @* ===== جستجوی فاکتور ===== *@
    <div class="card-panel mb-3">
        <h6 class="form-section-title"><i class="bi bi-search"></i>جستجوی فاکتور</h6>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">انبار</label>
                <input class="form-control"
                       value="@(selectedInvoice?.WarehouseName ?? "")"
                       disabled="@(selectedInvoice is not null)" />
                <div class="form-text">پس از جستجوی فاکتور، انبار به‌صورت خودکار تعیین می‌شود.</div>
                <ValidationMessage For="() => model.WarehouseId" class="text-danger small mt-1 d-block" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">مشتری</label>
                <input class="form-control"
                       value="@(selectedInvoice?.CustomerName ?? "")"
                       disabled="@(selectedInvoice is not null)" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">شماره فاکتور فروش</label>
            <div class="input-group">
                <input class="form-control"
                       @bind="invoiceNumber"
                       placeholder="شماره فاکتور را وارد کنید" />
                <button type="button"
                        class="btn btn-primary"
                        @onclick="SearchInvoice"
                        disabled="@searchingInvoice">
                    @if (searchingInvoice)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    else
                    {
                        <i class="bi bi-search me-1"></i>
                    }
                    جستجو
                </button>
            </div>
        </div>

        @if (selectedInvoice is not null)
        {
            <div class="alert alert-info mb-0">
                <strong>فاکتور:</strong> @selectedInvoice.InvoiceNumber
                <br />
                <strong>مشتری:</strong> @selectedInvoice.CustomerName
                <br />
                <strong>مبلغ:</strong> @CurrencyFormatter.ToToman(selectedInvoice.TotalAmount)
            </div>
        }
    </div>

    @* ===== اطلاعات سند ===== *@
    <div class="card-panel mb-3">
        <h6 class="form-section-title"><i class="bi bi-arrow-90deg-left"></i>اطلاعات سند</h6>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">تاریخ برگشت</label>
                <PersianDateTimePicker TValue="DateTime" @bind-Value="model.ReturnDate" ShowTime="true" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">توضیحات (اختیاری)</label>
            <InputTextArea class="form-control" rows="3" @bind-Value="model.Notes" />
            <ValidationMessage For="() => model.Notes" class="text-danger small mt-1 d-block" />
        </div>
    </div>

    @* ===== اقلام برگشتی ===== *@
    <div class="card-panel mb-3">
        <h6 class="form-section-title"><i class="bi bi-box-seam"></i>اقلام برگشتی</h6>
        <div class="form-text mb-3">مقدار برگشتی هر کالا را وارد کنید؛ کالاها از اقلام فاکتور انتخاب می‌شوند.</div>

        <StockItemRowsEditor Items="model.Items"
                             Products="@(products ?? Enumerable.Empty<ProductDto>())"
                             ReadOnlyProducts="@(selectedInvoice is not null)" />
        <ValidationMessage For="() => model.Items" class="text-danger small mt-1 d-block" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3 mb-0">
            <i class="bi bi-exclamation-octagon me-1"></i>@errorMessage
        </div>
    }

    @* ===== نوار عملیات ===== *@
    <div class="card-panel form-actions mt-3 d-flex align-items-center gap-2">
        <button type="submit" class="btn btn-primary" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            else
            {
                <i class="bi bi-check-lg me-1"></i>
            }
            ثبت برگشت
        </button>
        <a href="/warehouse/sales-returns" class="btn btn-outline-secondary">انصراف</a>
    </div>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private CreateSalesReturnDto model { get; set; } = new();

    private IEnumerable<ProductDto>? products;
    private IEnumerable<WarehouseDto>? warehouses;

    private bool isSaving;
    private string? errorMessage;
    private string invoiceNumber = string.Empty;
    private SalesInvoiceDto? selectedInvoice;
    private bool searchingInvoice;
    protected override async Task OnInitializedAsync()
    {
        model.Items.Add(new StockItemInput());
        warehouses = await StockService.GetWarehousesAsync();
        products = await ProductService.GetAllProductsAsync();
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        string? userId = null;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? authState.User.Identity?.Name;

            await StockService.RegisterSalesReturnAsync(model, userId);
            ToastService.ShowSuccess("برگشت از فروش ثبت شد.");
            NavigationManager.NavigateTo("/warehouse/sales-returns");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ثبت برگشت از فروش توسط {UserId}", userId);
            errorMessage = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
            ToastService.ShowError(errorMessage);
        }
        finally
        {
            isSaving = false;
        }
    }
    private async Task SearchInvoice()
    {
        if (string.IsNullOrWhiteSpace(invoiceNumber))
        {

            ToastService.ShowError("شماره فاکتور را وارد کنید.");
            return;
        }

        searchingInvoice = true;

        try
        {
            selectedInvoice = await SalesService
                .GetInvoiceByNumberAsync(invoiceNumber.Trim());

            if (selectedInvoice is null)
            {
                ToastService.ShowError(
                    "فاکتور تأیید شده‌ای با این شماره پیدا نشد.");
                return;
            }

            model.SalesInvoiceId = selectedInvoice.Id;
            model.WarehouseId = selectedInvoice.WarehouseId;

            // کالاهای فاکتور را به اقلام برگشت منتقل می‌کنیم
            model.Items = selectedInvoice.Items
                .Select(x => new StockItemInput
                {
                    ProductId = x.ProductId,
                    Quantity = 0
                })
                .ToList();
        }
        finally
        {
            searchingInvoice = false;
        }
    }
}
