@page "/warehouse/purchase-receipts"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.StockView)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@inject IStockService StockService

<PageTitle>رسیدهای خرید</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">رسیدهای خرید</h3>
    <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.PurchaseReceiptsManage" Context="manageContext">
        <Authorized>
            <a href="/warehouse/purchase-receipts/add" class="btn btn-primary">+ ثبت رسید خرید</a>
        </Authorized>
    </AuthorizeView>
</div>

<div class="card-panel">
    @if (receipts is null)
    {
        <p class="text-muted">در حال بارگذاری...</p>
    }
    else if (!receipts.Any())
    {
        <p class="text-muted text-center py-4">هنوز رسیدی ثبت نشده است.</p>
    }
    else
    {
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>شماره رسید</th>
                    <th>تاریخ</th>
                    <th>تأمین‌کننده</th>
                    <th>انبار</th>
                    <th>تعداد اقلام</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in receipts)
                {
                    <tr>
                        <td class="fw-medium">@r.ReceiptNumber</td>
                        <td class="text-muted">@r.ReceiptDate.ToString("yyyy/MM/dd")</td>
                        <td>@r.SupplierName</td>
                        <td>@r.WarehouseName</td>
                        <td>@r.ItemCount</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private IEnumerable<PurchaseReceiptSummaryDto>? receipts;

    protected override async Task OnInitializedAsync()
    {
        receipts = await StockService.GetPurchaseReceiptsAsync();
    }
}
