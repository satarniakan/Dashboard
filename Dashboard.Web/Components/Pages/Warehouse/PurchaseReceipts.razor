@page "/warehouse/purchase-receipts"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.StockView)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using Dashboard.Application.Helpers
@inject IStockService StockService

<PageTitle>رسیدهای خرید</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">رسیدهای خرید</h3>
        <div class="text-body-secondary small">فهرست رسیدهای خرید ثبت‌شده در انبار</div>
    </div>
    <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.PurchaseReceiptsManage" Context="manageContext">
        <Authorized>
            <a href="/warehouse/purchase-receipts/add" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>ثبت رسید خرید</a>
        </Authorized>
    </AuthorizeView>
</div>

<div class="card-panel">
    @if (receipts is null)
    {
        <p class="text-body-secondary">در حال بارگذاری...</p>
    }
    else if (!receipts.Any())
    {
        <div class="text-center text-body-secondary py-5">
            <i class="bi bi-box-arrow-in-down d-block fs-1 mb-2"></i>
            هنوز رسیدی ثبت نشده است.
        </div>
    }
    else
    {
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>شماره رسید</th>
                    <th>تاریخ</th>
                    <th>تأمین‌کننده</th>
                    <th>انبار</th>
                    <th>تعداد اقلام</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in receipts)
                {
                    <tr>
                        <td class="fw-medium">@r.ReceiptNumber</td>
                        <td class="text-muted">@r.ReceiptDate.ToPersianDate()</td>
                        <td>@r.SupplierName</td>
                        <td>@r.WarehouseName</td>
                        <td>@r.ItemCount</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private IEnumerable<PurchaseReceiptSummaryDto>? receipts;

    protected override async Task OnInitializedAsync()
    {
        receipts = await StockService.GetPurchaseReceiptsAsync();
    }
}
