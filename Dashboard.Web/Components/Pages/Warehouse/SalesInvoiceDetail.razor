@page "/warehouse/sales/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.SalesView)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using Dashboard.Application.Helpers
@using System.Security.Claims
@inject ISalesService SalesService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IInstallmentService InstallmentService
@inject ILogger<Dashboard.Web.Components.Pages.Warehouse.SalesInvoiceDetail> Logger
@inject Dashboard.Web.Services.ToastService ToastService
<PageTitle>فاکتور @invoice?.InvoiceNumber</PageTitle>

@if (invoice is null)
{
    <LoadingSkeleton />
}
else
{
    <div class="no-print d-flex justify-content-between align-items-start mb-3">
        <div>
            <h3 class="mb-1">فاکتور @invoice.InvoiceNumber</h3>
            <div class="text-body-secondary small">
                تاریخ: @invoice.InvoiceDate.ToPersianDate()
                <span class="badge @StatusBadgeClass ms-2 align-middle">@StatusLabel</span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="/warehouse/sales" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-right me-1"></i>بازگشت به فهرست
            </a>
            <PrintButton CssClass="btn btn-outline-secondary" />

            @if (invoice.Status == "Draft")
            {
                <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.SalesConfirm" Context="confirmContext">
                    <Authorized>
                        <button class="btn btn-primary" disabled="@isProcessing" @onclick="HandleConfirm">
                            @(isProcessing ? "در حال تأیید..." : "تأیید فاکتور و کسر موجودی")
                        </button>
                    </Authorized>
                </AuthorizeView>
            }

            @if (invoice.Status != "Canceled")
            {
                <AuthorizeView Policy="@Dashboard.Domain.Identity.Permissions.SalesCancel" Context="cancelContext">
                    <Authorized>
                        <button class="btn btn-outline-danger" disabled="@isProcessing" @onclick="HandleCancel">
                            لغو فاکتور
                        </button>
                    </Authorized>
                </AuthorizeView>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="no-print alert alert-danger">@errorMessage</div>
    }

    <div class="card-panel mb-3" id="invoice-print-area">
        <h6 class="form-section-title"><i class="bi bi-file-earmark-text"></i>اطلاعات فاکتور</h6>

        <div class="row mb-3">
            <div class="col-md-3">
                <div class="small text-body-secondary">شماره فاکتور</div>
                <div class="fw-bold">@invoice.InvoiceNumber</div>
            </div>
            <div class="col-md-3">
                <div class="small text-body-secondary">تاریخ</div>
                <div>@invoice.InvoiceDate.ToPersianDate()</div>
            </div>
            <div class="col-md-3">
                <div class="small text-body-secondary">مشتری</div>
                <div>@(invoice.CustomerName ?? "مشتری حضوری")</div>
            </div>
            <div class="col-md-3">
                <div class="small text-body-secondary">انبار</div>
                <div>@invoice.WarehouseName</div>
            </div>
        </div>

        <h6 class="form-section-title"><i class="bi bi-basket"></i>اقلام فاکتور</h6>

        <table class="table mb-3">
            <thead>
                <tr>
                    <th>کالا</th>
                    <th>مقدار</th>
                    <th>قیمت واحد</th>
                    <th>جمع</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in invoice.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Quantity</td>
                        <td>@CurrencyFormatter.ToToman(item.UnitPrice)</td>
                        <td>@CurrencyFormatter.ToToman(item.LineTotal)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-end">
            <div style="min-width: 260px;">
                <div class="d-flex justify-content-between bg-body-tertiary rounded px-3 py-2">
                    <span class="text-body-secondary">تخفیف:</span>
                    <span>@CurrencyFormatter.ToToman(invoice.DiscountAmount)</span>
                </div>
                <div class="d-flex justify-content-between fw-bold fs-5 mt-2">
                    <span>مبلغ نهایی:</span>
                    <span>@CurrencyFormatter.ToToman(invoice.TotalAmount)</span>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(invoice.Notes))
        {
            <p class="text-body-secondary mt-4 mb-0">توضیحات: @invoice.Notes</p>
        }
    </div>
    @if (invoice.Status == "Confirmed")
    {
        <div class="no-print card-panel mt-3">
            <h6 class="form-section-title"><i class="bi bi-credit-card"></i>اقساط</h6>

            @if (installmentPlan is null)
            {
                @if (!showPlanForm)
                {
                    <button class="btn btn-outline-primary" @onclick="() => showPlanForm = true">تعریف طرح اقساط</button>
                }
                else
                {
                    <p class="text-body-secondary mb-3">جمع اقساط باید دقیقاً برابر @CurrencyFormatter.ToToman(invoice.TotalAmount) باشد.</p>

                    <table class="table mb-2 align-middle">
                        <thead>
                            <tr>
                                <th>سررسید</th>
                                <th>مبلغ</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < planRows.Count; i++)
                            {
                                var row = planRows[i];
                                <tr>
                                    <td><PersianDateTimePicker TValue="DateTime" @bind-Value="row.DueDate" ShowTime="false" /></td>
                                    <td><AppPriceField TValue="decimal" @bind-Value="row.Amount" WrapperClass=""
                                                       ShowWords="true" /></td>
                                    <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => planRows.Remove(row)">حذف</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddPlanRow">
                            <i class="bi bi-plus-lg me-1"></i>افزودن قسط
                        </button>
                        <span class="text-body-secondary">
                            جمع فعلی: @CurrencyFormatter.ToToman(planRows.Sum(r => r.Amount))
                        </span>
                    </div>

                    @if (!string.IsNullOrEmpty(planError))
                    {
                        <div class="alert alert-danger">@planError</div>
                    }

                    <button class="btn btn-primary" disabled="@isSavingPlan" @onclick="SavePlan">
                        @if (isSavingPlan)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        }
                        ذخیره طرح اقساط
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="() => showPlanForm = false">انصراف</button>
                }
            }
            else
            {
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>سررسید</th>
                            <th>مبلغ</th>
                            <th>پرداخت‌شده</th>
                            <th>وضعیت</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inst in installmentPlan.Installments)
                        {
                            <tr class="@(inst.IsOverdue ? "table-danger" : "")">
                                <td>@inst.SequenceNumber</td>
                                <td>@inst.DueDate.ToPersianDate()</td>
                                <td>@CurrencyFormatter.ToToman(inst.Amount)</td>
                                <td>@CurrencyFormatter.ToToman(inst.PaidAmount)</td>
                                <td>
                                    @if (inst.IsFullyPaid)
                                    {
                                        <span class="badge bg-success-subtle text-success">تسویه‌شده</span>
                                    }
                                    else if (inst.IsOverdue)
                                    {
                                        <span class="badge bg-danger-subtle text-danger">معوق</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning">در انتظار</span>
                                    }
                                </td>
                                <td>
                                    @if (!inst.IsFullyPaid)
                                    {
                                        <a href="@GetReceiptLink(inst)" class="btn btn-sm btn-outline-primary">ثبت دریافت</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
    <div class="no-print mt-3">
        <a href="/warehouse/sales" class="btn btn-outline-secondary">بازگشت به لیست</a>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private SalesInvoiceDto? invoice;
    private bool isProcessing;
    private string? errorMessage;

    private string StatusLabel => invoice!.Status switch
    {
        "Draft" => "پیش‌نویس",
        "Confirmed" => "تأییدشده",
        "Canceled" => "لغوشده",
        _ => invoice!.Status
    };

    private string StatusBadgeClass => invoice!.Status switch
    {
        "Draft" => "bg-warning-subtle text-warning",
        "Confirmed" => "bg-success-subtle text-success",
        "Canceled" => "bg-secondary-subtle text-secondary",
        _ => "bg-secondary-subtle text-secondary"
    };

    protected override async Task OnInitializedAsync()
    {
        invoice = await SalesService.GetInvoiceAsync(Id);
        if (invoice?.Status == "Confirmed")
        {
            installmentPlan = await InstallmentService.GetInstallmentPlanAsync(Id);
        }
    }

    private async Task<string?> GetUserIdAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        return authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? authState.User.Identity?.Name;
    }

    private async Task HandleConfirm()
    {
        isProcessing = true;
        errorMessage = null;
        try
        {
            var userId = await GetUserIdAsync();
            await SalesService.ConfirmInvoiceAsync(Id, userId);
            invoice = await SalesService.GetInvoiceAsync(Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در تأیید فاکتور {InvoiceId}", Id);
            errorMessage = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
            ToastService.ShowError(errorMessage);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleCancel()
    {
        isProcessing = true;
        errorMessage = null;
        try
        {
            var userId = await GetUserIdAsync();
            await SalesService.CancelInvoiceAsync(Id, userId);
            invoice = await SalesService.GetInvoiceAsync(Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در لغو فاکتور {InvoiceId}", Id);
            errorMessage = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
            ToastService.ShowError(errorMessage);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private InstallmentPlanDto? installmentPlan;
    private bool showPlanForm;
    private bool isSavingPlan;
    private string? planError;
    private List<InstallmentRowModel> planRows = new();

    private class InstallmentRowModel
    {
        public DateTime DueDate { get; set; } = DateTime.UtcNow.AddMonths(1);
        public decimal Amount { get; set; }
    }
    private void AddPlanRow() => planRows.Add(new InstallmentRowModel());

    private async Task SavePlan()
    {
        isSavingPlan = true;
        planError = null;
        try
        {
            if (planRows.Sum(r => r.Amount) != invoice!.TotalAmount)
            {
                planError = "جمع اقساط باید دقیقاً برابر مبلغ فاکتور باشد.";
                return;
            }

            var dto = new CreateInstallmentPlanDto
            {
                SalesInvoiceId = Id,
                Installments = planRows.Select(r => new InstallmentInput(r.DueDate, r.Amount)).ToList()
            };

            var userId = await GetUserIdAsync();
            await InstallmentService.CreateInstallmentPlanAsync(dto, userId);

            installmentPlan = await InstallmentService.GetInstallmentPlanAsync(Id);
            showPlanForm = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ذخیره طرح اقساط برای فاکتور {InvoiceId}", Id);
            planError = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
        }
        finally
        {
            isSavingPlan = false;
        }
    }

    private string GetReceiptLink(InstallmentDto inst)
    {
        var remaining = inst.Amount - inst.PaidAmount;
        return $"/accounting/customer-receipts/add?installmentId={inst.Id}&amount={remaining}";
    }
}
