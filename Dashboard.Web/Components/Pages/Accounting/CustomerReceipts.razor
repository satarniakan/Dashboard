@page "/accounting/customer-receipts"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.TreasuryManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using Dashboard.Application.Helpers
@inject ITreasuryService TreasuryService

<PageTitle>دریافت از مشتریان</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">دریافت از مشتریان</h3>
        <div class="text-body-secondary small">فهرست دریافت‌های ثبت‌شده از مشتریان</div>
    </div>
    <a href="/accounting/customer-receipts/add" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>ثبت دریافت
    </a>
</div>

<div class="card-panel">
    @if (receipts is null)
    {
        <p class="text-body-secondary">در حال بارگذاری...</p>
    }
    else if (!receipts.Any())
    {
        <div class="text-center text-body-secondary py-5">
            <i class="bi bi-receipt fs-1 d-block mb-2"></i>
            هنوز دریافتی ثبت نشده است.
        </div>
    }
    else
    {
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>شماره رسید</th>
                    <th>تاریخ</th>
                    <th>مشتری</th>
                    <th>صندوق/بانک</th>
                    <th>روش</th>
                    <th>مبلغ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in receipts)
                {
                    <tr>
                        <td class="fw-medium">@r.ReceiptNumber</td>
                        <td class="text-muted">@r.ReceiptDate.ToPersianDate()</td>
                        <td>@(r.CustomerName ?? "-")</td>
                        <td>@r.FinancialAccountName</td>
                        <td>@MethodLabel(r.Method)</td>
                        <td>@CurrencyFormatter.ToToman(r.Amount)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private IEnumerable<CustomerReceiptDto>? receipts;

    protected override async Task OnInitializedAsync()
    {
        receipts = await TreasuryService.GetCustomerReceiptsAsync();
    }

    private string MethodLabel(string method) => method switch
    {
        "Cash" => "نقدی",
        "CardTransfer" => "کارت به کارت",
        "Cheque" => "چک",
        "BankTransfer" => "حواله بانکی",
        _ => method
    };
}