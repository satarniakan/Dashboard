@page "/accounting/journal/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.AccountingView)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.Services
@using Dashboard.Application.Helpers
@inject IJournalService JournalService

<PageTitle>سند @entry?.EntryNumber</PageTitle>

@if (entry is null)
{
    <LoadingSkeleton Table="false" Rows="6" />
}
else
{
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-1">سند شماره @entry.EntryNumber</h3>
            <div class="text-body-secondary small">@entry.EntryDate.ToPersianDateTime()</div>
        </div>
        <div class="d-flex gap-2 no-print">
            <a href="/accounting/journal" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-right me-1"></i>بازگشت به فهرست
            </a>
            <PrintButton />
        </div>
    </div>

    <ReportPrintHeader Title="@($"سند حسابداری شماره {entry.EntryNumber}")"
                       Subtitle="@entry.EntryDate.ToPersianDateTime()" />

    <div class="card-panel mb-3">
        <h6 class="form-section-title"><i class="bi bi-journal-text"></i>اطلاعات سند</h6>

        <div class="row">
            <div class="col-md-3">
                <div class="small text-body-secondary">شماره سند</div>
                <div class="fw-bold">@entry.EntryNumber</div>
            </div>
            <div class="col-md-3">
                <div class="small text-body-secondary">تاریخ</div>
                <div>@entry.EntryDate.ToPersianDateTime()</div>
            </div>
            <div class="col-md-6">
                <div class="small text-body-secondary">شرح</div>
                <div>@entry.Description</div>
            </div>
        </div>
    </div>

    <div class="card-panel">
        <h6 class="form-section-title"><i class="bi bi-list-check"></i>اقلام سند</h6>

        <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>کد حساب</th>
                    <th>نام حساب</th>
                    <th>شرح</th>
                    <th>بدهکار</th>
                    <th>بستانکار</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in entry.Lines)
                {
                    <tr>
                        <td class="text-body-secondary">@line.AccountCode</td>
                        <td class="fw-medium">@line.AccountName</td>
                        <td class="text-body-secondary">@line.Description</td>
                        <td>@(line.Debit > 0 ? CurrencyFormatter.ToToman(line.Debit) : "-")</td>
                        <td>@(line.Credit > 0 ? CurrencyFormatter.ToToman(line.Credit) : "-")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold bg-body-tertiary">
                    <td colspan="3">جمع</td>
                    <td>@CurrencyFormatter.ToToman(entry.Lines.Sum(l => l.Debit))</td>
                    <td>@CurrencyFormatter.ToToman(entry.Lines.Sum(l => l.Credit))</td>
                </tr>
            </tfoot>
        </table>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private Dashboard.Application.DTOs.JournalEntryDto? entry;

    protected override async Task OnInitializedAsync()
    {
        entry = await JournalService.GetEntryAsync(Id);
    }
}