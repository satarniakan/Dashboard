@page "/accounting/overdue-installments"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.TreasuryManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using Dashboard.Application.Helpers
@inject IInstallmentService InstallmentService

<PageTitle>اقساط معوق</PageTitle>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">اقساط معوق</h3>
        <div class="text-body-secondary small">اقساطی که از سررسید آن‌ها گذشته و تسویه نشده‌اند</div>
    </div>
</div>

<div class="card-panel">
    @if (overdue is null)
    {
        <LoadingSkeleton />
    }
    else if (!overdue.Any())
    {
        <div class="text-center text-body-secondary py-5">
            <i class="bi bi-check2-circle fs-1 d-block mb-2"></i>
            هیچ قسط معوقی وجود ندارد.
        </div>
    }
    else
    {
        <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>فاکتور</th>
                    <th>مشتری</th>
                    <th>سررسید</th>
                    <th>روزهای تأخیر</th>
                    <th>مبلغ باقی‌مانده</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in overdue)
                {
                    <tr class="table-danger">
                        <td class="fw-medium">@o.InvoiceNumber</td>
                        <td>@o.CustomerName</td>
                        <td>@o.DueDate.ToPersianDate()</td>
                        <td class="fw-bold">@o.DaysOverdue روز</td>
                        <td>@CurrencyFormatter.ToToman(o.Amount - o.PaidAmount)</td>
                        <td>
                            <a href="/accounting/customer-receipts/add?installmentId=@o.InstallmentId&amount=@(o.Amount - o.PaidAmount)" class="btn btn-sm btn-outline-primary">ثبت دریافت</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@code {
    private IEnumerable<OverdueInstallmentDto>? overdue;

    protected override async Task OnInitializedAsync()
    {
        overdue = await InstallmentService.GetOverdueInstallmentsAsync();
    }
}