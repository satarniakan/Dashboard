@page "/accounting/journal"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.AccountingView)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using Dashboard.Application.Helpers
@inject IJournalService JournalService

<PageTitle>دفتر روزنامه</PageTitle>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">دفتر روزنامه</h3>
        <div class="text-body-secondary small">سندهای حسابداری ثبت‌شده</div>
    </div>
    @if (entries is not null && entries.Any())
    {
        <PrintButton />
    }
</div>

<ReportPrintHeader Title="دفتر روزنامه" />

<div class="card-panel">
    @if (entries is null)
    {
        <LoadingSkeleton />
    }
    else if (!entries.Any())
    {
        <div class="text-center text-body-secondary py-5">
            <i class="bi bi-journal-text fs-1 d-block mb-2"></i>
            هنوز سندی صادر نشده است.
        </div>
    }
    else
    {
        <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>شماره سند</th>
                    <th>تاریخ</th>
                    <th>شرح</th>
                    <th>مبلغ سند</th>
                    <th class="no-print"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in entries)
                {
                    <tr>
                        <td class="fw-medium">@e.EntryNumber</td>
                        <td class="text-muted">@e.EntryDate.ToPersianDateTime()</td>
                        <td>@e.Description</td>
                        <td>@CurrencyFormatter.ToToman(e.Lines.Sum(l => l.Debit))</td>
                        <td class="text-end no-print">
                            <a href="/accounting/journal/@e.Id" class="btn btn-sm btn-outline-primary">جزئیات</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@code {
    private IEnumerable<JournalEntryDto>? entries;

    protected override async Task OnInitializedAsync()
    {
        entries = await JournalService.GetEntriesAsync();
    }
}