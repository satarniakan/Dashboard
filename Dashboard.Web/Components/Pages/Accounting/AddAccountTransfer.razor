@page "/accounting/account-transfers/add"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.TreasuryManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using System.Security.Claims
@inject ITreasuryService TreasuryService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Dashboard.Web.Components.Pages.Accounting.AddAccountTransfer> Logger
@inject Dashboard.Web.Services.ToastService ToastService
<PageTitle>انتقال بین صندوق و بانک</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-1">انتقال بین صندوق و بانک</h3>
        <div class="text-body-secondary small">
            برای تسویهٔ پولِ پرداخت آنلاین استفاده می‌شود: مبلغ از مبدأ کسر و به مقصد اضافه می‌شود.
        </div>
    </div>
    <a href="/accounting/financial-accounts" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-right me-1"></i>بازگشت به فهرست
    </a>
</div>

<div style="max-width: 640px;">
    <EditForm Model="@model" OnValidSubmit="HandleValidSubmit" FormName="AddAccountTransferForm">
        <DataAnnotationsValidator />

        <div class="card-panel mb-3">
            <h6 class="form-section-title"><i class="bi bi-arrow-left-right"></i>طرفین انتقال</h6>

            <div class="row">
                <div class="col-md-6">
                    <AppDropdown TValue="int" Label="از صندوق/بانک" @bind-Value="model.FromFinancialAccountId"
                                 Required="true"
                                 Hint="حسابی که مبلغ از آن برداشته می‌شود (مثلاً صندوق درگاه پرداخت).">
                        <option value="0">-- انتخاب کنید --</option>
                        @if (financialAccounts is not null)
                        {
                            @foreach (var f in financialAccounts)
                            {
                                <option value="@f.Id">@f.Name</option>
                            }
                        }
                    </AppDropdown>
                </div>
                <div class="col-md-6">
                    <AppDropdown TValue="int" Label="به صندوق/بانک" @bind-Value="model.ToFinancialAccountId"
                                 Required="true"
                                 Hint="حسابی که مبلغ به آن واریز می‌شود (مثلاً حساب بانکی اصلی).">
                        <option value="0">-- انتخاب کنید --</option>
                        @if (financialAccounts is not null)
                        {
                            @foreach (var f in financialAccounts)
                            {
                                <option value="@f.Id">@f.Name</option>
                            }
                        }
                    </AppDropdown>
                </div>
            </div>
        </div>

        <div class="card-panel mb-3">
            <h6 class="form-section-title"><i class="bi bi-cash-coin"></i>مبلغ</h6>
            <div class="row">
                <div class="col-md-6">
                    <AppPriceField TValue="decimal" @bind-Value="model.Amount" Label="مبلغ انتقال (تومان)"
                                   Required="true" />
                </div>
                <div class="col-md-6">
                    <AppTextField TValue="string" @bind-Value="model.Notes" Label="توضیحات"
                                  Placeholder="مثلاً: تسویهٔ پرداخت‌های هفتهٔ گذشته" />
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mb-0">
                <i class="bi bi-exclamation-octagon me-1"></i>@errorMessage
            </div>
        }

        <div class="card-panel form-actions mt-3 d-flex align-items-center gap-2">
            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-check-lg me-1"></i>
                }
                ثبت انتقال
            </button>
            <a href="/accounting/financial-accounts" class="btn btn-outline-secondary">انصراف</a>
        </div>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    private TransferBetweenAccountsDto? _model { get; set; }

    private TransferBetweenAccountsDto model => _model ??= new();

    private IEnumerable<FinancialAccountDto>? financialAccounts;

    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        financialAccounts = await TreasuryService.GetFinancialAccountsAsync();
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        string? userId = null;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? authState.User.Identity?.Name;

            await TreasuryService.PostAccountTransferAsync(model, userId);
            ToastService.ShowSuccess("انتقال با موفقیت ثبت شد.");
            NavigationManager.NavigateTo("/accounting/financial-accounts");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ثبت انتقال بین حساب‌ها توسط {UserId}", userId);
            errorMessage = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
            ToastService.ShowError(errorMessage);
        }
        finally
        {
            isSaving = false;
        }
    }
}
