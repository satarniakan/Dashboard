@page "/accounting/profit-and-loss"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.AccountingView)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.Services
@using Dashboard.Application.Helpers
@inject IJournalService JournalService

<PageTitle>صورت سود و زیان</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">صورت سود و زیان</h3>
        <div class="text-body-secondary small">خلاصه درآمدها و هزینه‌ها در بازه انتخابی</div>
    </div>
    @if (report is not null)
    {
        <PrintButton />
    }
</div>

<ReportPrintHeader Title="صورت سود و زیان"
                   Subtitle="@ReportSubtitle" />

<div class="card-panel mb-3 no-print">
    <div class="row align-items-end">
        <div class="col-md-4">
            <label class="form-label">از تاریخ</label>
            <PersianDateTimePicker TValue="DateTime?" @bind-Value="fromDate" ShowTime="false" />
        </div>
        <div class="col-md-4">
            <label class="form-label">تا تاریخ</label>
            <PersianDateTimePicker TValue="DateTime?" @bind-Value="toDate" ShowTime="false" />
        </div>
        <div class="col-md-4">
            <button class="btn btn-primary w-100" @onclick="LoadReport">نمایش گزارش</button>
        </div>
    </div>
</div>

@if (report is null)
{
    <div class="card-panel">
        <div class="text-center text-body-secondary py-5">
            <i class="bi bi-graph-up fs-1 d-block mb-2"></i>
            بازه تاریخ را انتخاب کنید و روی «نمایش گزارش» بزنید.
        </div>
    </div>
}
else
{
    <div class="card-panel">
        <h6 class="form-section-title"><i class="bi bi-graph-up-arrow"></i>درآمدها</h6>
        <table class="table">
            <tbody>
                @foreach (var (name, amount) in report.RevenueBreakdown)
                {
                    <tr>
                        <td>@name</td>
                        <td class="text-end">@CurrencyFormatter.ToToman(amount)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold bg-body-tertiary">
                    <td>جمع درآمد</td>
                    <td class="text-end">@CurrencyFormatter.ToToman(report.TotalRevenue)</td>
                </tr>
            </tfoot>
        </table>

        <h6 class="form-section-title mt-4"><i class="bi bi-graph-down-arrow"></i>هزینه‌ها</h6>
        <table class="table">
            <tbody>
                @foreach (var (name, amount) in report.ExpenseBreakdown)
                {
                    <tr>
                        <td>@name</td>
                        <td class="text-end">@CurrencyFormatter.ToToman(amount)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold bg-body-tertiary">
                    <td>جمع هزینه</td>
                    <td class="text-end">@CurrencyFormatter.ToToman(report.TotalExpense)</td>
                </tr>
            </tfoot>
        </table>

        <div class="d-flex justify-content-between fs-5 fw-bold rounded bg-body-tertiary px-3 py-2 mt-3 @(report.NetProfit >= 0 ? "text-success" : "text-danger")">
            <span>سود (زیان) خالص</span>
            <span>@CurrencyFormatter.ToToman(report.NetProfit)</span>
        </div>
    </div>
}

@code {
    private DateTime? fromDate;
    private DateTime? toDate;
    private Dashboard.Application.DTOs.ProfitAndLossDto? report;

    private string? ReportSubtitle =>
        fromDate.HasValue || toDate.HasValue
            ? $"بازه: {(fromDate.HasValue ? fromDate.Value.ToPersianDate() : "…")} تا {(toDate.HasValue ? toDate.Value.ToPersianDate() : "…")}"
            : null;

    private async Task LoadReport()
    {
        report = await JournalService.GetProfitAndLossAsync(fromDate, toDate);
    }
}