@page "/accounting/customer-receipts/add"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.TreasuryManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using Dashboard.Application.Helpers
@using System.Security.Claims
@inject ITreasuryService TreasuryService
@inject ISalesService SalesService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IInstallmentService InstallmentService
@inject ILogger<Dashboard.Web.Components.Pages.Accounting.AddCustomerReceipt> Logger
@inject Dashboard.Web.Services.ToastService ToastService
<PageTitle>ثبت دریافت از مشتری</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-1">ثبت دریافت از مشتری</h3>
        <div class="text-body-secondary small">اطلاعات دریافتی از مشتری را وارد کنید؛ مبلغ به تومان محاسبه می‌شود.</div>
    </div>
    <a href="/accounting/customer-receipts" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-right me-1"></i>بازگشت به فهرست
    </a>
</div>

@if (InstallmentIdFromQuery.HasValue)
{
    <div class="alert alert-info">این دریافت برای یک قسط مشخص ثبت می‌شود.</div>
}

<div style="max-width: 640px;">
    <EditForm Model="@model" OnValidSubmit="HandleValidSubmit" FormName="AddCustomerReceiptForm">
        <DataAnnotationsValidator />

        @* ===== طرف حساب ===== *@
        <div class="card-panel mb-3">
            <h6 class="form-section-title"><i class="bi bi-person"></i>طرف حساب</h6>

            <div class="mb-3">
                <label class="form-label">مشتری (اختیاری)</label>
                <CustomerSearchSelect Customers="customers ?? Enumerable.Empty<CustomerDto>()" @bind-Value="model.CustomerId" NoneLabel="-- بدون مشتری مشخص --" />
            </div>

            <div class="row">
                <div class="col-md-6">
                    <AppDropdown TValue="int" Label="واریز به صندوق/بانک" @bind-Value="model.FinancialAccountId"
                                 Hint="صندوق یا حساب بانکی که مبلغ دریافت به آن اضافه می‌شود.">
                        <option value="0">-- انتخاب کنید --</option>
                        @if (financialAccounts is not null)
                        {
                            @foreach (var f in financialAccounts)
                            {
                                <option value="@f.Id">@f.Name</option>
                            }
                        }
                    </AppDropdown>
                </div>
            </div>
        </div>

        @* ===== جزئیات دریافت ===== *@
        <div class="card-panel mb-3">
            <h6 class="form-section-title"><i class="bi bi-cash-coin"></i>جزئیات دریافت</h6>

            <div class="row">
                <div class="col-md-6">
                    <AppPriceField TValue="decimal" @bind-Value="model.Amount" Label="مبلغ (تومان)"
                                   Placeholder="0" WrapperClass="" ShowWords="true"
                                   QuickAmounts="new[] { 100_000L, 500_000L, 1_000_000L }" />
                </div>
                <div class="col-md-6">
                    <AppDropdown Label="روش دریافت" @bind-Value="model.Method">
                        <option value="Cash">نقدی</option>
                        <option value="CardTransfer">کارت به کارت</option>
                        <option value="Cheque">چک</option>
                        <option value="BankTransfer">حواله بانکی</option>
                    </AppDropdown>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">تاریخ</label>
                        <PersianDateTimePicker TValue="DateTime" @bind-Value="model.ReceiptDate" ShowTime="true" />
                    </div>
                </div>
            </div>
        </div>

        @* ===== اطلاعات چک ===== *@
        @if (model.Method == "Cheque")
        {
            <div class="card-panel mb-3">
                <h6 class="form-section-title"><i class="bi bi-file-earmark-text"></i>اطلاعات چک</h6>
                <div class="row">
                    <div class="col-md-6">
                        <AppTextField @bind-Value="model.ChequeNumber" Label="شماره چک"
                                      Placeholder="مثلاً: 123456" />
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">تاریخ سررسید چک</label>
                            <PersianDateTimePicker TValue="DateTime?" @bind-Value="model.ChequeDueDate" ShowTime="false" />
                        </div>
                    </div>
                </div>
            </div>
        }

        @* ===== توضیحات ===== *@
        <div class="card-panel mb-3">
            <h6 class="form-section-title"><i class="bi bi-journal-text"></i>توضیحات <span class="text-body-secondary small fw-normal">(اختیاری)</span></h6>
            <div class="mb-0">
                <InputTextArea class="form-control" @bind-Value="model.Notes" rows="2" placeholder="توضیحات دلخواه درباره این دریافت…" />
                <ValidationMessage For="() => model.Notes" class="text-danger small mt-1 d-block" />
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mb-0">
                <i class="bi bi-exclamation-octagon me-1"></i>@errorMessage
            </div>
        }

        @* ===== نوار عملیات ===== *@
        <div class="card-panel form-actions mt-3 d-flex align-items-center gap-2">
            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-check-lg me-1"></i>
                }
                ثبت دریافت
            </button>
            <a href="/accounting/customer-receipts" class="btn btn-outline-secondary">انصراف</a>
        </div>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    private CreateCustomerReceiptDto model { get; set; } = new();

    private IEnumerable<CustomerDto>? customers;
    private IEnumerable<FinancialAccountDto>? financialAccounts;

    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        customers = await SalesService.GetCustomersAsync();
        financialAccounts = await TreasuryService.GetFinancialAccountsAsync();
        if (InstallmentIdFromQuery.HasValue)
        {
            model.InstallmentId = InstallmentIdFromQuery;
            if (AmountFromQuery.HasValue)
            {
                model.Amount = AmountFromQuery.Value;
            }
        }
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        string? userId = null;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? authState.User.Identity?.Name;

            await TreasuryService.RegisterCustomerReceiptAsync(model, userId);
            ToastService.ShowSuccess("دریافت با موفقیت ثبت شد.");
            NavigationManager.NavigateTo("/accounting/customer-receipts");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ثبت دریافت از مشتری توسط {UserId}", userId);
            errorMessage = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
            ToastService.ShowError(errorMessage);
        }
        finally
        {
            isSaving = false;
        }
    }
    [SupplyParameterFromQuery(Name = "installmentId")]
    private int? InstallmentIdFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "amount")]
    private decimal? AmountFromQuery { get; set; }
}
