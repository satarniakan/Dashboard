@page "/accounting/financial-accounts"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.TreasuryManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@inject ITreasuryService TreasuryService

<PageTitle>صندوق و بانک</PageTitle>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">صندوق‌ها و حساب‌های بانکی</h3>
        <div class="text-body-secondary small">صندوق‌های نقدی و حساب‌های بانکی شرکت</div>
    </div>
    <a href="/accounting/financial-accounts/add" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>افزودن صندوق/بانک
    </a>
</div>

<div class="card-panel">
    @if (accounts is null)
    {
        <LoadingSkeleton />
    }
    else if (!accounts.Any())
    {
        <div class="text-center text-body-secondary py-5">
            <i class="bi bi-bank fs-1 d-block mb-2"></i>
            هنوز صندوق یا حساب بانکی‌ای ثبت نشده است.
        </div>
    }
    else
    {
        <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>نام</th>
                    <th>نوع</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in accounts)
                {
                    <tr>
                        <td class="fw-medium">@a.Name</td>
                        <td><span class="badge bg-body-tertiary text-body border">@(a.Type == "Cash" ? "صندوق" : "بانک")</span></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@code {
    private IEnumerable<FinancialAccountDto>? accounts;

    protected override async Task OnInitializedAsync()
    {
        accounts = await TreasuryService.GetFinancialAccountsAsync();
    }
}