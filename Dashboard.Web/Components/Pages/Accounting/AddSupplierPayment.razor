@page "/accounting/supplier-payments/add"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.TreasuryManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using System.Security.Claims
@inject ITreasuryService TreasuryService
@inject IStockService StockService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Dashboard.Web.Components.Pages.Accounting.AddSupplierPayment> Logger
@inject Dashboard.Web.Services.ToastService ToastService
<PageTitle>ثبت پرداخت به تأمین‌کننده</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-1">ثبت پرداخت به تأمین‌کننده</h3>
        <div class="text-body-secondary small">اطلاعات پرداختی به تأمین‌کننده را وارد کنید؛ مبلغ به تومان محاسبه می‌شود.</div>
    </div>
    <a href="/accounting/supplier-payments" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-right me-1"></i>بازگشت به فهرست
    </a>
</div>

<div style="max-width: 640px;">
    <EditForm Model="@model" OnValidSubmit="HandleValidSubmit" FormName="AddSupplierPaymentForm">
        <DataAnnotationsValidator />

        @* ===== طرف حساب ===== *@
        <div class="card-panel mb-3">
            <h6 class="form-section-title"><i class="bi bi-person-check"></i>طرف حساب</h6>

            <div class="row">
                <div class="col-md-6">
                    <AppDropdown TValue="int" Label="تأمین‌کننده" @bind-Value="model.SupplierId" Required="true">
                        <option value="0">-- انتخاب کنید --</option>
                        @if (suppliers is not null)
                        {
                            @foreach (var s in suppliers)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        }
                    </AppDropdown>
                </div>
                <div class="col-md-6">
                    <AppDropdown TValue="int" Label="پرداخت از صندوق/بانک" @bind-Value="model.FinancialAccountId"
                                 Required="true"
                                 Hint="صندوق یا حساب بانکی که مبلغ پرداخت از آن کسر می‌شود.">
                        <option value="0">-- انتخاب کنید --</option>
                        @if (financialAccounts is not null)
                        {
                            @foreach (var f in financialAccounts)
                            {
                                <option value="@f.Id">@f.Name</option>
                            }
                        }
                    </AppDropdown>
                </div>
            </div>
        </div>

        @* ===== جزئیات پرداخت ===== *@
        <div class="card-panel mb-3">
            <h6 class="form-section-title"><i class="bi bi-cash-coin"></i>جزئیات پرداخت</h6>

            <div class="row">
                <div class="col-md-6">
                    <AppPriceField TValue="decimal" @bind-Value="model.Amount" Label="مبلغ (تومان)"
                                   Required="true"
                                   Placeholder="0" WrapperClass="" ShowWords="true"
                                   QuickAmounts="new[] { 100_000L, 500_000L, 1_000_000L }" />
                </div>
                <div class="col-md-6">
                    <AppDropdown Label="روش پرداخت" @bind-Value="model.Method" Required="true">
                        <option value="Cash">نقدی</option>
                        <option value="CardTransfer">کارت به کارت</option>
                        <option value="Cheque">چک</option>
                        <option value="BankTransfer">حواله بانکی</option>
                    </AppDropdown>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">تاریخ</label>
                        <PersianDateTimePicker TValue="DateTime" @bind-Value="model.PaymentDate" ShowTime="true" />
                    </div>
                </div>
            </div>
        </div>

        @* ===== اطلاعات چک ===== *@
        @if (model.Method == "Cheque")
        {
            <div class="card-panel mb-3">
                <h6 class="form-section-title"><i class="bi bi-file-earmark-text"></i>اطلاعات چک</h6>
                <div class="row">
                    <div class="col-md-6">
                        <AppTextField @bind-Value="model.ChequeNumber" Label="شماره چک"
                                      Placeholder="مثلاً: 123456" />
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">تاریخ سررسید چک</label>
                            <PersianDateTimePicker TValue="DateTime?" @bind-Value="model.ChequeDueDate" ShowTime="false" />
                        </div>
                    </div>
                </div>
            </div>
        }

        @* ===== توضیحات ===== *@
        <div class="card-panel mb-3">
            <h6 class="form-section-title"><i class="bi bi-journal-text"></i>توضیحات <span class="text-body-secondary small fw-normal">(اختیاری)</span></h6>
            <AppTextArea @bind-Value="model.Notes" Rows="2" Placeholder="توضیحات دلخواه درباره این پرداخت…"
                         WrapperClass="mb-0" ShowCount="true" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mb-0">
                <i class="bi bi-exclamation-octagon me-1"></i>@errorMessage
            </div>
        }

        @* ===== نوار عملیات ===== *@
        <div class="card-panel form-actions mt-3 d-flex align-items-center gap-2">
            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-check-lg me-1"></i>
                }
                ثبت پرداخت
            </button>
            <a href="/accounting/supplier-payments" class="btn btn-outline-secondary">انصراف</a>
        </div>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    private CreateSupplierPaymentDto? _model { get; set; }

    private CreateSupplierPaymentDto model => _model ??= new();

    private IEnumerable<SupplierDto>? suppliers;
    private IEnumerable<FinancialAccountDto>? financialAccounts;

    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        suppliers = await StockService.GetSuppliersAsync();
        financialAccounts = await TreasuryService.GetFinancialAccountsAsync();
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        string? userId = null;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? authState.User.Identity?.Name;

            await TreasuryService.RegisterSupplierPaymentAsync(model, userId);
            ToastService.ShowSuccess("پرداخت با موفقیت ثبت شد.");
            NavigationManager.NavigateTo("/accounting/supplier-payments");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ثبت پرداخت به تأمین‌کننده توسط {UserId}", userId);
            errorMessage = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
            ToastService.ShowError(errorMessage);
        }
        finally
        {
            isSaving = false;
        }
    }
}
