@page "/accounting/supplier-payments/add"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Dashboard.Domain.Identity.Permissions.TreasuryManage)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using System.Security.Claims
@inject ITreasuryService TreasuryService
@inject IStockService StockService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>ثبت پرداخت به تأمین‌کننده</PageTitle>

<h3>ثبت پرداخت به تأمین‌کننده</h3>

<div class="card-panel" style="max-width: 560px;">
    <EditForm Model="@model" OnValidSubmit="HandleValidSubmit" FormName="AddSupplierPaymentForm">
        <DataAnnotationsValidator />
        <ValidationSummary class="mb-3" />

        <div class="mb-3">
            <label class="form-label">تأمین‌کننده</label>
            <select class="form-select" @bind="model.SupplierId">
                <option value="0">-- انتخاب کنید --</option>
                @if (suppliers is not null)
                {
                    @foreach (var s in suppliers)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">پرداخت از صندوق/بانک</label>
            <select class="form-select" @bind="model.FinancialAccountId">
                <option value="0">-- انتخاب کنید --</option>
                @if (financialAccounts is not null)
                {
                    @foreach (var f in financialAccounts)
                    {
                        <option value="@f.Id">@f.Name</option>
                    }
                }
            </select>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">شماره سند</label>
                <InputText class="form-control" @bind-Value="model.PaymentNumber" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">مبلغ (تومان)</label>
                <InputNumber class="form-control" @bind-Value="model.Amount" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">روش پرداخت</label>
                <select class="form-select" @bind="model.Method">
                    <option value="Cash">نقدی</option>
                    <option value="CardTransfer">کارت به کارت</option>
                    <option value="Cheque">چک</option>
                    <option value="BankTransfer">حواله بانکی</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">تاریخ</label>
                <InputDate class="form-control" @bind-Value="model.PaymentDate" />
            </div>
        </div>

        @if (model.Method == "Cheque")
        {
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">شماره چک</label>
                    <InputText class="form-control" @bind-Value="model.ChequeNumber" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">تاریخ سررسید چک</label>
                    <InputDate class="form-control" @bind-Value="model.ChequeDueDate" />
                </div>
            </div>
        }

        <div class="mb-4">
            <label class="form-label">توضیحات (اختیاری)</label>
            <InputTextArea class="form-control" @bind-Value="model.Notes" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                @(isSaving ? "در حال ذخیره..." : "ثبت پرداخت")
            </button>
            <a href="/accounting/supplier-payments" class="btn btn-outline-secondary">انصراف</a>
        </div>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    private CreateSupplierPaymentDto model { get; set; } = new();

    private IEnumerable<SupplierDto>? suppliers;
    private IEnumerable<FinancialAccountDto>? financialAccounts;

    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        suppliers = await StockService.GetSuppliersAsync();
        financialAccounts = await TreasuryService.GetFinancialAccountsAsync();
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            if (model.SupplierId == 0)
            {
                errorMessage = "انتخاب تأمین‌کننده الزامی است.";
                return;
            }
            if (model.FinancialAccountId == 0)
            {
                errorMessage = "انتخاب صندوق/بانک الزامی است.";
                return;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? authState.User.Identity?.Name;

            await TreasuryService.RegisterSupplierPaymentAsync(model, userId);
            NavigationManager.NavigateTo("/accounting/supplier-payments");
        }
        catch (Exception ex)
        {
            errorMessage = $"ثبت ناموفق بود: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}