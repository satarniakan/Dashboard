@page "/admin/users/add"
@attribute [Authorize(Roles = Dashboard.Domain.Identity.Roles.Admin)]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services

@inject IUserAdminService UserAdminService
@inject NavigationManager NavigationManager

<PageTitle>افزودن کاربر جدید</PageTitle>

<h3>افزودن کاربر جدید</h3>

<div class="card-panel" style="max-width: 480px;">
    <EditForm Model="@(newUser!)" OnValidSubmit="HandleValidSubmit" FormName="AddUserForm">
        <DataAnnotationsValidator />
        <ValidationSummary class="mb-3" />

        <div class="mb-3">
            <label class="form-label">نام کامل</label>
            <InputText class="form-control" @bind-Value="newUser!.FullName" placeholder="نام و نام خانوادگی" />
        </div>

        <div class="mb-3">
            <label class="form-label">شماره موبایل</label>
            <InputText class="form-control" @bind-Value="newUser!.PhoneNumber" placeholder="مثال: 09123456789" />
        </div>

        <div class="mb-3">
            <label class="form-label">ایمیل</label>
            <InputText class="form-control" @bind-Value="newUser!.Email" placeholder="example@domain.com" />
        </div>

        <div class="mb-4">
            <label class="form-label">رمز عبور</label>
            <InputText type="password" class="form-control" @bind-Value="newUser!.Password" placeholder="حداقل ۶ کاراکتر" />
        </div>
        <div class="mb-4">
            <label class="form-label">نقش‌ها</label>
            @foreach (var role in roles)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="@("role_" + role.Name)"
                           checked="@newUser!.RoleNames.Contains(role.Name)"
                           @onchange="@(e => ToggleRole(role.Name, (bool)e.Value!))" />
                    <label class="form-check-label" for="@("role_" + role.Name)">@role.PersianName</label>
                </div>
            }
        </div>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                @(isSaving ? "در حال ذخیره..." : "ذخیره کاربر")
            </button>
            <a href="/admin/users" class="btn btn-outline-secondary">انصراف</a>
        </div>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    private CreateUserDto? newUser { get; set; }

    private bool isSaving;
    private string? errorMessage;
    private List<RoleDto> roles = new();
    protected override async Task OnInitializedAsync()
    {
        newUser ??= new();
        roles = await UserAdminService.GetAllRolesAsync();
    }

    private void ToggleRole(string roleName, bool isChecked)
    {
        if (isChecked && !newUser!.RoleNames.Contains(roleName))
        {
            newUser.RoleNames.Add(roleName);
        }
        else if (!isChecked)
        {
            newUser!.RoleNames.Remove(roleName);
        }
    }
    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            var result = await UserAdminService.CreateUserAsync(newUser!);
            if (result.Succeeded)
            {
                NavigationManager.NavigateTo("/admin/users?success=کاربر+با+موفقیت+ایجاد+شد");
            }
            else
            {
                errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"ذخیره کاربر ناموفق بود: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}