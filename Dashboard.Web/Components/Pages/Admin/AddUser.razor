@page "/admin/users/add"
@attribute [Authorize(Roles = Dashboard.Domain.Identity.Roles.Admin)]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@inject IUserAdminService UserAdminService
@inject NavigationManager NavigationManager
@inject ILogger<Dashboard.Web.Components.Pages.Admin.AddUser> Logger
@inject Dashboard.Web.Services.ToastService ToastService
<PageTitle>افزودن کاربر جدید</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-1">افزودن کاربر جدید</h3>
        <div class="text-body-secondary small">اطلاعات کاربر جدید را وارد کنید؛ فیلدهای ستاره‌دار الزامی هستند.</div>
    </div>
    <a href="/admin/users" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-right me-1"></i>بازگشت به فهرست
    </a>
</div>

<div style="max-width: 560px;">
    <EditForm Model="@(newUser!)" OnValidSubmit="HandleValidSubmit" FormName="AddUserForm">
        <DataAnnotationsValidator />

        @* ===== اطلاعات کاربر ===== *@
        <div class="card-panel mb-3">
            <h6 class="form-section-title"><i class="bi bi-person"></i>اطلاعات کاربر</h6>

            <AppTextField @bind-Value="newUser!.FullName" Label="نام کامل" Required="true"
                          Placeholder="نام و نام خانوادگی" />

            <div class="row">
                <div class="col-md-6">
                    <AppTextField @bind-Value="newUser!.PhoneNumber" Label="شماره موبایل" Required="true"
                                  Placeholder="مثال: 09123456789" Hint="برای ورود و بازیابی حساب کاربری استفاده می‌شود." />
                </div>
                <div class="col-md-6">
                    <AppTextField @bind-Value="newUser!.Email" Label="ایمیل (اختیاری)"
                                  Placeholder="example@domain.com" />
                </div>
            </div>

            @* فیلد رمز عبور هم از کامپوننت مشترک استفاده می‌کند (حالت password) *@
            <AppTextField @bind-Value="newUser!.Password" Label="رمز عبور" Required="true" InputType="password"
                          Placeholder="حداقل ۶ کاراکتر" Hint="رمز عبور باید حداقل ۶ کاراکتر باشد." />
        </div>

        @* ===== نقش‌ها ===== *@
        <div class="card-panel mb-3">
            <h6 class="form-section-title"><i class="bi bi-shield-lock"></i>نقش‌ها</h6>
            @foreach (var role in roles)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="@("role_" + role.Name)"
                           checked="@newUser!.RoleNames.Contains(role.Name)"
                           @onchange="@(e => ToggleRole(role.Name, (bool)e.Value!))" />
                    <label class="form-check-label" for="@("role_" + role.Name)">@role.PersianName</label>
                </div>
            }
            <ValidationMessage For="() => newUser!.RoleNames" class="text-danger small d-block" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mb-0">
                <i class="bi bi-exclamation-octagon me-1"></i>@errorMessage
            </div>
        }

        @* ===== نوار عملیات ===== *@
        <div class="card-panel form-actions mt-3 d-flex align-items-center gap-2">
            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-check-lg me-1"></i>
                }
                ذخیره کاربر
            </button>
            <a href="/admin/users" class="btn btn-outline-secondary">انصراف</a>
        </div>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    private CreateUserDto? newUser { get; set; }

    private bool isSaving;
    private string? errorMessage;
    private List<RoleDto> roles = new();
    protected override async Task OnInitializedAsync()
    {
        newUser ??= new();
        roles = await UserAdminService.GetAllRolesAsync();
    }

    private void ToggleRole(string roleName, bool isChecked)
    {
        if (isChecked && !newUser!.RoleNames.Contains(roleName))
        {
            newUser.RoleNames.Add(roleName);
        }
        else if (!isChecked)
        {
            newUser!.RoleNames.Remove(roleName);
        }
    }
    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            var result = await UserAdminService.CreateUserAsync(newUser!);
            if (result.Succeeded)
            {
                ToastService.ShowSuccess("کاربر جدید ایجاد شد.");
                NavigationManager.NavigateTo("/admin/users?success=کاربر+با+موفقیت+ایجاد+شد");
            }
            else
            {
                errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ذخیره کاربر جدید");
            errorMessage = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
            ToastService.ShowError(errorMessage);
        }
        finally
        {
            isSaving = false;
        }
    }
}
