@* Dashboard.Web/Components/Pages/Admin/EditUserRole.razor *@
@page "/admin/users/{UserId}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Dashboard.Domain.Identity.Roles.Admin)]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@inject IUserAdminService UserAdminService
@inject NavigationManager NavigationManager
@inject ILogger<Dashboard.Web.Components.Pages.Admin.EditUserRole> Logger
@inject Dashboard.Web.Services.ToastService ToastService
<PageTitle>تغییر نقش‌های کاربر</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-1">تغییر نقش‌های کاربر</h3>
        <div class="text-body-secondary small">نقش‌های دسترسی این کاربر را انتخاب کنید و تغییرات را ذخیره نمایید.</div>
    </div>
    <a href="/admin/users" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-right me-1"></i>بازگشت به فهرست
    </a>
</div>

@if (user is null)
{
    <p class="text-body-secondary">در حال بارگذاری...</p>
}
else
{
    <div style="max-width: 480px;">

        @* ===== اطلاعات کاربر ===== *@
        <div class="card-panel mb-3">
            <h6 class="form-section-title"><i class="bi bi-person"></i>اطلاعات کاربر</h6>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-body-secondary small">نام</span>
                <strong>@(user.FullName ?? "-")</strong>
            </div>
            <div class="d-flex justify-content-between mb-0">
                <span class="text-body-secondary small">شماره موبایل</span>
                <strong>@user.PhoneNumber</strong>
            </div>
        </div>

        @* ===== نقش‌ها ===== *@
        <div class="card-panel mb-3">
            <h6 class="form-section-title"><i class="bi bi-shield-lock"></i>نقش‌ها</h6>
            @foreach (var role in allRoles)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="@("edit_role_" + role.Name)"
                           checked="@selectedRoles.Contains(role.Name)"
                           @onchange="@(e => ToggleRole(role.Name, (bool)e.Value!))" />
                    <label class="form-check-label" for="@("edit_role_" + role.Name)">@role.PersianName</label>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mb-0">
                <i class="bi bi-exclamation-octagon me-1"></i>@errorMessage
            </div>
        }

        @* ===== نوار عملیات ===== *@
        <div class="card-panel form-actions mt-3 d-flex align-items-center gap-2">
            <button class="btn btn-primary" @onclick="SaveRoles" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-check-lg me-1"></i>
                }
                ذخیره تغییرات
            </button>
            <a href="/admin/users" class="btn btn-outline-secondary">انصراف</a>
        </div>
    </div>
}

@code {
    [Parameter] public string UserId { get; set; } = string.Empty;

    private UserListItemDto? user;
    private List<RoleDto> allRoles = new();
    private List<string> selectedRoles = new();
    private string? errorMessage;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        allRoles = await UserAdminService.GetAllRolesAsync();
        user = await UserAdminService.GetUserAsync(UserId);

        if (user is not null)
        {
            selectedRoles = new List<string>(user.Roles);
        }
    }

    private void ToggleRole(string roleName, bool isChecked)
    {
        if (isChecked && !selectedRoles.Contains(roleName))
        {
            selectedRoles.Add(roleName);
        }
        else if (!isChecked)
        {
            selectedRoles.Remove(roleName);
        }
    }

    private async Task SaveRoles()
    {
        isSaving = true;
        errorMessage = null;
        try
        {
            await UserAdminService.SetRolesAsync(UserId, selectedRoles);
            ToastService.ShowSuccess("نقش‌های کاربر به‌روزرسانی شد.");
            NavigationManager.NavigateTo("/admin/users?success=1");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در تغییر نقش‌های کاربر {UserId}", UserId);
            errorMessage = Dashboard.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
        }
        finally
        {
            isSaving = false;
        }
    }
}
