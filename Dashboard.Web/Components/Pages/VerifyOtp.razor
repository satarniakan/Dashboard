@page "/verify-otp"

<PageTitle>تأیید کد</PageTitle>

<div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card-panel" style="width: 100%; max-width: 420px;">
        <h3 class="text-center mb-2">تأیید شماره موبایل</h3>
        <p class="text-center text-muted mb-4" style="font-size: 0.9rem;">
            کد ۶ رقمی ارسال‌شده به شماره <strong>@Phone</strong> را وارد کنید.
        </p>

        @if (Error is not null)
        {
            <div class="alert alert-danger">کد وارد‌شده صحیح نیست یا منقضی شده است.</div>
        }

        <form method="post" action="/Account/VerifyOtp" data-enhance="false">
            <AntiforgeryToken />
            <input type="hidden" name="phoneNumber" value="@Phone" />

            <div class="mb-4">
                <label class="form-label">کد تأیید</label>
                <input type="text" name="code" class="form-control text-center" maxlength="6" pattern="[0-9]{6}" required style="letter-spacing: 0.3rem; font-size: 1.2rem;" />
            </div>

            <button type="submit" class="btn btn-primary w-100">تأیید و ورود</button>
        </form>

        <p class="text-center text-muted mt-3 mb-0" style="font-size: 0.9rem;">
            <a href="/register">تغییر شماره موبایل</a>
        </p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "phone")]
    private string? Phone { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }
}