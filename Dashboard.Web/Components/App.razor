@using Microsoft.AspNetCore.Components.Endpoints
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <script src="theme.js?v=20260926c"></script>

    <link rel="stylesheet" href="fonts/vazirmatn.css">

    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="lib/bootstrap-icons/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="app.css?v=20260926c" />
    <link rel="stylesheet" href="store.css?v=20260926b" />
    <link rel="stylesheet" href="Dashboard.Web.styles.css" />

    <link rel="stylesheet" href="lib/datepicker/datepicker.min.css">
    <script src="lib/datepicker/datepicker.min.js"></script>
    <script src="persian-datepicker-interop.js?v=20260926"></script>
    <script src="priceInput.js?v=20260926"></script>
    <script src="store-search.js?v=20260927" defer></script>
    <script src="reportExport.js?v=20260927"></script>
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#2563eb" />
    <HeadOutlet />
</head>
<body>
    <Routes @rendermode="RenderModeForPage" />
    <script src="_framework/blazor.web.js"></script>
    <script>
        // PWA: ثبت سرویس‌ورکر — صفحات SSR هرگز کش نمی‌شوند، فقط استاتیک‌ها و صفحه‌ی آفلاین
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(() => { });
            });
        }
    </script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // صفحاتی که [ExcludeFromInteractiveRouting] دارند (مثل Login و VerifyOtp) به HttpContext
    // نیاز دارند تا AntiforgeryToken و فرم‌های POST کار کنند. برای آن‌ها رندرمود را null
    // می‌گذاریم تا کاملاً استاتیک رندر شوند؛ بقیه صفحات تعاملی باقی می‌مانند.
    private IComponentRenderMode? RenderModeForPage =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}