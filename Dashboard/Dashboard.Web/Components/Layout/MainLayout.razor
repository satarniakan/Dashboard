@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="text-muted small">@context.User.Identity?.Name</span>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4 py-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    خطایی رخ داد.
    <a href="" class="reload">بارگذاری مجدد</a>
    <a class="dismiss">🗙</a>
</div>