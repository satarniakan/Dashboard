@* Dashboard.Web/Components/Pages/EditProduct.razor *@
@page "/products/edit/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Dashboard.Application.DTOs
@using Dashboard.Application.Services
@using System.Security.Claims
@inject IProductService ProductService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>ویرایش محصول</PageTitle>

<h3>ویرایش محصول</h3>

@if (notFound)
{
    <div class="alert alert-danger">محصول مورد نظر یافت نشد.</div>
}
else if (editModel is null)
{
    <p class="text-muted">در حال بارگذاری...</p>
}
else
{
    <div class="card-panel" style="max-width: 420px;">
        <EditForm Model="@editModel" OnValidSubmit="HandleValidSubmit" FormName="EditProductForm">
            <DataAnnotationsValidator />
            <ValidationSummary class="mb-3" />

            <div class="mb-3">
                <label class="form-label">نام محصول</label>
                <InputText class="form-control" @bind-Value="editModel.Name" />
            </div>

            <div class="mb-4">
                <label class="form-label">قیمت (تومان)</label>
                <InputNumber class="form-control" @bind-Value="editModel.Price" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                    @(isSaving ? "در حال ذخیره..." : "ذخیره تغییرات")
                </button>
                <a href="/products" class="btn btn-outline-secondary">انصراف</a>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private UpdateProductDto? editModel;
    private bool isSaving;
    private bool notFound;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var product = await ProductService.GetProductAsync(Id);

        if (product is null)
        {
            notFound = true;
            return;
        }

        editModel = new UpdateProductDto
        {
            Name = product.Name,
            Price = product.Price
        };
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userEmail = authState.User.FindFirstValue(ClaimTypes.Email)
                             ?? authState.User.Identity?.Name;

            var result = await ProductService.UpdateProductAsync(Id, editModel!, userEmail);

            if (result is null)
            {
                errorMessage = "محصول مورد نظر یافت نشد.";
            }
            else
            {
                NavigationManager.NavigateTo("/products");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"ذخیره تغییرات ناموفق بود: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}